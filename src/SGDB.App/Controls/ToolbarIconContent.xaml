<UserControl x:Class="SGDB.Controls.ToolbarIconContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Image x:Name="IconImage" Width="40" Height="40"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        <TextBlock x:Name="LabelText" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource SgdbBlueDarkBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
    </StackPanel>
</UserControl>
