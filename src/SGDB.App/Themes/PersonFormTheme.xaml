<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="CadastroWindowBg" Color="#ECE9E4"/>
    <SolidColorBrush x:Key="CadastroBodyBg" Color="White"/>
    <SolidColorBrush x:Key="CadastroBorder" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="CadastroParamsBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CadastroRed" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="CadastroFooterAccent" Color="#CC0000"/>
    <SolidColorBrush x:Key="CadastroTitleForeground" Color="White"/>

    <Style x:Key="CadastroWindowBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CadastroWindowBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CadastroBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style x:Key="CadastroTitleBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TitleBarGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SgdbGoldBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="CadastroTitleText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource CadastroTitleForeground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CadastroCloseButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Content" Value="×"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#26000000"/>
        <Setter Property="BorderBrush" Value="#A6D4A84B"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="CadastroTabButton" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Background" Value="#DDDDDD"/>
        <Setter Property="BorderBrush" Value="#1E3A5F"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="bd" Property="Background" Value="White"/>
                            <Setter TargetName="bd" Property="Margin" Value="0,0,0,-1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CadastroLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="CadastroHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="CadastroInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="CadastroReadOnly" TargetType="TextBox" BasedOn="{StaticResource CadastroInput}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="#F5F5F5"/>
    </Style>

    <Style x:Key="CadastroCombo" TargetType="ComboBox">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="CadastroIconButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Content" Value="🔍"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#EEEEEE"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="CadastroParamsBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CadastroParamsBg}"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="200"/>
    </Style>

    <Style x:Key="CadastroFooterBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CadastroWindowBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CadastroBorder}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="10,16"/>
        <Setter Property="MinHeight" Value="72"/>
    </Style>

    <Style x:Key="CadastroFooterButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            <Setter TargetName="bd" Property="CornerRadius" Value="4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
