<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="GestaoModalTitleGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFAFA" Offset="0"/>
        <GradientStop Color="#ECECEC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GestaoBtnGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5F5F5" Offset="0"/>
        <GradientStop Color="#DDDDDD" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GestaoBtnPrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E84560" Offset="0"/>
        <GradientStop Color="#C41E3A" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="GestaoModalShell" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#C8C4BC"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.28" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GestaoModalTitleBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GestaoModalTitleGradient}"/>
        <Setter Property="BorderBrush" Value="#C8C4BC"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="GestaoModalTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>

    <Style x:Key="GestaoModalBody" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="GestaoModalHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#555555"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="GestaoModalHintSmall" TargetType="TextBlock" BasedOn="{StaticResource GestaoModalHint}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#444444"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="GestaoCompraF" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="GestaoFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="GestaoFieldInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="GestaoMoedaPrefix" TargetType="Border">
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="BorderBrush" Value="#9CA3AF"/>
        <Setter Property="BorderThickness" Value="1,1,0,1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinWidth" Value="36"/>
    </Style>

    <Style x:Key="GestaoMoedaPrefixText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GestaoMoedaInput" TargetType="TextBox" BasedOn="{StaticResource GestaoFieldInput}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style x:Key="GestaoModalBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource GestaoBtnGradient}"/>
        <Setter Property="BorderBrush" Value="#999999"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E8E8E8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GestaoModalBtnPrimary" TargetType="Button" BasedOn="{StaticResource GestaoModalBtn}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource GestaoBtnPrimaryGradient}"/>
        <Setter Property="BorderBrush" Value="#9B1B30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#9B1B30"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GestaoModalLancBtn" TargetType="Button" BasedOn="{StaticResource GestaoModalBtn}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="GestaoModalActions" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

</ResourceDictionary>
