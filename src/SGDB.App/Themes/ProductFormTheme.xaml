<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WpdvAccentBrush" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="WpdvFieldBgBrush" Color="White"/>

    <Style x:Key="WpdvWindowBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SgdbBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WpdvAccentBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style x:Key="WpdvTitleBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TitleBarGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SgdbGoldBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="WpdvTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="WpdvCloseButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Content" Value="×"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#26000000"/>
        <Setter Property="BorderBrush" Value="#A6D4A84B"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="WpdvTabBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MenuBarGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SgdbGoldBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,4,8,0"/>
    </Style>

    <Style x:Key="WpdvTabButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Background" Value="#DDDDDD"/>
        <Setter Property="BorderBrush" Value="{StaticResource WpdvAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="bd" Property="Background" Value="White"/>
                            <Setter TargetName="bd" Property="Margin" Value="0,0,0,-1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WpdvBody" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="8,6,4,6"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="WpdvLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="WpdvInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="WpdvCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="WpdvReadOnly" TargetType="TextBox" BasedOn="{StaticResource WpdvInput}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="#F5F5F5"/>
    </Style>

    <Style x:Key="WpdvPlusButton" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Content" Value="+"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#EEEEEE"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="WpdvGearButton" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Content" Value="⚙"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#EEEEEE"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="WpdvFooterBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SgdbBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WpdvAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="WpdvFooterButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            <Setter TargetName="bd" Property="CornerRadius" Value="4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WpdvFooterSave" TargetType="Button" BasedOn="{StaticResource WpdvFooterButton}"/>

    <Style x:Key="WpdvParamsBox" TargetType="Border">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Width" Value="128"/>
    </Style>

</ResourceDictionary>
