<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="CompraBodyBg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="CompraValBlueBrush" Color="#003399"/>
    <SolidColorBrush x:Key="CompraFooterBg" Color="#D4D0C8"/>

    <Style x:Key="CompraTopLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="CompraField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="CompraFieldReadOnly" TargetType="TextBox" BasedOn="{StaticResource CompraField}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="#FAFAFA"/>
    </Style>

    <Style x:Key="CompraValBlue" TargetType="TextBox" BasedOn="{StaticResource CompraFieldReadOnly}">
        <Setter Property="Foreground" Value="{StaticResource CompraValBlueBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- Células editáveis na grade (margem / preço venda) -->
    <Style x:Key="CompraGridEditCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="#FFFDE7"/>
    </Style>
    <Style x:Key="CompraGridEditBox" TargetType="TextBox">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#C9A227"/>
    </Style>

    <Style x:Key="CompraCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#999999"/>
    </Style>

    <Style x:Key="CompraItensTab" TargetType="Border">
        <Setter Property="Background" Value="#E8E8E8"/>
        <Setter Property="BorderBrush" Value="#999999"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <Style x:Key="CompraTbButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#F5F5F5"/>
        <Setter Property="BorderBrush" Value="#888888"/>
    </Style>

    <Style x:Key="CompraNavButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#888888"/>
        <Setter Property="IsEnabled" Value="False"/>
    </Style>

    <Style x:Key="CompraParamsBox" TargetType="Border">
        <Setter Property="Background" Value="#FAFAFA"/>
        <Setter Property="BorderBrush" Value="#999999"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style x:Key="CompraSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Padding" Value="0,0,0,3"/>
    </Style>

    <Style x:Key="CompraFooterBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CompraFooterBg}"/>
        <Setter Property="BorderBrush" Value="#1E3A5F"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

</ResourceDictionary>
