<UserControl x:Class="SGDB.Views.PayablesModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SGDB.Controls"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="PayablesModuleView_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="PagarCellLeft" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="PagarCellRight" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,10,0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="PagarHeaderLeft" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="PagarHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PagarHeaderLeft}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="8,8,10,8"/>
        </Style>
        <Style x:Key="PagarHeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PagarHeaderLeft}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PagarDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="PagarRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Situacao}" Value="pago">
                    <Setter Property="Background" Value="#F0FDF4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Situacao}" Value="vencido">
                    <Setter Property="Background" Value="#FEF2F2"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PagarCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SituacaoBadgeTemplate">
            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" Margin="4,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FEF3C7"/>
                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Situacao}" Value="pago">
                                <Setter Property="Background" Value="#DCFCE7"/>
                                <Setter Property="BorderBrush" Value="#22C55E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Situacao}" Value="vencido">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Situacao}" Value="pendente">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding SituacaoDisplay}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1D4ED8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Situacao}" Value="pago">
                                    <Setter Property="Foreground" Value="#15803D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Situacao}" Value="vencido">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Situacao}" Value="pendente">
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="#B8C4D4" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Padding="16,10" Background="{StaticResource TitleBarGradientBrush}"
                    BorderBrush="{StaticResource SgdbGoldBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Contas - Pagar" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    <Button x:Name="CloseTabButton" Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="CloseTabButton_Click"/>
                </Grid>
            </Border>

            <!-- Filters -->
            <Border Grid.Row="1" Padding="16,14" Background="#FAF8F4"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="F12 | Filtro — Selecione Fornecedor e Período"
                               FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fornecedor" VerticalAlignment="Center"
                                   Margin="0,0,10,0" FontSize="12" Foreground="#475569"/>
                        <ComboBox x:Name="SupplierBox" Grid.Column="1" Height="32" FontSize="12"
                                  Padding="6,2" DisplayMemberPath="Name" IsEditable="False"/>
                        <TextBlock x:Name="PeriodLabel" Grid.Column="2" Text="Período | Vencimento"
                                   VerticalAlignment="Center" Margin="20,0,10,0" FontSize="12" Foreground="#475569"/>
                        <controls:BrDateBox x:Name="DateFromBox" Grid.Column="3" Width="130"/>
                        <TextBlock Grid.Column="4" Text="até" VerticalAlignment="Center"
                                   Margin="10,0" FontSize="12" Foreground="#64748B"/>
                        <controls:BrDateBox x:Name="DateToBox" Grid.Column="5" Width="130"/>
                        <Button Grid.Column="6" Content="Filtrar" Margin="16,0,0,0"
                                Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Refresh_Click"/>
                        <Button Grid.Column="7" Content="Limpar" Margin="8,0,0,0"
                                Style="{StaticResource SgdbOutlineButtonStyle}" Click="ClearFilter_Click"/>
                    </Grid>
                    <Border x:Name="BannerBorder" Margin="0,12,0,0" Padding="12,8" Background="#FFF8DC"
                            BorderBrush="#E8D48B" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                        <TextBlock x:Name="BannerText" FontSize="12" Foreground="#5C4A1A" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Status / view tabs -->
            <Border Grid.Row="2" Padding="16,12" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton x:Name="SitPendentes" Content="Pendentes" GroupName="sit" Margin="0,0,16,0"
                                     IsChecked="True" Checked="Filter_Changed"/>
                        <RadioButton x:Name="SitPagas" Content="Pagas" GroupName="sit" Margin="0,0,16,0"
                                     Checked="Filter_Changed"/>
                        <RadioButton x:Name="SitTodas" Content="Todas" GroupName="sit"
                                     Checked="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="ViewTitulos" Content="Títulos" GroupName="view" Margin="0,0,16,0"
                                     Checked="View_Changed"/>
                        <RadioButton x:Name="ViewParcelas" Content="Desdobramentos de Parcelas" GroupName="view"
                                     IsChecked="True" Checked="View_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tables -->
            <Border Grid.Row="3" Margin="16,12,16,0" BorderBrush="#E2E8F0" BorderThickness="1"
                    Background="White" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="TitlesGrid" Style="{StaticResource PagarDataGridStyle}"
                              Visibility="Collapsed" RowStyle="{StaticResource PagarRowStyle}"
                              CellStyle="{StaticResource PagarCellStyle}"
                              MouseDoubleClick="Grid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E8F0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E8F0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="88"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Fornecedor" Binding="{Binding SupplierName}" Width="*"
                                                MinWidth="160"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Emissão" Binding="{Binding EmissionDateDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Doc" Binding="{Binding DocRefDisplay}" Width="120"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding TotalDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                            <DataGridTextColumn Header="Desconto" Binding="{Binding DiscountDisplay}" Width="90"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                            <DataGridTextColumn Header="Juros" Binding="{Binding InterestDisplay}" Width="80"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                            <DataGridTextColumn Header="Vl. Pago" Binding="{Binding PaidAmountDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                            <DataGridTextColumn Header="Pago Em" Binding="{Binding PaidDateDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTemplateColumn Header="Situação" Width="110"
                                                    HeaderStyle="{StaticResource PagarHeaderCenter}"
                                                    CellTemplate="{StaticResource SituacaoBadgeTemplate}"/>
                            <DataGridTextColumn Header="Parc." Binding="{Binding InstallmentCount}" Width="56"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="InstallmentsGrid" Style="{StaticResource PagarDataGridStyle}"
                              RowStyle="{StaticResource PagarRowStyle}"
                              CellStyle="{StaticResource PagarCellStyle}"
                              MouseDoubleClick="Grid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E8F0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E8F0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nº" Binding="{Binding DisplayNumber}" Width="96"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Fornecedor" Binding="{Binding SupplierName}" Width="*"
                                                MinWidth="150"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Vencimento" Binding="{Binding DueDateDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Emissão" Binding="{Binding EmissionDateDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Doc" Binding="{Binding DocRefDisplay}" Width="110"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding AmountDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                            <DataGridTextColumn Header="Desconto" Binding="{Binding DiscountDisplay}" Width="90"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                            <DataGridTextColumn Header="Juros" Binding="{Binding InterestDisplay}" Width="80"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                            <DataGridTextColumn Header="Vl. Pago" Binding="{Binding PaidAmountDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellRight}"
                                                HeaderStyle="{StaticResource PagarHeaderRight}"/>
                            <DataGridTextColumn Header="Pago Em" Binding="{Binding PaidDateDisplay}" Width="100"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding PaymentType}" Width="96"
                                                ElementStyle="{StaticResource PagarCellLeft}"
                                                HeaderStyle="{StaticResource PagarHeaderLeft}"/>
                            <DataGridTemplateColumn Header="Situação" Width="110"
                                                    HeaderStyle="{StaticResource PagarHeaderCenter}"
                                                    CellTemplate="{StaticResource SituacaoBadgeTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Totals -->
            <Border Grid.Row="4" Margin="16,12,16,0" Background="#FAFAFA" BorderBrush="#E2E8F0"
                    BorderThickness="1" CornerRadius="4" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TOTAL:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TotalBarText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                               Foreground="#0000CC" Margin="0,0,28,0"/>
                    <TextBlock Text="Registros:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CountBarText" FontSize="12" VerticalAlignment="Center" Margin="0,0,28,0"/>
                    <TextBlock Text="TOTAL PAGO:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="PaidBarText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                               Foreground="#0000CC"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Border Grid.Row="5" Margin="0,12,0,0" Background="#F5F3EE" BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0" Padding="12,10">
                <WrapPanel>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="Novo_Click">
                        <StackPanel>
                            <TextBlock Text="📄+" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F2 | Novo" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="Baixar_Click">
                        <StackPanel>
                            <TextBlock Text="✓" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F7 | Baixar / Pagar" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="Alterar_Click">
                        <StackPanel>
                            <TextBlock Text="✎" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F3 | Alterar parcela" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="Print_Click">
                        <StackPanel>
                            <TextBlock Text="🖨" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F4 | Imprimir" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="Refresh_Click">
                        <StackPanel>
                            <TextBlock Text="↻" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F5 | Atualizar" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="Delete_Click">
                        <StackPanel>
                            <TextBlock Text="✕" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F8 | Excluir" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
