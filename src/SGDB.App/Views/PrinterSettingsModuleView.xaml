<UserControl x:Class="SGDB.Views.PrinterSettingsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SGDB.Views"
             Background="#ECE9E4" Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="10,6" Background="#F0F0F0" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Impressoras &amp; Personalização de Comprovante" FontWeight="SemiBold" FontSize="13"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <!-- Configurações -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CONFIGURAÇÕES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#64748B" Margin="0,0,0,12"/>

                        <TextBlock Text="Impressora" Margin="0,0,0,4" FontSize="12"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <ComboBox x:Name="PrinterBox" Height="34" IsEditable="True"
                                          SelectionChanged="PrinterBox_Changed"
                                          LostFocus="PrinterBox_LostFocus"/>
                                <TextBlock x:Name="PrinterPlaceholder"
                                           Text="Selecione uma impressora detectada..."
                                           IsHitTestVisible="False"
                                           Foreground="#94A3B8" FontSize="12"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <Button Grid.Column="1" Content="🔄" Width="36" Height="34" Margin="6,0,0,0"
                                    Style="{StaticResource SgdbOutlineButtonStyle}" Padding="0"
                                    ToolTip="Atualizar lista de impressoras" Click="RefreshPrinters_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Nenhuma impressora selecionada"
                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Largura do papel" Margin="0,0,0,6" FontSize="12"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Width80" Content="80 mm (Padrão)" GroupName="paperW"
                                                 IsChecked="True" Margin="0,0,16,0" FontSize="12"
                                                 Checked="Preview_Changed"/>
                                    <RadioButton x:Name="Width58" Content="58 mm (Pequena)" GroupName="paperW"
                                                 FontSize="12" Checked="Preview_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cópias" Margin="0,0,0,6" FontSize="12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="32" Height="30" Click="CopiesMinus_Click"
                                            Style="{StaticResource SgdbOutlineButtonStyle}" Padding="0"/>
                                    <TextBlock x:Name="CopiesText" Text="1" Width="36" TextAlignment="Center"
                                               VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                    <Button Content="+" Width="32" Height="30" Click="CopiesPlus_Click"
                                            Style="{StaticResource SgdbOutlineButtonStyle}" Padding="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="AutoCutBox" Content="Cortar papel automaticamente (guilhotina)"
                                  Margin="0,0,0,8" FontSize="12" Checked="Preview_Changed" Unchecked="Preview_Changed"/>
                        <CheckBox x:Name="AutoPrintPreContaBox"
                                  Content="Imprimir pré-conta automaticamente quando o celular solicitar fechamento"
                                  Margin="0,0,0,14" FontSize="12"
                                  ToolTip="Mesa fica amarela no mapa e o cupom sai na impressora do caixa sem clicar em F9"/>

                        <TextBlock Text="Rodapé do comprovante" Margin="0,0,0,4" FontSize="12"/>
                        <TextBox x:Name="FooterBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Padding="8" FontSize="12"
                                 TextChanged="FooterBox_TextChanged"/>
                        <TextBlock x:Name="FooterHint" Margin="0,6,0,0" FontSize="11" Foreground="#94A3B8"
                                   Text="Limite recomendado: 42 caracteres por linha"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pré-visualização -->
                <Border Grid.Column="2" Background="#EEF2F7" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Padding="10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PRÉ-VISUALIZAÇÃO DO CUPOM"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="PreviewWidthLabel" Text="Bobina 80 mm"
                                           FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource SgdbOutlineButtonStyle}"
                                    Padding="8,4" FontSize="11"
                                    ToolTip="Ver cupom em escala real (1:1)"
                                    Click="ExpandPreview_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Expandir" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch">
                            <local:ReceiptPreviewControl x:Name="SidePreview" Compact="True"
                                                         HorizontalAlignment="Stretch"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="12,10" Background="#F5F3EE" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Button Content="Imprimir Teste" Style="{StaticResource SgdbOutlineButtonStyle}"
                            Padding="14,8" HorizontalAlignment="Left" Click="PrintTest_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource SgdbOutlineButtonStyle}"
                                Padding="14,8" Margin="0,0,8,0" Click="Close_Click"/>
                        <Button Content="Salvar (F9)" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                Padding="16,8" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
