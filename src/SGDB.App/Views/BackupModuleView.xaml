<UserControl x:Class="SGDB.Views.BackupModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECE9E4" Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="10,6" Background="#F0F0F0" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Backup &amp; Restauração" FontWeight="SemiBold" FontSize="13"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="16,14" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                    <TextBlock Text="Proteja o cadastro de clientes, fiados e estoque do depósito."
                               FontSize="12" Foreground="#64748B" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- CARD 1: Manual -->
                    <Border Background="#ECFDF5" BorderBrush="#86EFAC" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💾 Backup Manual" FontWeight="SemiBold" FontSize="13" Foreground="#14532D"/>
                            <TextBlock x:Name="DbPathText" FontSize="11" Foreground="#64748B" Margin="0,8,0,10" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Criar cópia de segurança agora" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                        Padding="14,8" Margin="0,0,8,0" Click="Backup_Click"/>
                                <Button Content="Restaurar dados a partir de arquivo…" Style="{StaticResource SgdbOutlineButtonStyle}"
                                        Padding="14,8" Click="Restore_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Automático -->
                    <Border Background="#FAFBFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="⏱️ Backup Automático &amp; Agendamento" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                <CheckBox x:Name="AutoEnabledBox" Content="Ativado" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" FontSize="12" Foreground="#334155"/>
                            </Grid>

                            <TextBlock Text="Horários de agendamento no dia:" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="ScheduleTimesPanel" Margin="0,0,0,8"/>
                            <Button Content="+ Adicionar horário" Style="{StaticResource SgdbOutlineButtonStyle}"
                                    Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,12"
                                    Click="AddScheduleTime_Click"/>

                            <CheckBox x:Name="BackupOnCashCloseBox"
                                      Content="Fazer backup automático ao fechar o caixa"
                                      FontSize="12" Margin="0,0,0,6"/>
                            <CheckBox x:Name="BackupOnAppCloseBox"
                                      Content="Fazer backup automático ao encerrar o sistema"
                                      FontSize="12" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="RetentionEnabledBox" Content="Manter histórico dos últimos"
                                          FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox x:Name="RetentionDaysBox" Width="72" Height="32" Margin="8,0,8,0"
                                          FontSize="13" VerticalContentAlignment="Center"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          ToolTip="Quantidade de dias para guardar os backups (ex: 30)">
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="15"/>
                                    <ComboBoxItem Content="30"/>
                                    <ComboBoxItem Content="60"/>
                                    <ComboBoxItem Content="90"/>
                                    <ComboBoxItem Content="180"/>
                                    <ComboBoxItem Content="365"/>
                                </ComboBox>
                                <TextBlock Text="dias (apaga backups mais antigos para não lotar o disco)"
                                           FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="AutoFolderHint" FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: Nuvem -->
                    <Border Background="#FAFBFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="☁️ Backup na Nuvem" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                <CheckBox x:Name="CloudEnabledBox" Content="Ativado" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" FontSize="12" Foreground="#334155"/>
                            </Grid>

                            <TextBlock Text="Destino na nuvem:" FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>

                            <RadioButton x:Name="CloudSyncFolderRadio" GroupName="CloudMode" IsChecked="True"
                                         Content="Usar pasta sincronizada (Google Drive / OneDrive / Dropbox)"
                                         FontSize="12" Margin="0,0,0,8"/>

                            <Grid Margin="20,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CloudFolderBox" Style="{StaticResource ModernInput}" Height="32"
                                         VerticalContentAlignment="Center" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="📁 Selecionar pasta" Style="{StaticResource SgdbOutlineButtonStyle}"
                                        Padding="10,6" Margin="8,0,0,0" Click="PickCloudFolder_Click"/>
                            </Grid>

                            <RadioButton x:Name="CloudGoogleApiRadio" GroupName="CloudMode"
                                         Content="Conectar diretamente via Conta Google (em breve)"
                                         FontSize="12" Foreground="#94A3B8" IsEnabled="False" Margin="0,0,0,4"/>
                            <TextBlock Text="A opção via API exigirá login OAuth. Por enquanto, use a pasta local sincronizada pelo app do Google Drive."
                                       FontSize="11" Foreground="#94A3B8" Margin="20,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Status -->
            <Border Grid.Row="2" Padding="14,10" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="#166534" TextWrapping="Wrap" LineHeight="18"/>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="3" Padding="14,10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="As configurações são salvas no banco e aplicadas imediatamente."
                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <Button Content="Salvar alterações" Style="{StaticResource SgdbPrimaryButtonStyle}"
                            Padding="16,8" HorizontalAlignment="Right" Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
