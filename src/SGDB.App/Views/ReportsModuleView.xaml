<UserControl x:Class="SGDB.Views.ReportsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SGDB.Controls"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="ReportsModuleView_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="RelSubBtn" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#254A75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RelCatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>
        <Style x:Key="RelCellL" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="RelCellR" TargetType="TextBlock" BasedOn="{StaticResource RelCellL}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,0,12,0"/>
        </Style>
        <Style x:Key="RelHdrL" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="RelHdrR" TargetType="DataGridColumnHeader" BasedOn="{StaticResource RelHdrL}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="RelDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SgdbGridLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource SgdbGridLineBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
        <DataTemplate x:Key="VendaStatusBadgeTemplate">
            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" Margin="4,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7"/>
                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKey}" Value="cancelled">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Setter Property="BorderBrush" Value="#FECACA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#166534"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKey}" Value="cancelled">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CaixaStatusBadgeTemplate">
            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" Margin="4,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7"/>
                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKey}" Value="closed">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#166534"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKey}" Value="closed">
                                    <Setter Property="Foreground" Value="#475569"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CaixaDifferenceTemplate">
            <TextBlock Text="{Binding DifferenceDisplay}" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Right" Margin="6,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DifferenceTone}" Value="zero">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifferenceTone}" Value="positive">
                                <Setter Property="Foreground" Value="#15803D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifferenceTone}" Value="negative">
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DifferenceTone}" Value="none">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="CaixaAcoesTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0">
                <Button Content="Ver" ToolTip="Ver Detalhes" Tag="{Binding Id}"
                        Padding="8,2" Margin="0,0,4,0" FontSize="11" Cursor="Hand"
                        Click="CxDetalhes_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Foreground" Value="#1D4ED8"/>
                            <Setter Property="BorderBrush" Value="#BFDBFE"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Imprimir" ToolTip="Imprimir Resumo" Tag="{Binding Id}"
                        Padding="8,2" FontSize="11" Cursor="Hand"
                        Click="CxImprimir_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AbcClassBadgeTemplate">
            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" Margin="4,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FEE2E2"/>
                        <Setter Property="BorderBrush" Value="#FECACA"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Classe}" Value="A">
                                <Setter Property="Background" Value="#DCFCE7"/>
                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Classe}" Value="B">
                                <Setter Property="Background" Value="#FEF3C7"/>
                                <Setter Property="BorderBrush" Value="#FCD34D"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Classe}" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#B91C1C"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Classe}" Value="A">
                                    <Setter Property="Foreground" Value="#166534"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Classe}" Value="B">
                                    <Setter Property="Foreground" Value="#92400E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PrevisaoStatusBadgeTemplate">
            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" Margin="4,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7"/>
                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKey}" Value="overdue">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Setter Property="BorderBrush" Value="#FECACA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#166534"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKey}" Value="overdue">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="#B8C4D4" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,10" Background="{StaticResource TitleBarGradientBrush}"
                    BorderBrush="{StaticResource SgdbGoldBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="Relatório"
                               Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    <Button x:Name="CloseTabButton" Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="CloseTabButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="10,8" Background="#FAF8F4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" ItemHeight="82">
                    <!-- Vendas -->
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Vendas" Style="{StaticResource RelCatLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnMaisVendidos" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏆" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Mais Vendidos" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                                               TextAlignment="Center" MaxWidth="90"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnVendasPdv" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🕐" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Vendas PDV" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnFiado" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📒" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Contas Fiado" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Width="1" Background="#E2E8F0" Margin="0,4,12,4" Height="70"
                            VerticalAlignment="Center"/>

                    <!-- Estoque -->
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Estoque" Style="{StaticResource RelCatLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnEstoqueMinimo" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Est. Mínimo" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCurvaAbc" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Giro ABC" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Width="1" Background="#E2E8F0" Margin="0,4,12,4" Height="70"
                            VerticalAlignment="Center"/>

                    <!-- Financeiro -->
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Financeiro" Style="{StaticResource RelCatLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnPrevisaoFiado" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Previsão" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnFechamento" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Fechamento" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDre" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💹" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DRE" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEstoqueIo" Style="{StaticResource RelSubBtn}" Click="Nav_Click"
                                    Width="108">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Entradas/Saídas" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCaixaHistorico" Style="{StaticResource RelSubBtn}" Click="Nav_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🧾" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Hist. Caixa" FontSize="9.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Grid Grid.Row="2">
                <!-- MENU -->
                <StackPanel x:Name="PanelMenu" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="Escolha um relatório acima" FontSize="18" FontWeight="SemiBold"
                               Foreground="#334155" HorizontalAlignment="Center"/>
                    <TextBlock Text="Vendas, estoque (mínimo e curva ABC), previsão de fiados, fechamento, DRE, entradas/saídas e histórico de caixa."
                               FontSize="13" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="520" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- DRE host (embedded) -->
                <ContentControl x:Name="DreHost" Visibility="Collapsed"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>

                <!-- Entradas/Saídas host -->
                <ContentControl x:Name="EstoqueIoHost" Visibility="Collapsed"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>

                <!-- MAIS VENDIDOS -->
                <Grid x:Name="PanelMaisVendidos" Visibility="Collapsed" Margin="16"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"
                            Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Filtrar período" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14"/>
                            <TextBlock Text="De" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <controls:BrDateBox x:Name="MvDateFrom" Margin="0,0,0,12"/>
                            <TextBlock Text="até" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <controls:BrDateBox x:Name="MvDateTo" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Hoje" Style="{StaticResource SgdbOutlineButtonStyle}" Click="MvHoje_Click"/>
                                <Button Content="Pesquisar" Style="{StaticResource SgdbPrimaryButtonStyle}" Click="MvPesquisar_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Mais Vendidos" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <DataGrid x:Name="MvGrid" Grid.Row="1" Style="{StaticResource RelDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Posicao}" Width="48"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Grupo" Binding="{Binding GroupDisplay}" Width="140"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Qtd." Binding="{Binding QtyDisplay}" Width="90"
                                                    ElementStyle="{StaticResource RelCellR}"
                                                    HeaderStyle="{StaticResource RelHdrR}"/>
                                <DataGridTextColumn Header="Valor total" Binding="{Binding TotalDisplay}" Width="110"
                                                    ElementStyle="{StaticResource RelCellR}"
                                                    HeaderStyle="{StaticResource RelHdrR}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="MvMeta" Grid.Row="2" Margin="0,8,0,0" FontSize="12" Foreground="#475569"/>
                    </Grid>
                </Grid>

                <!-- VENDAS PDV -->
                <DockPanel x:Name="PanelVendasPdv" Visibility="Collapsed" Margin="16" LastChildFill="True"
                           VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Histórico de vendas (PDV)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="De" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#64748B"/>
                                <controls:BrDateBox x:Name="VpDateFrom" Width="130" Margin="0,0,10,0"/>
                                <TextBlock Text="até" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#64748B"/>
                                <controls:BrDateBox x:Name="VpDateTo" Width="130" Margin="0,0,12,0"/>
                                <Button Content="Hoje" Style="{StaticResource SgdbOutlineButtonStyle}" Click="VpHoje_Click"/>
                                <Button Content="Ontem" Style="{StaticResource SgdbOutlineButtonStyle}" Click="VpOntem_Click"/>
                                <Button Content="Pesquisar" Style="{StaticResource SgdbPrimaryButtonStyle}" Click="VpPesquisar_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="VpCashHint" Margin="0,10,0,0" FontSize="11" Foreground="#64748B"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC"
                            Padding="10" Height="150" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="VpDetailTitle" Text="Selecione uma venda" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="VpDetailInfo" FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="VpItemsGrid" Grid.Column="1" Style="{StaticResource RelDataGrid}"
                                      BorderThickness="0" Background="Transparent" AlternatingRowBackground="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*"
                                                        HeaderStyle="{StaticResource RelHdrL}"
                                                        ElementStyle="{StaticResource RelCellL}"/>
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityDisplay}" Width="60"
                                                        HeaderStyle="{StaticResource RelHdrR}"
                                                        ElementStyle="{StaticResource RelCellR}"/>
                                    <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalDisplay}" Width="80"
                                                        HeaderStyle="{StaticResource RelHdrR}"
                                                        ElementStyle="{StaticResource RelCellR}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="VpMeta" DockPanel.Dock="Bottom" Margin="0,0,0,4"
                               FontSize="12" Foreground="#475569"/>

                    <DataGrid x:Name="VpGrid" Style="{StaticResource RelDataGrid}" MinHeight="180"
                              VerticalAlignment="Stretch"
                              SelectionChanged="VpGrid_SelectionChanged"
                              MouseDoubleClick="VpGrid_MouseDoubleClick"
                              LoadingRow="VpGrid_LoadingRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="56"
                                                ElementStyle="{StaticResource RelCellL}"
                                                HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Dia caixa" Binding="{Binding SessionDateBr}" Width="100"
                                                ElementStyle="{StaticResource RelCellL}"
                                                HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Hora" Binding="{Binding TimeDisplay}" Width="70"
                                                ElementStyle="{StaticResource RelCellL}"
                                                HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerDisplay}" Width="*"
                                                ElementStyle="{StaticResource RelCellL}"
                                                HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Forma / pagamento" Binding="{Binding PaymentLabel}" Width="180"
                                                ElementStyle="{StaticResource RelCellL}"
                                                HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="90"
                                                ElementStyle="{StaticResource RelCellR}"
                                                HeaderStyle="{StaticResource RelHdrR}"/>
                            <DataGridTextColumn Header="Itens" Binding="{Binding ItemsCount}" Width="60"
                                                ElementStyle="{StaticResource RelCellR}"
                                                HeaderStyle="{StaticResource RelHdrR}"/>
                            <DataGridTemplateColumn Header="Status" Width="88"
                                                    HeaderStyle="{StaticResource RelHdrL}"
                                                    CellTemplate="{StaticResource VendaStatusBadgeTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- FIADO HOST: preenche a área do relatório -->
                <Grid x:Name="PanelFiado" Visibility="Collapsed"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <ContentControl x:Name="FiadoHost"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                </Grid>

                <!-- ESTOQUE MÍNIMO -->
                <DockPanel x:Name="PanelEstoqueMinimo" Visibility="Collapsed" Margin="16" LastChildFill="True"
                           VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Border DockPanel.Dock="Top" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Alerta de Reposição — estoque ≤ mínimo" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Produtos ativos abaixo ou no estoque mínimo. Use a sugestão de compra para montar o pedido ao fornecedor."
                                       FontSize="12" Foreground="#9A3412" Margin="0,6,0,10" TextWrapping="Wrap"/>
                            <Button Content="Atualizar" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0" Click="EmAtualizar_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="EmMeta" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                               FontSize="12" Foreground="#475569"/>
                    <DataGrid x:Name="EmGrid" Style="{StaticResource RelDataGrid}" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"
                                                ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"
                                                ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Estoque Atual" Binding="{Binding StockDisplay}" Width="120"
                                                ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                            <DataGridTextColumn Header="Estoque Mínimo" Binding="{Binding MinStockDisplay}" Width="120"
                                                ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                            <DataGridTextColumn Header="Sugestão de Compra" Binding="{Binding SugestaoDisplay}" Width="140"
                                                ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- CURVA ABC -->
                <Grid x:Name="PanelCurvaAbc" Visibility="Collapsed" Margin="16"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"
                            Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Giro de Estoque (ABC)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="A = até 80% do faturamento · B = 80–95% · C = restante (menor giro)."
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <TextBlock Text="De" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <controls:BrDateBox x:Name="AbcDateFrom" Margin="0,0,0,12"/>
                            <TextBlock Text="até" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <controls:BrDateBox x:Name="AbcDateTo" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="30 dias" Style="{StaticResource SgdbOutlineButtonStyle}" Click="Abc30_Click"/>
                                <Button Content="Pesquisar" Style="{StaticResource SgdbPrimaryButtonStyle}" Click="AbcPesquisar_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Curva ABC por valor de vendas" FontWeight="SemiBold" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="AbcMeta" DockPanel.Dock="Right"
                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center"
                                       TextAlignment="Right"/>
                        </DockPanel>
                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                            <Border Margin="0,0,8,0" CornerRadius="10" Padding="14,12"
                                    Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#16A34A"
                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Classe A" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#166534" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="AbcCountAText" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="#14532D" Margin="0,8,0,2"/>
                                    <TextBlock Text="até 80% do faturamento" FontSize="11" Foreground="#15803D"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" CornerRadius="10" Padding="14,12"
                                    Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#D97706"
                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Classe B" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#92400E" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="AbcCountBText" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="#78350F" Margin="0,8,0,2"/>
                                    <TextBlock Text="80% a 95% do faturamento" FontSize="11" Foreground="#B45309"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Padding="14,12"
                                    Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#64748B"
                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Classe C" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#475569" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="AbcCountCText" Text="0" FontSize="26" FontWeight="Bold"
                                               Foreground="#334155" Margin="0,8,0,2"/>
                                    <TextBlock Text="menor giro / restante" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <DataGrid x:Name="AbcGrid" Grid.Row="2" Style="{StaticResource RelDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Posicao}" Width="44"
                                                    ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTemplateColumn Header="Classe" Width="72" HeaderStyle="{StaticResource RelHdrL}"
                                                        CellTemplate="{StaticResource AbcClassBadgeTemplate}"/>
                                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90"
                                                    ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"
                                                    ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Qtd." Binding="{Binding QtyDisplay}" Width="80"
                                                    ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding TotalDisplay}" Width="100"
                                                    ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                                <DataGridTextColumn Header="% Part." Binding="{Binding ParticipacaoDisplay}" Width="72"
                                                    ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                                <DataGridTextColumn Header="% Acum." Binding="{Binding AcumuladoDisplay}" Width="72"
                                                    ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- PREVISÃO FIADOS -->
                <DockPanel x:Name="PanelPrevisao" Visibility="Collapsed" Margin="16" LastChildFill="True"
                           VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Previsão de Recebimento (fiados)" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Vencimento estimado = última venda + 30 dias. Inclui saldos já vencidos no horizonte."
                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,10" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Horizonte:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                                <RadioButton x:Name="Prev7" Content="7 dias" GroupName="prev" Margin="0,0,14,0"
                                             VerticalAlignment="Center" Checked="PrevHorizonte_Changed"/>
                                <RadioButton x:Name="Prev15" Content="15 dias" GroupName="prev" Margin="0,0,14,0"
                                             VerticalAlignment="Center" Checked="PrevHorizonte_Changed"/>
                                <RadioButton x:Name="Prev30" Content="30 dias" GroupName="prev" IsChecked="True"
                                             VerticalAlignment="Center" Checked="PrevHorizonte_Changed"/>
                                <Button Content="Atualizar" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                        Margin="16,0,0,0" Click="PrevAtualizar_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PrevMeta" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                               FontSize="12" Foreground="#475569"/>
                    <DataGrid x:Name="PrevGrid" Style="{StaticResource RelDataGrid}" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"
                                                ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="120"
                                                ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding BalanceDisplay}" Width="100"
                                                ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                            <DataGridTextColumn Header="Última venda" Binding="{Binding LastSaleDisplay}" Width="110"
                                                ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Venc. estimado" Binding="{Binding DueDisplay}" Width="110"
                                                ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTemplateColumn Header="Status" Width="96" HeaderStyle="{StaticResource RelHdrL}"
                                                    CellTemplate="{StaticResource PrevisaoStatusBadgeTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- FECHAMENTO CONSOLIDADO -->
                <Grid x:Name="PanelFechamento" Visibility="Collapsed" Margin="16"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"
                            Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Fechamento Consolidado" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14"/>
                            <TextBlock Text="De" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <controls:BrDateBox x:Name="FcDateFrom" Margin="0,0,0,12"/>
                            <TextBlock Text="até" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <controls:BrDateBox x:Name="FcDateTo" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Mês atual" Style="{StaticResource SgdbOutlineButtonStyle}" Click="FcMes_Click"/>
                                <Button Content="Pesquisar" Style="{StaticResource SgdbPrimaryButtonStyle}" Click="FcPesquisar_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="FcPeriodoText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Border Margin="0,0,8,8" Padding="14" Background="#EEF2FF" CornerRadius="10" BorderBrush="#C7D2FE" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Total faturado" FontSize="11" Foreground="#4338CA"/>
                                        <TextBlock x:Name="FcFaturado" FontSize="22" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,8" Padding="14" Background="#ECFDF5" CornerRadius="10" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Recebido à vista" FontSize="11" Foreground="#047857"/>
                                        <TextBlock x:Name="FcAVista" FontSize="22" FontWeight="Bold" Foreground="#065F46" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,8" Padding="14" Background="#FFF7ED" CornerRadius="10" BorderBrush="#FED7AA" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Lançado em fiado" FontSize="11" Foreground="#C2410C"/>
                                        <TextBlock x:Name="FcFiado" FontSize="22" FontWeight="Bold" Foreground="#9A3412" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,8" Padding="14" Background="#F0F9FF" CornerRadius="10" BorderBrush="#BAE6FD" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Recebido de fiado (período)" FontSize="11" Foreground="#0369A1"/>
                                        <TextBlock x:Name="FcRecebidoFiado" FontSize="22" FontWeight="Bold" Foreground="#0C4A6E" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,0" Padding="14" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="CMV (custo das mercadorias)" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="FcCmv" FontSize="20" FontWeight="Bold" Foreground="#334155" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="14" Background="#F0FDF4" CornerRadius="10" BorderBrush="#BBF7D0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Lucro estimado / margem" FontSize="11" Foreground="#166534"/>
                                        <TextBlock x:Name="FcLucro" FontSize="20" FontWeight="Bold" Foreground="#14532D" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock x:Name="FcMeta" FontSize="12" Foreground="#475569" Margin="0,4,0,8"/>
                            <TextBlock Text="Faturamento por forma de pagamento" FontWeight="SemiBold" Margin="0,8,0,6"/>
                            <DataGrid x:Name="FcFormaGrid" Style="{StaticResource RelDataGrid}" Height="180"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Forma" Binding="{Binding Key}" Width="*"
                                                        ElementStyle="{StaticResource RelCellL}" HeaderStyle="{StaticResource RelHdrL}"/>
                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value, StringFormat=N2}" Width="120"
                                                        ElementStyle="{StaticResource RelCellR}" HeaderStyle="{StaticResource RelHdrR}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- CAIXA HISTÓRICO LISTA -->
                <Grid x:Name="PanelCaixaLista" Visibility="Collapsed" Margin="16"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"
                            Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Histórico de Abertura e Fechamento"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <RadioButton x:Name="CxRecentes" Content="Exibir os mais recentes" IsChecked="True"
                                         Margin="0,0,0,8" Checked="CxFiltro_Changed"/>
                            <RadioButton x:Name="CxPeriodo" Content="Filtrar por período"
                                         Margin="0,0,0,12" Checked="CxFiltro_Changed"/>
                            <StackPanel x:Name="CxPeriodoFields" IsEnabled="False" Margin="0,0,0,4">
                                <TextBlock Text="De" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <controls:BrDateBox x:Name="CxDateFrom" Margin="0,0,0,12"/>
                                <TextBlock Text="até" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <controls:BrDateBox x:Name="CxDateTo" Margin="0,0,0,14"/>
                            </StackPanel>
                            <TextBlock Text="Limite" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="CxLimit" Text="30" Style="{StaticResource SgdbFilterTextBoxStyle}"
                                     Width="88" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <Button Content="Atualizar" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0" Click="CxAtualizar_Click"/>
                            <TextBlock Text="Duplo clique para ver os movimentos do turno."
                                       FontSize="11" Foreground="#64748B" Margin="0,16,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="CxGrid" Style="{StaticResource RelDataGrid}"
                                  MouseDoubleClick="CxGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="48"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Aberto em" Binding="{Binding OpenedAtBr}" Width="100"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Fechado em" Binding="{Binding ClosedAtBr}" Width="100"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Operador" Binding="{Binding OperatorDisplay}" Width="110"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTextColumn Header="Saldo inicial" Binding="{Binding SaldoInicialDisplay}" Width="90"
                                                    ElementStyle="{StaticResource RelCellR}"
                                                    HeaderStyle="{StaticResource RelHdrR}"/>
                                <DataGridTextColumn Header="Saldo final" Binding="{Binding SaldoFinalDisplay}" Width="90"
                                                    ElementStyle="{StaticResource RelCellR}"
                                                    HeaderStyle="{StaticResource RelHdrR}"/>
                                <DataGridTextColumn Header="S. Final informado" Binding="{Binding SaldoInformadoDisplay}" Width="110"
                                                    ElementStyle="{StaticResource RelCellR}"
                                                    HeaderStyle="{StaticResource RelHdrR}"/>
                                <DataGridTemplateColumn Header="Diferença / Quebra" Width="110"
                                                        HeaderStyle="{StaticResource RelHdrR}"
                                                        CellTemplate="{StaticResource CaixaDifferenceTemplate}"/>
                                <DataGridTextColumn Header="Observação" Binding="{Binding ObsDisplay}" Width="*"
                                                    ElementStyle="{StaticResource RelCellL}"
                                                    HeaderStyle="{StaticResource RelHdrL}"/>
                                <DataGridTemplateColumn Header="Status" Width="88"
                                                        HeaderStyle="{StaticResource RelHdrL}"
                                                        CellTemplate="{StaticResource CaixaStatusBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="Ações" Width="148"
                                                        HeaderStyle="{StaticResource RelHdrL}"
                                                        CellTemplate="{StaticResource CaixaAcoesTemplate}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="CxMeta" Grid.Row="1" Margin="0,8,0,0" FontSize="12" Foreground="#475569"/>
                    </Grid>
                </Grid>

                <!-- CAIXA DETALHE -->
                <Grid x:Name="PanelCaixaDetalhe" Visibility="Collapsed" Margin="16"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="← Voltar à lista" Style="{StaticResource SgdbOutlineButtonStyle}" Click="CxVoltar_Click"/>
                        <TextBlock x:Name="CxDetailTitle" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <TextBlock x:Name="CxDetailResumo" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <DataGrid x:Name="CxDetailGrid" Grid.Row="2" Style="{StaticResource RelDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data/Hora" Binding="{Binding DateTimeDisplay}" Width="130"
                                                ElementStyle="{StaticResource RelCellL}"
                                                HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Historico}" Width="*"
                                                ElementStyle="{StaticResource RelCellL}"
                                                HeaderStyle="{StaticResource RelHdrL}"/>
                            <DataGridTextColumn Header="Entrada" Binding="{Binding EntradaDisplay}" Width="100"
                                                ElementStyle="{StaticResource RelCellR}"
                                                HeaderStyle="{StaticResource RelHdrR}"/>
                            <DataGridTextColumn Header="Saída" Binding="{Binding SaidaDisplay}" Width="100"
                                                ElementStyle="{StaticResource RelCellR}"
                                                HeaderStyle="{StaticResource RelHdrR}"/>
                            <DataGridTextColumn Header="Forma" Binding="{Binding FormaPagto}" Width="120"
                                                ElementStyle="{StaticResource RelCellL}"
                                                HeaderStyle="{StaticResource RelHdrL}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
