<UserControl x:Class="SGDB.Views.LotExpiryModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SGDB.Models"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Controle de Validades"
                               FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <WrapPanel x:Name="CardsPanel" Grid.Row="1" Margin="10,8,10,4"/>

            <Border Grid.Row="2" Padding="12,8" Background="#F8FAFC" BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filtro" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="12" Foreground="#64748B"/>
                    <ComboBox x:Name="FilterBox" Width="150" Height="32" Margin="0,0,12,0"
                              SelectionChanged="Filter_Changed"/>
                    <TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="SearchBox" Width="180" Height="32" Padding="8,0"
                             VerticalContentAlignment="Center" Margin="0,0,12,0"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="Grupo" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="12" Foreground="#64748B"/>
                    <ComboBox x:Name="GroupBox" Width="160" Height="32" Margin="0,0,12,0"
                              SelectionChanged="Filter_Changed"/>
                    <TextBlock Text="Marca" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="12" Foreground="#64748B"/>
                    <ComboBox x:Name="BrandBox" Width="140" Height="32" Margin="0,0,12,0"
                              SelectionChanged="Filter_Changed"/>
                    <Button Content="Atualizar (F5)" Style="{StaticResource SgdbPrimaryButtonStyle}"
                            Height="32" Padding="12,6" Margin="0,0,8,0" Click="Refresh_Click"/>
                    <Button Content="Ver produto" Height="32" Padding="12,6" Margin="0,0,8,0"
                            Click="OpenProduct_Click"/>
                    <Button Content="Lotes e validades" Height="32" Padding="12,6"
                            Click="OpenLots_Click"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="12,4,12,0">
                <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                           Text="Fonte: lotes ativos (product_lots). Clique no card para filtrar. Duplo clique abre o cadastro."/>
                <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="{x:Static models:ValidityControlUi.FridgeDisclaimer}"/>
                <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="{x:Static models:ValidityControlUi.LotValueNotLoss}"/>
            </StackPanel>

            <DataGrid x:Name="Grid" Grid.Row="4" Margin="10"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      BorderBrush="#C8C4BC" BorderThickness="1" Background="White"
                      RowHeaderWidth="0" RowHeight="32" FontSize="12.5"
                      AlternatingRowBackground="#F8FAFC"
                      MouseDoubleClick="Grid_MouseDoubleClick"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Código" Binding="{Binding ProductCode}" Width="80"/>
                    <DataGridTextColumn Header="Lote" Binding="{Binding LotDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding QtyDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Validade" Binding="{Binding ExpiryDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Dias" Binding="{Binding DaysDisplay}" Width="60"/>
                    <DataGridTemplateColumn Header="Situação" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,2" HorizontalAlignment="Left" Margin="2,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="expired">
                                                    <Setter Property="Background" Value="#7F1D1D"/>
                                                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="alert">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="BorderBrush" Value="#FECACA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="attention">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="notice">
                                                    <Setter Property="Background" Value="#FEF9C3"/>
                                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="info">
                                                    <Setter Property="Background" Value="#E0F2FE"/>
                                                    <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="expired">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="alert">
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="attention">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="notice">
                                                        <Setter Property="Foreground" Value="#854D0E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="info">
                                                        <Setter Property="Foreground" Value="#075985"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Valor do lote" Binding="{Binding LotValueDisplay}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding LotValueTooltip}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ação" Binding="{Binding ActionUiDisplay}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding ActionTooltip}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Origem" Binding="{Binding OriginDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Grupo" Binding="{Binding GroupName}" Width="90"/>
                    <DataGridTextColumn Header="Marca" Binding="{Binding BrandName}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="5" Padding="12,8" Background="#F8FAFC" BorderBrush="#C8C4BC"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock x:Name="DetailText" FontSize="11" Foreground="#475569" TextWrapping="Wrap"
                               Text="Selecione uma linha para ver o detalhe."/>
                    <TextBlock x:Name="MetaText" FontSize="12" Foreground="#334155" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
