<UserControl x:Class="SGDB.Views.LotExpiryModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Validade por lote (FEFO) — promoção e saída antecipada"
                               FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12,8" Background="#F8FAFC" BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Horizonte:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                    <RadioButton x:Name="Days30" Content="30 dias" GroupName="lotdays" IsChecked="True"
                                 Margin="0,0,14,0" VerticalAlignment="Center" Checked="Days_Changed"/>
                    <RadioButton x:Name="Days60" Content="60 dias" GroupName="lotdays"
                                 Margin="0,0,14,0" VerticalAlignment="Center" Checked="Days_Changed"/>
                    <RadioButton x:Name="Days90" Content="90 dias" GroupName="lotdays"
                                 Margin="0,0,14,0" VerticalAlignment="Center" Checked="Days_Changed"/>
                    <Button Content="Atualizar (F5)" Style="{StaticResource SgdbPrimaryButtonStyle}"
                            Click="Refresh_Click"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="Grid" Grid.Row="2" Margin="10"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      BorderBrush="#C8C4BC" BorderThickness="1" Background="White"
                      RowHeaderWidth="0" RowHeight="32" FontSize="12.5"
                      AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Lote" Binding="{Binding LotDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Validade" Binding="{Binding ExpiryDisplay}" Width="100"/>
                    <DataGridTemplateColumn Header="Situação" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,2" HorizontalAlignment="Center" Margin="2,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEF2FF"/>
                                            <Setter Property="BorderBrush" Value="#C7D2FE"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="crit">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="BorderBrush" Value="#FECACA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="expired">
                                                    <Setter Property="Background" Value="#7F1D1D"/>
                                                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DaysDisplay}" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#3730A3"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="crit">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="expired">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Qtd" Binding="{Binding QtyDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Un." Binding="{Binding Unit}" Width="50"/>
                    <DataGridTextColumn Header="Código" Binding="{Binding ProductCode}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Padding="12,8" Background="#F8FAFC" BorderBrush="#C8C4BC"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="MetaText" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
