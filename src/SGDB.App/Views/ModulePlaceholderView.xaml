<UserControl x:Class="SGDB.Views.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SgdbBgBrush}">
    <Border Margin="0" BorderBrush="#B8C4D4" BorderThickness="1"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,6" Background="{StaticResource TitleBarGradientBrush}"
                    BorderBrush="{StaticResource SgdbGoldBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="ModuleTitleText" Text="Módulo"
                               Foreground="White" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton" Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="24" Background="White">
                <TextBlock x:Name="ModuleBodyText" TextWrapping="Wrap" FontSize="13"
                           Foreground="#334155" VerticalAlignment="Top" LineHeight="22"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
