<Window x:Class="SGDB.Views.PdvCupomConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impressão"
        Width="820" Height="900"
        MinWidth="720" MinHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="#C8C8C8"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowState="Normal"
        SizeToContent="Manual">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/PdvTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#D8D8D8" BorderBrush="#666666" BorderThickness="2" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PdvPayTitleBar}">
                <Grid>
                    <TextBlock Text="Impressão" Style="{StaticResource PdvPayTitleText}"/>
                    <Button Content="×" Style="{StaticResource PdvCloseButton}" HorizontalAlignment="Right"
                            Click="NoPrint_Click" ToolTip="Fechar sem imprimir (N)"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Deseja imprimir o cupom?"
                               FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MessageText" FontSize="16" Foreground="#333333"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <Border x:Name="CupomHost" Grid.Row="1" Background="#EFEFEF" BorderBrush="#AAAAAA"
                        BorderThickness="1" Padding="12" HorizontalAlignment="Stretch"
                        SizeChanged="CupomHost_SizeChanged">
                    <Viewbox x:Name="CupomViewbox" Stretch="Uniform" StretchDirection="Both"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="CupomPaper" Background="White"
                                BorderBrush="#CCCCCC" BorderThickness="1" Padding="22,18"
                                HorizontalAlignment="Left" ClipToBounds="False">
                            <TextBlock x:Name="CupomText"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="16"
                                       Foreground="#111111"
                                       xml:space="preserve"
                                       TextWrapping="NoWrap"/>
                        </Border>
                    </Viewbox>
                </Border>

                <TextBlock x:Name="HintText" Grid.Row="2"
                           Text="Prévia — S imprime · N não imprime · Esc volta"
                           FontSize="14" FontWeight="SemiBold" Foreground="#555555"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
            </Grid>

            <Border Grid.Row="2" Background="#ECECEC" BorderBrush="#AAAAAA"
                    BorderThickness="0,1,0,0" Padding="14,12">
                <Grid>
                    <Button Content="Voltar / Alterar pagamento (Esc)" Padding="18,10"
                            Foreground="#8A1F11" FontWeight="SemiBold" FontSize="14"
                            HorizontalAlignment="Left" Click="CancelSale_Click"
                            ToolTip="Estorna esta venda e reabre as formas de pagamento (itens ficam no carrinho)"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Imprimir (S)" Padding="22,10" Margin="0,0,8,0"
                                FontWeight="SemiBold" FontSize="14" Click="Print_Click"/>
                        <Button Content="Não imprimir (N)" Padding="22,10" FontSize="14"
                                Click="NoPrint_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
