<Window x:Class="SGDB.Views.LotCoverageFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobertura"
        Width="460" Height="Auto" SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SgdbBgBrush}"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"
                   TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock x:Name="HintText" Grid.Row="1" FontSize="12" Foreground="#64748B"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel x:Name="QtyPanel" Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="QtyLabel" Text="Quantidade *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="QtyBox" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>
            <TextBlock x:Name="AvailableText" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel x:Name="ExpiryPanel" Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Validade (dd/MM/aaaa) *" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="ExpiryBox" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>
        </StackPanel>

        <StackPanel x:Name="LotPanel" Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Lote (opcional)" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="LotBox" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>
            <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"
                       Text="Pode informar validade mesmo sem número de lote."/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock x:Name="ReasonLabel" Text="Motivo" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="ReasonBox" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="6" FontSize="12" Foreground="#B91C1C"
                   TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource SgdbOutlineButtonStyle}"
                    Padding="14,8" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="Salvar" Style="{StaticResource SgdbPrimaryButtonStyle}"
                    Padding="16,8" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
