<UserControl x:Class="SGDB.Views.StockAbcModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECE9E4" Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Curva ABC / Giro de Estoque" FontWeight="SemiBold" FontSize="13"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12" Background="#FAF8F4" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="De" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DateFrom" Width="130" Height="32" Margin="0,0,16,0"/>
                    <TextBlock Text="Até" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DateTo" Width="130" Height="32" Margin="0,0,16,0"/>
                    <Button Content="Visualizar (F7)" Padding="14,7" Height="32"
                            Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Refresh_Click"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="2" x:Name="AbcGrid" Margin="12,8,12,0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0" RowHeight="36" FontSize="12" BorderBrush="#C8C4BC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Posicao}" Width="40"/>
                    <DataGridTextColumn Header="Classe" Binding="{Binding Classe}" Width="55"/>
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="80"/>
                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Qtd vendida" Binding="{Binding QtyDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Total R$" Binding="{Binding TotalDisplay}" Width="90"/>
                    <DataGridTextColumn Header="% Part." Binding="{Binding ParticipacaoDisplay}" Width="70"/>
                    <DataGridTextColumn Header="% Acum." Binding="{Binding AcumuladoDisplay}" Width="70"/>
                    <DataGridTextColumn Header="Estoque" Binding="{Binding StockDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Dias est." Binding="{Binding DaysDisplay}" Width="70"/>
                    <DataGridTextColumn Header="Capital R$" Binding="{Binding CapitalDisplay}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" x:Name="SummaryText" Margin="12,8,12,10" FontSize="12" Foreground="#475569"
                       Text="A = 80% do faturamento · B = 15% · C = 5%. Dias est. = estoque ÷ venda média diária."/>
        </Grid>
    </Border>
</UserControl>
