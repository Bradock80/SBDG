<UserControl x:Class="SGDB.Views.NfeImportModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECE9E4" Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="NumColText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NumHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="TextHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="EditCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Importar XML NF-e" FontWeight="SemiBold" FontSize="13"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12" Background="#FAF8F4" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Selecionar XML..." Padding="14,7" Height="32" Margin="0,0,10,0"
                                Style="{StaticResource SgdbPrimaryButtonStyle}" Click="PickXml_Click"/>
                        <TextBlock x:Name="FileText" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"
                                   Text="Nenhum arquivo selecionado"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Margem sugerida %" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                        <TextBox x:Name="MarginBox" Width="70" Height="32" Text="30" Padding="6,0"
                                 VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                        <Button Content="Recalcular vendas" Padding="10,6" Height="32" Margin="0,0,16,0"
                                Style="{StaticResource SgdbOutlineButtonStyle}" Click="RecalcMargin_Click"
                                ToolTip="Preenche a coluna Venda com custo + margem. Depois você pode editar na grade."/>
                        <CheckBox x:Name="CreateMissingBox" Content="Cadastrar produtos novos" IsChecked="False"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  ToolTip="Só marque se o item realmente não existir no cadastro. Preferível corrigir o EAN do produto."/>
                        <CheckBox x:Name="UpdateStockBox" Content="Gerar estoque" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  ToolTip="Soma as quantidades no estoque. A compra e o Contas a Pagar (pendente) são lançados mesmo assim."/>
                        <CheckBox x:Name="UpdatePriceBox" Content="Atualizar custo/venda" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  ToolTip="Atualiza custo e preço de venda dos produtos com os valores da grade."/>
                        <CheckBox x:Name="IncluirStCustoBox" Content="Incluir ICMS-ST no custo" IsChecked="False"
                                  VerticalAlignment="Center"
                                  Checked="IncluirStCustoBox_Changed"
                                  Unchecked="IncluirStCustoBox_Changed"
                                  ToolTip="Desmarcado = preço igual à nota. Marcado = soma ST/FCP ao custo."/>
                    </StackPanel>
                    <TextBlock x:Name="HeaderInfo" Margin="0,10,0,0" FontSize="12" Foreground="#334155"/>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#64748B"
                               Text="Por padrão o custo é o preço da nota (sem ST). Marque “Incluir ICMS-ST no custo” se quiser o valor cheio pago."/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="2" x:Name="ItemsGrid" Margin="12,8,12,0"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF2F7"
                      RowHeaderWidth="0" RowHeight="36" FontSize="12" BorderBrush="#C8C4BC"
                      AlternatingRowBackground="#FAFBFC"
                      SelectionUnit="Cell"
                      CellEditEnding="ItemsGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="72" IsReadOnly="True" HeaderStyle="{StaticResource TextHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                        Margin="6,0,0,0" ToolTip="{Binding StatusDisplay}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Produto NF" Binding="{Binding Name}" Width="*" MinWidth="180"
                                        IsReadOnly="True" HeaderStyle="{StaticResource TextHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Name}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Lote" Binding="{Binding LotDisplay}" Width="80"
                                        IsReadOnly="True" HeaderStyle="{StaticResource TextHeader}"/>
                    <DataGridTextColumn Header="Validade" Binding="{Binding ExpiryDisplay}" Width="90"
                                        IsReadOnly="True" HeaderStyle="{StaticResource TextHeader}"/>
                    <DataGridTextColumn Header="Conv." Binding="{Binding PackNoteDisplay}" Width="140"
                                        IsReadOnly="True" HeaderStyle="{StaticResource TextHeader}"/>
                    <DataGridTextColumn Header="Preço NF" Binding="{Binding NfPriceDisplay}" Width="80"
                                        IsReadOnly="True" HeaderStyle="{StaticResource NumHeader}"
                                        ElementStyle="{StaticResource NumColText}"/>
                    <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N3}"
                                        Width="80" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EditCell}">
                                <Setter Property="Background" Value="#FFFBEB"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Custo" Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N4}"
                                        Width="90" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EditCell}">
                                <Setter Property="Background" Value="#FFFBEB"/>
                                <Setter Property="ToolTip"
                                        Value="Custo unitário da NF (cigarro = por cigarro no estoque)."/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Custo maço" Binding="{Binding CatalogCostDisplay}" Width="90"
                                        IsReadOnly="True" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumColText}">
                                <Setter Property="ToolTip"
                                        Value="Vai para Preço Compra/Custo no cadastro. Cigarro = maço."/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Venda cad." Binding="{Binding SalePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                        Width="85" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EditCell}">
                                <Setter Property="Background" Value="#ECFDF5"/>
                                <Setter Property="ToolTip"
                                        Value="Cigarro: preço do maço (ex.: 14,50). Demais: unitário."/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="90"
                                        IsReadOnly="True" HeaderStyle="{StaticResource NumHeader}"
                                        ElementStyle="{StaticResource NumColText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Padding="12,10" Background="#FAFAF9">
                <DockPanel>
                    <TextBlock x:Name="SummaryText" DockPanel.Dock="Left" VerticalAlignment="Center"
                               FontSize="12" Foreground="#475569"
                               Text="Selecione um XML da NF-e para começar."/>
                    <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Content="Importar e aplicar (F9)"
                            Padding="16,8" HorizontalAlignment="Right" IsEnabled="False"
                            Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Apply_Click"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
