<Window x:Class="SGDB.Views.OpenTabDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck"
        Width="920" Height="640" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#ECE9E4"
        FontFamily="Tahoma, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E3A5F" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TitleText" Text="Deck" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#C5D4E8" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total" FontSize="12" Foreground="#C5D4E8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TotalText" Text="R$ 0,00" FontSize="26" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#C8C4BC" BorderThickness="1" Padding="10" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Digite · ↑↓ escolhe o produto · Enter vai na qtd · Enter lança" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="SearchBox" Height="34" Margin="0,4,8,0" FontSize="15"
                             VerticalContentAlignment="Center" Padding="8,0"
                             CharacterCasing="Upper"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             KeyDown="SearchBox_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Qtd" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="QtyBox" Height="34" Margin="0,4,8,0" FontSize="15" Text="1"
                             VerticalContentAlignment="Center" Padding="8,0"
                             GotKeyboardFocus="QtyBox_GotKeyboardFocus"
                             KeyDown="QtyBox_KeyDown"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Lançar (Enter)" Padding="16,0" Height="34" Margin="0,16,0,0"
                        Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Add_Click"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border x:Name="LookupPanel" Grid.Row="2" Background="#F1F5F9" BorderBrush="#94A3B8"
                BorderThickness="1" Margin="0,0,0,10" MaxHeight="220" Visibility="Collapsed">
            <ListBox x:Name="LookupList"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     Focusable="False" IsTabStop="False"
                     FontSize="13"
                     MouseDoubleClick="LookupList_MouseDoubleClick"
                     SelectionChanged="LookupList_SelectionChanged">
                <ListBox.Resources>
                    <!-- Seleção visível mesmo sem foco (problema comum no PC da loja) -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Code}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding SalePriceDisplay}" FontSize="12"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding StockDisplay}" FontSize="12"
                                       HorizontalAlignment="Right" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#C8C4BC" BorderThickness="1">
            <DataGrid x:Name="ItemsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"
                      Background="White" RowHeaderWidth="0" RowHeight="30" FontSize="13"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Background" Value="#EEF2F7"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding ProductCode}" Width="110"/>
                    <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Unit." Binding="{Binding Unit}" Width="60"/>
                    <DataGridTextColumn Header="Preço" Binding="{Binding UnitPriceDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalDisplay}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Remover item (Del)" Padding="12,8"
                    Style="{StaticResource SgdbOutlineButtonStyle}" Click="Remove_Click"/>
            <Button DockPanel.Dock="Left" Content="Pré-conta (F9)" Padding="12,8" Margin="8,0,0,0"
                    Style="{StaticResource SgdbOutlineButtonStyle}" Click="PreConta_Click"
                    ToolTip="Imprime conferência para o cliente"/>
            <Button DockPanel.Dock="Left" Content="Cancelar deck" Padding="12,8" Margin="8,0,0,0"
                    Style="{StaticResource SgdbOutlineButtonStyle}" Click="CancelTab_Click"
                    Foreground="#C41E3A"/>
            <Button DockPanel.Dock="Right" Content="Voltar (Esc)" Padding="12,8" Margin="8,0,0,0"
                    Style="{StaticResource SgdbOutlineButtonStyle}" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Content="Cobrar / pagar (F10)" Padding="16,8"
                    Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Settle_Click"
                    ToolTip="Pode dividir o valor por N pessoas antes de pagar"/>
        </DockPanel>
    </Grid>
</Window>
