<UserControl x:Class="SGDB.Views.ContainerTypesModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECE9E4"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Cadastrar vasilhame" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" MaxWidth="980" HorizontalAlignment="Left">
                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="Cadastre galões, garrafas, cascos etc. Ex.: "/><Run Text="Galão 20L" FontWeight="SemiBold"/>
                        <Run Text=", Garrafa 600ml, Casco 1L. Depois use em produtos do PDV e no módulo de Vasilhame."/>
                    </TextBlock>

                    <Border Background="#F8FAFC" BorderBrush="#C5D4E8" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                <TextBlock Text="Nome" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="NameBox" Height="30" Margin="0,4,0,0"
                                         ToolTip="Ex.: Galão 20L, Garrafa 600ml"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="Estoque atual" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="StockBox" Height="30" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,10">
                                <TextBlock Text="Caução (R$)" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="PriceBox" Height="30" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" VerticalAlignment="Bottom">
                                <CheckBox x:Name="ActiveBox" Content="Ativo" IsChecked="True"/>
                            </StackPanel>
                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                    x:Name="SaveBtn" Content="Cadastrar tipo"
                                    Height="34" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                    Click="Save_Click"/>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#C8C4BC" BorderThickness="1" MaxHeight="280">
                        <DataGrid x:Name="TypesGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"
                                  Background="White" RowHeaderWidth="0" RowHeight="28" FontSize="12"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionChanged="TypesGrid_SelectionChanged">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#DDD8D0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Estoque" Binding="{Binding StockDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Caução (R$)" Binding="{Binding SalePriceDisplay}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Novo" Margin="0,0,8,0" Padding="14,6"
                                Style="{StaticResource SgdbOutlineButtonStyle}" Click="New_Click"/>
                        <Button Content="Fechar" Padding="14,6"
                                Style="{StaticResource SgdbOutlineButtonStyle}" Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
