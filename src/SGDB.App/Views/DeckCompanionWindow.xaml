<Window x:Class="SGDB.Views.DeckCompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck no celular"
        Width="500" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="460" MinHeight="560"
        Background="#ECE9E4">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Deck no celular" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="#475569"
                       Text="PC no cabo + celular no Wi‑Fi funciona se for o MESMO roteador. Use o IP do cabo (não 127.0.0.1). Liberar Firewall se o celular não abrir."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Background="White" BorderBrush="#C8C4BC" BorderThickness="1" Padding="12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PIN (celular)" FontSize="11" Foreground="#64748B"/>
                        <TextBox x:Name="PinBox" Height="32" FontSize="18" FontWeight="Bold"
                                 VerticalContentAlignment="Center" MaxLength="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                        <Button Content="Salvar PIN" Height="32" Click="SavePin_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Porta" FontSize="11" Foreground="#64748B"/>
                        <TextBox x:Name="PortBox" Height="32" VerticalContentAlignment="Center" Text="5050"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <Button x:Name="StartBtn" Content="Ligar" Width="80" Height="32" Margin="0,0,6,0"
                                Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Start_Click"/>
                        <Button x:Name="StopBtn" Content="Desligar" Width="80" Height="32" Margin="0,0,6,0" IsEnabled="False"
                                Click="Stop_Click"/>
                        <Button Content="Firewall" Width="80" Height="32" Click="Firewall_Click"
                                ToolTip="Liberar porta no Firewall do Windows (recomendado)"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12" Foreground="#334155" TextWrapping="Wrap"
                           Text="Servidor desligado."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="White" BorderBrush="#C8C4BC" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="Endereço para o celular (IP do cabo)" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="UrlText" FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,8"
                               Text="—"/>
                    <Image x:Name="QrImage" Width="200" Height="200" Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AltUrlsText" Margin="0,10,0,0" FontSize="11" Foreground="#64748B"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Copiar endereço" Width="140" Margin="0,0,8,0" Click="CopyUrl_Click"/>
                        <Button Content="Abrir no PC (teste)" Width="140" Click="OpenLocal_Click"
                                ToolTip="Testa se o servidor responde neste computador"/>
                    </StackPanel>
                    <Border Margin="0,12,0,0" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" Padding="10">
                        <TextBlock FontSize="11" Foreground="#9A3412" TextWrapping="Wrap"
                                   Text="QR só na 1ª vez. No celular: Favoritos ou Adicionar à tela inicial. Depois abra o atalho (PC com Ligar). Cabo+Wi‑Fi = mesmo roteador. Nunca use 127.0.0.1."/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3" Content="Fechar" HorizontalAlignment="Right" Width="90" Height="32" Margin="0,12,0,0"
                IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
