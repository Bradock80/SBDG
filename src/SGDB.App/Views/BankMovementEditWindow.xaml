<Window x:Class="SGDB.Views.BankMovementEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SGDB.Controls"
        Title="Lançamento Bancário" Height="430" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SgdbBgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Data" Margin="0,0,0,4"/>
            <controls:BrDateBox x:Name="DateBox" Margin="0,0,0,10"/>
            <TextBlock Text="Tipo" Margin="0,0,0,4"/>
            <ComboBox x:Name="KindBox" Height="32" Margin="0,0,0,10"/>
            <TextBlock Text="Descrição" Margin="0,0,0,4"/>
            <TextBox x:Name="DescBox" Height="32" Margin="0,0,0,10"/>
            <TextBlock Text="Forma (Pix, Débito…)" Margin="0,0,0,4"/>
            <ComboBox x:Name="PayBox" Height="32" IsEditable="True" Margin="0,0,0,10"/>
            <TextBlock Text="Maquininha / Operadora" Margin="0,0,0,4"/>
            <ComboBox x:Name="OperatorBox" Height="32" IsEditable="True" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Entrada R$" Margin="0,0,0,4"/>
                    <TextBox x:Name="InBox" Height="32" Text="0,00"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Saída R$" Margin="0,0,0,4"/>
                    <TextBox x:Name="OutBox" Height="32" Text="0,00"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Taxa cobrada R$" Margin="0,10,0,4"/>
            <TextBox x:Name="FeeBox" Height="32" Text="0,00"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Salvar" Style="{StaticResource SgdbPrimaryButtonStyle}" Width="100" Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Style="{StaticResource SgdbOutlineButtonStyle}" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
