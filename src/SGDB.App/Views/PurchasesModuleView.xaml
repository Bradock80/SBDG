<UserControl x:Class="SGDB.Views.PurchasesModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SGDB.Controls"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="PurchasesModuleView_PreviewKeyDown">
    <Border BorderBrush="#B8C4D4" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="{StaticResource TitleBarGradientBrush}"
                    BorderBrush="{StaticResource SgdbGoldBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Compras" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    <Button x:Name="CloseTabButton" Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="CloseTabButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12,10" Background="#FAF8F4"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="F6 | Localizar &lt;&lt;Série | Número | Fornecedor | CNPJ&gt;&gt;"
                               FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="SearchBox" Height="30" Padding="8,0"
                             FontSize="13" VerticalContentAlignment="Center"
                             CharacterCasing="Upper"
                             TextChanged="SearchBox_TextChanged"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Período | Emissão" VerticalAlignment="Center"
                                   Margin="0,0,12,0" FontSize="11"/>
                        <controls:BrDateBox x:Name="DateFromBox"
                                            MinWidth="148" Width="148" Height="30"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"/>
                        <TextBlock Text="até" VerticalAlignment="Center"
                                   Margin="0,0,10,0" FontSize="11"/>
                        <controls:BrDateBox x:Name="DateToBox"
                                            MinWidth="148" Width="148" Height="30"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                        <Button Content="Filtrar período"
                                Margin="0,0,8,0" VerticalAlignment="Center"
                                Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Refresh_Click"/>
                        <Button Content="Limpar busca" VerticalAlignment="Center"
                                Style="{StaticResource SgdbOutlineButtonStyle}" Click="ClearFilter_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,8,12,4">
                <RadioButton x:Name="StatusTodas" Content="Todas" GroupName="status" Margin="0,0,12,0"
                             IsChecked="True" Checked="Status_Changed"/>
                <RadioButton x:Name="StatusAberta" Content="Aberta" GroupName="status" Margin="0,0,12,0"
                             Checked="Status_Changed"/>
                <RadioButton x:Name="StatusFechada" Content="Fechada" GroupName="status" Margin="0,0,12,0"
                             Checked="Status_Changed"/>
                <RadioButton x:Name="StatusCancelada" Content="Cancelada" GroupName="status"
                             Checked="Status_Changed"/>
            </StackPanel>

            <DataGrid x:Name="PurchasesGrid" Grid.Row="3" Margin="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource SgdbGridLineBrush}"
                      VerticalGridLinesBrush="{StaticResource SgdbGridLineBrush}"
                      BorderThickness="0" Background="White"
                      RowHeight="28" FontSize="12"
                      MouseDoubleClick="PurchasesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Data Emissão" Binding="{Binding EmissionDateDisplay}" Width="95"/>
                    <DataGridTextColumn Header="Data Entrada" Binding="{Binding EntryDateDisplay}" Width="95"/>
                    <DataGridTextColumn Header="&gt;&gt;Série" Binding="{Binding Series}" Width="55"/>
                    <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="80"/>
                    <DataGridTextColumn Header="Chave" Binding="{Binding NfeKeyDisplay}" Width="110"/>
                    <DataGridTextColumn Header="CPF/CNPJ" Binding="{Binding SupplierCnpj}" Width="120"/>
                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="4" Background="#F0F4F8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TOTAL:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TotalBarText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource SgdbBlueBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Background="#F5F3EE" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,8">
                <WrapPanel>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="NewPurchase_Click">
                        <StackPanel>
                            <TextBlock Text="📄+" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F2 | Novo" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="EditPurchase_Click">
                        <StackPanel>
                            <TextBlock Text="✎" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F3 | Alterar" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="ReopenPurchase_Click">
                        <StackPanel>
                            <TextBlock Text="↩" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F7 | Reabrir" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="ViewPurchase_Click">
                        <StackPanel>
                            <TextBlock Text="👁" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="Alt+F7 | Visualizar" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="Print_Click">
                        <StackPanel>
                            <TextBlock Text="🖨" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F4 | Imprimir" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="Refresh_Click">
                        <StackPanel>
                            <TextBlock Text="↻" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F5 | Atualizar" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleActionButtonStyle}" Click="DeletePurchase_Click">
                        <StackPanel>
                            <TextBlock Text="✕" Style="{StaticResource ModuleActionIconStyle}"/>
                            <TextBlock Text="F8 | Excluir" Style="{StaticResource ModuleActionLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
