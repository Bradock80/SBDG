<Window x:Class="SGDB.Views.UpdateSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGDB — Atualização"
        Width="460" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True">
    <Border CornerRadius="14" BorderBrush="#D4A84B" BorderThickness="1.5"
            Background="White" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#0F2744"/>
        </Border.Effect>
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Width="72" Height="72" CornerRadius="36"
                    HorizontalAlignment="Center" Margin="0,4,0,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#254A75" Offset="0"/>
                        <GradientStop Color="#0F2744" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Image x:Name="LogoImage" Width="40" Height="40"
                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LogoFallback" Text="SGDB" Foreground="#F0DFA8"
                               FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Text="SGDB"
                       FontSize="22" FontWeight="Bold" Foreground="#0F2744"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Atualizando o sistema, aguarde..."
                       FontSize="14" Foreground="#475569" Margin="0,6,0,18"
                       HorizontalAlignment="Center" TextAlignment="Center"/>

            <Grid Grid.Row="3" Margin="8,0">
                <ProgressBar x:Name="ProgressBar"
                             Height="16" Minimum="0" Maximum="100" Value="0"
                             Background="#E2E8F0" BorderThickness="0"
                             Foreground="#254A75"/>
                <TextBlock x:Name="PercentText" Text="0%"
                           FontSize="11" FontWeight="SemiBold" Foreground="#0F2744"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="4"
                       Text="Preparando…"
                       FontSize="12" Foreground="#64748B" Margin="0,14,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" VerticalAlignment="Top"/>

            <TextBlock Grid.Row="5" Text="Banco de dados e configurações serão preservados."
                       FontSize="10" Foreground="#94A3B8" Margin="0,12,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </Grid>
    </Border>
</Window>
