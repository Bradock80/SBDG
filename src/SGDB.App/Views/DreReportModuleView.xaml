<UserControl x:Class="SGDB.Views.DreReportModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SGDB.Controls"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,5" Background="#F0F0F0"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="DRE Simplificado — Demonstrativo do Resultado"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="#1E293B" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Filtro fixo à esquerda + conteúdo à direita -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" MinWidth="200" MaxWidth="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Período: fixo, sem scroll -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0"
                        BorderThickness="0,0,1,0" Padding="12,10">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Top" Text="Período" FontWeight="SemiBold"
                                   FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock DockPanel.Dock="Top" Text="Data inicial" FontSize="11"
                                   Foreground="#64748B" Margin="0,0,0,3"/>
                        <controls:BrDateBox x:Name="DateFrom" DockPanel.Dock="Top" Margin="0,0,0,8"/>

                        <TextBlock DockPanel.Dock="Top" Text="Data final" FontSize="11"
                                   Foreground="#64748B" Margin="0,0,0,3"/>
                        <controls:BrDateBox x:Name="DateTo" DockPanel.Dock="Top" Margin="0,0,0,10"/>

                        <TextBlock DockPanel.Dock="Top" Text="Atalhos" FontSize="11"
                                   Foreground="#64748B" Margin="0,0,0,6"/>
                        <Button DockPanel.Dock="Top" Content="Este Mês"
                                Style="{StaticResource SgdbOutlineButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,5" Click="EsteMes_Click"/>
                        <Button DockPanel.Dock="Top" Content="Mês Anterior"
                                Style="{StaticResource SgdbOutlineButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,5" Click="MesAnterior_Click"/>
                        <Button DockPanel.Dock="Top" Content="Últimos 30 Dias"
                                Style="{StaticResource SgdbOutlineButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,12" Click="Ultimos30_Click"/>

                        <Button DockPanel.Dock="Top" Content="Pesquisar"
                                Style="{StaticResource SgdbPrimaryButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="Pesquisar_Click"/>
                        <Button DockPanel.Dock="Top" Content="Imprimir / PDF"
                                Style="{StaticResource SgdbOutlineButtonStyle}"
                                HorizontalAlignment="Stretch" Click="Print_Click"
                                ToolTip="Abre a impressão do Windows — escolha 'Microsoft Print to PDF' para salvar em PDF"/>

                        <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Foreground="#64748B"
                                   TextWrapping="Wrap" Margin="0,16,0,0"
                                   Text="* Despesas: Contas a Pagar por vencimento (sem mercadoria). Vendas PDV + Decks."/>
                    </DockPanel>
                </Border>

                <!-- Conteúdo: cards compactos + rolagem só se necessário -->
                <Grid Grid.Column="1" Margin="12,8,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PeriodoText" Grid.Row="0" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,8" Foreground="#1E293B"/>

                    <!-- Cards: grade adaptável com largura máxima, centralizada -->
                    <Grid Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                          MaxWidth="920">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="12,10" Background="#EEF2FF" CornerRadius="8"
                                BorderBrush="#C7D2FE" BorderThickness="1" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Receita Líquida" FontSize="11" Foreground="#4338CA"/>
                                <TextBlock x:Name="CardReceita" FontSize="20" FontWeight="Bold"
                                           Foreground="#1E3A5F" Margin="0,2,0,0" Text="R$ 0,00"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="12,10" Background="#FFF7ED" CornerRadius="8"
                                BorderBrush="#FED7AA" BorderThickness="1" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Total de Despesas" FontSize="11" Foreground="#C2410C"/>
                                <TextBlock x:Name="CardDespesas" FontSize="20" FontWeight="Bold"
                                           Foreground="#9A3412" Margin="0,2,0,0" Text="R$ 0,00"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CardLucroBorder" Grid.Column="4" Padding="12,10"
                                Background="#F0FDF4" CornerRadius="8"
                                BorderBrush="#BBF7D0" BorderThickness="1" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="CardLucroLabel" Text="Lucro Líquido" FontSize="11"
                                           Foreground="#166534"/>
                                <TextBlock x:Name="CardLucro" FontSize="20" FontWeight="Bold"
                                           Foreground="#14532D" Margin="0,2,0,0" Text="R$ 0,00"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cascata + despesas: scroll só quando a altura for insuficiente -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                            <TextBlock Text="Demonstrativo em cascata" FontWeight="SemiBold"
                                       FontSize="12.5" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                    Background="White" Margin="0,0,0,10">
                                <ItemsControl x:Name="CascadeList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="2,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                <Setter Property="Background" Value="#F8FAFC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Sign}"
                                                               FontWeight="SemiBold" FontSize="11"
                                                               Foreground="#64748B" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               VerticalAlignment="Center" FontSize="12.5"
                                                               TextWrapping="Wrap" Padding="2,5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSubNote}" Value="True">
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Setter Property="FontSize" Value="11.5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="pos">
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="neg">
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}"
                                                               VerticalAlignment="Center" FontSize="12.5"
                                                               HorizontalAlignment="Right" Padding="6,5,10,5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSubNote}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="pos">
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="neg">
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock Text="Despesas por categoria" FontWeight="SemiBold"
                                       FontSize="12.5" Margin="0,0,0,6"/>
                            <DataGrid x:Name="DespesasGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                      AlternatingRowBackground="#F8FAFC" BorderBrush="#E2E8F0"
                                      BorderThickness="1" RowHeaderWidth="0" Background="White"
                                      MinHeight="80" MaxHeight="220" RowHeight="28" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="*"/>
                                    <DataGridTextColumn Header="Valor" Binding="{Binding AmountDisplay}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="MetaText" Margin="0,8,0,0" FontSize="11.5"
                                       Foreground="#475569" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
