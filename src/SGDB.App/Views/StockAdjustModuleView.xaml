<UserControl x:Class="SGDB.Views.StockAdjustModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#D4D0C8"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#8B8B8B" BorderThickness="1" Background="#ECE9E4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="Ajusta Estoque" FontWeight="SemiBold" FontSize="13"
                               Foreground="#1E293B" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12,10,8,10">
                    <StackPanel>
                        <TextBlock Text="F6 | Localizar &lt;&lt;Referência | Cód. Barras | Descrição&gt;&gt;"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBox x:Name="SearchBox" Height="32" Padding="8,0" FontSize="13"
                                 VerticalContentAlignment="Center" CharacterCasing="Upper"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="HelpText" Margin="0,6,0,10" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="Localize o produto, escolha o tipo de ajuste e use Aplicar ou F9. Na entrada, informe o custo unitário para atualizar a média (Preço Custo)."/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Local" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox x:Name="LocationBox" Height="30"
                                          SelectionChanged="LocationBox_SelectionChanged">
                                    <ComboBoxItem Content="Depósito" Tag="warehouse" IsSelected="True"/>
                                    <ComboBoxItem Content="Geladeira" Tag="fridge"/>
                                </ComboBox>
                            </StackPanel>
                            <Border x:Name="FridgeHintBorder" Grid.Column="1" Padding="8,6"
                                    Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                    Visibility="Collapsed" VerticalAlignment="Stretch">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#9A3412" VerticalAlignment="Center"
                                           Text="Use este ajuste apenas para diferença física da geladeira. Para mover mercadoria entre Depósito e Geladeira, use Transferência."/>
                            </Border>
                        </Grid>

                        <Border x:Name="ProdutoPanel" Background="#FFFDF8" BorderBrush="#C5D4E8" BorderThickness="1"
                                Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                                    <TextBlock Text="Código" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="DCodigo" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                                    <TextBlock Text="Produto" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="DNome" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                               Text="—" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Grupo" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="DGrupo" FontSize="13" Foreground="#334155" Text="—"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,8">
                                    <TextBlock x:Name="DEstoqueLabel" Text="Est. atual" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="DEstoque" FontSize="14" FontWeight="Bold" Foreground="#166534" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                                    <TextBlock x:Name="DMinLabel" Text="Est. mín" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="DMin" FontSize="13" Foreground="#334155" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Un" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="DUn" FontSize="13" Foreground="#334155" Text="—"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Custo unit." FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="DCusto" FontSize="12" Foreground="#64748B" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="Valor do ajuste (estim.)" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="DValorAjuste" FontSize="12" Foreground="#475569" Text="—"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Formulário -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Tipo de ajuste" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <Border x:Name="ModeBorder" BorderThickness="2" BorderBrush="#94A3B8"
                                        Background="#F8FAFC" CornerRadius="3" Padding="1">
                                    <ComboBox x:Name="ModeBox" Height="28" BorderThickness="0"
                                              Background="Transparent"
                                              SelectionChanged="ModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Entrada (+)" Tag="entrada" IsSelected="True"/>
                                        <ComboBoxItem Content="Saída (−)" Tag="saida"/>
                                        <ComboBoxItem Content="Definir saldo" Tag="saldo"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock x:Name="QtyLabel" Text="Quantidade" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox x:Name="QtyBox" Height="30" Padding="8,0" FontSize="13"
                                         VerticalContentAlignment="Center"
                                         TextChanged="QtyBox_TextChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="UnitCostPanel" Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Custo unit. (média)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox x:Name="UnitCostBox" Height="30" Padding="8,0" FontSize="13"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Na entrada, informa o preço unitário desta compra. O Preço Custo do produto vira a média ponderada."
                                         TextChanged="UnitCostBox_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Motivo" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ReasonBox" Height="30">
                                    <ComboBoxItem Content="— (livre)" IsSelected="True"/>
                                    <ComboBoxItem Content="Inventário"/>
                                    <ComboBoxItem Content="Avaria"/>
                                    <ComboBoxItem Content="Perda / Roubo"/>
                                    <ComboBoxItem Content="Brinde"/>
                                    <ComboBoxItem Content="Devolução"/>
                                    <ComboBoxItem Content="Correção"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock x:Name="NotesLabel" Text="Observação (opcional)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox x:Name="NotesBox" Height="30" Padding="8,0" FontSize="13"
                                         VerticalContentAlignment="Center" MaxLength="200"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="PreviewText" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,2,0,10" Visibility="Collapsed"/>

                        <!-- Resultados -->
                        <Border BorderBrush="#C8C4BC" BorderThickness="1" Margin="0,0,0,10" MinHeight="160">
                            <DataGrid x:Name="ProductGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"
                                      Background="White" RowHeaderWidth="0" RowHeight="26" FontSize="12"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      MaxHeight="220"
                                      SelectionChanged="ProductGrid_SelectionChanged"
                                      MouseDoubleClick="ProductGrid_MouseDoubleClick">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#DDD8D0"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF8E6"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FDE68A"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="BorderBrush" Value="#D97706"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90"/>
                                    <DataGridTextColumn Header=">>Produto" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Grupo" Binding="{Binding GroupDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="Est. atual" Binding="{Binding StockDisplay}" Width="90"/>
                                    <DataGridTextColumn Header="Un" Binding="{Binding Unit}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Text="Últimos movimentos do produto" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1E293B" Margin="0,0,0,6"/>
                        <Border BorderBrush="#C8C4BC" BorderThickness="1" MinHeight="120">
                            <DataGrid x:Name="MovGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"
                                      Background="White" RowHeaderWidth="0" RowHeight="26" FontSize="12"
                                      CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="180">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#DDD8D0"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding CreatedDisplay}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TypeDisplay}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding QtyDisplay}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Observação" Binding="{Binding Notes}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0"
                                   Text="Digite referência, código de barras ou descrição"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Background="#E8E4DC" BorderBrush="#C8C4BC" BorderThickness="1,0,0,0" Padding="6,10">
                    <StackPanel>
                        <Button x:Name="ApplyBtn" Click="Apply_Click" IsEnabled="False"
                                Margin="0,0,0,8" Padding="4,10" Cursor="Hand"
                                Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✓" FontSize="18" HorizontalAlignment="Center" Foreground="#166534"/>
                                <TextBlock Text="Aplicar" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="F9" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="Clear_Click" Margin="0,0,0,8" Padding="4,10" Cursor="Hand"
                                Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="↺" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="Limpar" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="Close_Click" Padding="4,10" Cursor="Hand"
                                Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" Foreground="#991B1B"/>
                                <TextBlock Text="Sair" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Esc" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
