<UserControl x:Class="SGDB.Views.SellersModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECE9E4"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Aba estilo gestão -->
            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Vendedores" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Filtro -->
            <Border Grid.Row="1" Padding="12,10" Background="#FAF8F4"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="F12 | Localizar código ou nome" FontSize="11" FontWeight="SemiBold"
                               Foreground="#334155" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="30" Padding="8,0" FontSize="13"
                                 VerticalContentAlignment="Center" CharacterCasing="Upper"
                                 TextChanged="SearchBox_TextChanged"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <RadioButton x:Name="FilterAtivos" Content="Ativos" GroupName="selAtivo" IsChecked="True"
                                         Margin="0,0,10,0" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterInativos" Content="Inativos" GroupName="selAtivo"
                                         Margin="0,0,10,0" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterTodos" Content="Todos" GroupName="selAtivo" Checked="Filter_Changed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Form esquerda | Lista direita -->
            <Grid Grid.Row="2" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#C5D4E8" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,0,10,0" VerticalAlignment="Stretch">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="FormTitle" Text="Novo vendedor" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#0F172A"/>
                            <TextBlock x:Name="FormHint" Text="Cadastro novo — informe código e nome, depois clique em Gravar (F5)."
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Novo (F2)" Margin="0,0,6,0" Padding="12,6"
                                    Style="{StaticResource SgdbOutlineButtonStyle}" Click="New_Click"/>
                            <Button Content="Gravar (F5)" Margin="0,0,6,0" Padding="12,6"
                                    Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Save_Click"/>
                            <Button x:Name="DeleteBtn" Content="Excluir (Del)" Padding="12,6" Visibility="Collapsed"
                                    Style="{StaticResource SgdbOutlineButtonStyle}" Click="Delete_Click"
                                    Foreground="#C41E3A"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                                    <TextBlock Text="Código" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="CodeBox" Height="28" Margin="0,3,0,0" CharacterCasing="Upper"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <TextBlock Text="Nome" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="NameBox" Height="28" Margin="0,3,0,0" CharacterCasing="Upper"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,8">
                                    <TextBlock Text="Telefone" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="PhoneBox" Height="28" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,8">
                                    <TextBlock Text="CPF" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="CpfBox" Height="28" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,6,8">
                                    <TextBlock Text="Comissão (%)" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="CommBox" Height="28" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <TextBlock Text="Observação" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="NotesBox" Height="28" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ActiveBox" Grid.Row="5" Grid.ColumnSpan="2" Content="Ativo" IsChecked="True"/>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
                    <DataGrid x:Name="SellersGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"
                              Background="White" RowHeaderWidth="0" RowHeight="28" FontSize="12"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionChanged="SellersGrid_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#DDD8D0"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderBrush" Value="#C8C4BC"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF8E6"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="Comissão %" Binding="{Binding CommissionDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Ativo" Binding="{Binding ActiveDisplay}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
