<UserControl x:Class="SGDB.Views.LegacyMergeCleanupModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Resíduos de unificações antigas"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                        <TextBlock x:Name="DbPathText" FontSize="11" Foreground="#64748B" Margin="0,2,28,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12,8" Background="#FEF3C7" BorderBrush="#F59E0B"
                    BorderThickness="0,0,0,1">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#78350F" LineHeight="18"
                           Text="O saneamento NÃO transfere estoque novamente. Ele apenas zera o saldo residual do cadastro antigo."/>
            </Border>

            <Border Grid.Row="2" Padding="12,8" Background="#F8FAFC" BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock x:Name="NetworkBanner" Visibility="Collapsed" TextWrapping="Wrap"
                               FontSize="12" Foreground="#991B1B" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="BackupBtn" Content="Fazer backup agora"
                                Style="{StaticResource SgdbPrimaryButtonStyle}"
                                Height="32" Padding="12,6" Margin="0,0,10,6" Click="Backup_Click"/>
                        <Button x:Name="SanitizeBtn" Content="Sanear resíduos comprovados"
                                Style="{StaticResource SgdbOutlineButtonStyle}"
                                Height="32" Padding="12,6" Margin="0,0,10,6" IsEnabled="False"
                                Click="Sanitize_Click"/>
                        <Button Content="Atualizar (F5)" Style="{StaticResource SgdbOutlineButtonStyle}"
                                Height="32" Padding="12,6" Margin="0,0,10,6" Click="Refresh_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="BackupStatusText" FontSize="12" Foreground="#475569" Margin="0,4,0,0"
                               Text="Backup desta execução: nenhum ainda."/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="10,8,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="AutoGrid" Grid.Column="0" Margin="0,0,8,0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                          BorderBrush="#C8C4BC" BorderThickness="1" Background="White"
                          RowHeaderWidth="0" RowHeight="30" FontSize="12"
                          AlternatingRowBackground="#F8FAFC"
                          SelectionChanged="AutoGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produto antigo" Binding="{Binding AbsorbName}" Width="*"/>
                        <DataGridTextColumn Header="Produto principal" Binding="{Binding KeepName}" Width="*"/>
                        <DataGridTextColumn Header="Saldo residual" Binding="{Binding AbsorbStock, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Data da unificação" Binding="{Binding MergedAt}" Width="140"/>
                        <DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="110"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding UiStatus}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Column="1" BorderBrush="#C8C4BC" BorderThickness="1" Padding="10" Background="#FAFAF9">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12"
                                   Foreground="#1E293B" LineHeight="18"
                                   Text="Selecione um produto antigo para ver o detalhe."/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="4" Margin="10,8,10,0" Padding="10,8" Background="#FEF2F2"
                    BorderBrush="#FECACA" BorderThickness="1">
                <TextBlock x:Name="InventoryWarningText" TextWrapping="Wrap" FontSize="12"
                           Foreground="#7F1D1D" LineHeight="18"/>
            </Border>

            <TextBlock Grid.Row="5" Margin="12,8,12,4" FontWeight="SemiBold" FontSize="12"
                       Foreground="#334155" Text="Revisão manual (sem botão automático)"/>

            <DataGrid x:Name="ManualGrid" Grid.Row="6" Margin="10,0,10,8"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      BorderBrush="#C8C4BC" BorderThickness="1" Background="White"
                      RowHeaderWidth="0" RowHeight="30" FontSize="12"
                      AlternatingRowBackground="#F8FAFC"
                      SelectionChanged="ManualGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto antigo" Binding="{Binding AbsorbName}" Width="*"/>
                    <DataGridTextColumn Header="Produto principal" Binding="{Binding KeepName}" Width="*"/>
                    <DataGridTextColumn Header="Saldo residual" Binding="{Binding AbsorbStock, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding UiStatus}" Width="110"/>
                    <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="7" x:Name="SummaryText" Margin="12,0,12,10"
                       FontSize="12" Foreground="#475569"/>
        </Grid>
    </Border>
</UserControl>
