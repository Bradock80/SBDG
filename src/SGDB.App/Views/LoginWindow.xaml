<Window x:Class="SGDB.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrar — SGDB"
        Height="640" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SplashBackgroundBrush}">
    <Window.Resources>
        <!-- Olho aberto (mostrar senha) -->
        <Geometry x:Key="EyeOpenGeometry">
            M12,4.5 C7,4.5 2.73,7.61 1,12 C2.73,16.39 7,19.5 12,19.5 C17,19.5 21.27,16.39 23,12
            C21.27,7.61 17,4.5 12,4.5 Z M12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7
            C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 Z M12,9 C10.34,9 9,10.34 9,12
            C9,13.66 10.34,15 12,15 C13.66,15 15,13.66 15,12 C15,10.34 13.66,9 12,9 Z
        </Geometry>
        <!-- Olho cortado (ocultar senha) -->
        <Geometry x:Key="EyeOffGeometry">
            M12,7 C14.76,7 17,9.24 17,12 C17,12.65 16.87,13.26 16.64,13.82 L19.57,16.75
            C21.07,15.49 22.26,13.86 23,12 C21.27,7.61 17,4.5 12,4.5 C10.6,4.5 9.26,4.75 8,5.2
            L10.17,7.37 C10.74,7.13 11.35,7 12,7 Z M2,4.27 L4.28,6.55 L4.74,7.01
            C3.08,8.3 1.78,10.02 1,12 C2.73,16.39 7,19.5 12,19.5 C13.55,19.5 15.03,19.2 16.38,18.66
            L16.8,19.08 L19.73,22 L21,20.73 L3.27,3 L2,4.27 Z M12,17 C9.24,17 7,14.76 7,12
            C7,11.21 7.18,10.47 7.5,9.82 L9.08,11.4 C9.03,11.59 9,11.79 9,12 C9,13.66 10.34,15 12,15
            C12.21,15 12.41,14.97 12.6,14.92 L14.18,16.5 C13.53,16.82 12.79,17 12,17 Z
            M14.94,11.06 L16.47,12.59 C16.5,12.4 16.5,12.2 16.5,12 C16.5,9.79 14.71,8 12.5,8
            C12.3,8 12.1,8.02 11.91,8.05 L14.94,11.06 Z
        </Geometry>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAF8F4"/>
            <Setter Property="BorderBrush" Value="#C5CBD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D4A84B"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAF8F4"/>
            <Setter Property="BorderBrush" Value="#C5CBD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D4A84B"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginEnterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="#0F2744"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#D4A84B"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Shadow" BlurRadius="0" ShadowDepth="0"
                                                  Color="#000000" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8C15E"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="12" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                             Storyboard.TargetProperty="ShadowDepth"
                                                             To="3" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.28" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                             Storyboard.TargetProperty="ShadowDepth"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8892F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#8A9BB0"/>
                                <Setter Property="Foreground" Value="#E8EEF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="32,28" MaxWidth="380">

            <!-- Dourado mais claro para contraste, sem sair da identidade -->
            <TextBlock x:Name="DepositoLabel" Text="Meu Depósito"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="#FFE9B8"
                       HorizontalAlignment="Center" Margin="0,0,0,18"
                       TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Grid Width="68" Height="68" Margin="0,0,8,0">
                    <Ellipse Stroke="{StaticResource SgdbGoldBrush}" StrokeThickness="4"
                             Fill="{StaticResource LogoCircleBrush}"/>
                    <Ellipse Margin="10" Stroke="#73D4A84B" StrokeThickness="1.5"/>
                    <TextBlock Text="S" FontSize="32" FontWeight="Bold"
                               Foreground="#FFE9B8"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="GDB" FontSize="52" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Sistema de Gestão de Depósito de Bebidas"
                       FontSize="12.5" FontWeight="Normal"
                       Foreground="#F5E6B8"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="NetworkModeText"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="#D4A84B"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,20"
                       Visibility="Collapsed"/>

            <Border Padding="26,24" CornerRadius="10" Margin="0,4,0,0"
                    Background="#A60F2744"
                    BorderBrush="#4DD4A84B" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="#FECACA" Margin="0,0,0,12"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Background="#40B91C1C" Padding="10,8" FontSize="12"/>

                    <TextBlock Text="Usuário" Foreground="#F3F6FA"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource LoginTextBoxStyle}"
                             KeyDown="LoginBox_KeyDown"/>

                    <TextBlock Text="Dica: use o mesmo usuário da loja (ex.: hg ou hlbebidas)."
                               Foreground="#A8B4C4" FontSize="11"
                               TextWrapping="Wrap" Margin="2,6,0,0"/>

                    <TextBlock Text="Senha" Foreground="#F3F6FA"
                               FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6"/>
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource LoginPasswordBoxStyle}"
                                     Padding="14,0,44,0"
                                     KeyDown="PasswordBox_KeyDown"/>
                        <TextBox x:Name="PasswordVisibleBox" Style="{StaticResource LoginTextBoxStyle}"
                                 Padding="14,0,44,0" Visibility="Collapsed"
                                 KeyDown="PasswordVisibleBox_KeyDown"/>
                        <Button x:Name="TogglePasswordBtn"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0" Width="34" Height="34"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="Mostrar senha"
                                Click="TogglePassword_Click">
                            <Path x:Name="TogglePasswordIcon"
                                  Data="{StaticResource EyeOpenGeometry}"
                                  Fill="#6B7A8C" Stretch="Uniform"
                                  Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <CheckBox x:Name="RememberCheck" Content="Lembrar usuário e senha"
                              Foreground="#E8EEF5" FontSize="13" Margin="0,14,0,0"
                              Cursor="Hand"/>

                    <Button x:Name="EnterButton" Content="Entrar" Margin="0,16,0,0"
                            Style="{StaticResource LoginEnterButtonStyle}"
                            IsDefault="True"
                            Click="Enter_Click"/>

                    <Button x:Name="ConfigureNetworkBtn" Content="Configurar Rede Loja"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="#C5D0DE" FontSize="12" Padding="4,8,4,0"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="ConfigureNetwork_Click"/>

                    <StackPanel x:Name="LocalAccountLinks" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="ForgotPasswordBtn" Content="Esqueceu a senha?"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="#C5D0DE" FontSize="12" Padding="4,2"
                                Click="ForgotPassword_Click"/>
                        <TextBlock Text="·" Foreground="#6B7A8C" Margin="8,0" VerticalAlignment="Center"/>
                        <Button x:Name="RegisterBtn" Content="Criar conta"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="#C5D0DE" FontSize="12" Padding="4,2"
                                Click="Register_Click"
                                ToolTip="Cadastro com perfil Vendedor — precisa de aprovação do admin"/>
                        <TextBlock x:Name="FirstAccessSep" Text="·" Foreground="#6B7A8C" Margin="8,0"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="FirstAccessBtn" Content="Primeiro acesso"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="#C5D0DE" FontSize="12" Padding="4,2"
                                Visibility="Collapsed"
                                Click="FirstAccess_Click"
                                ToolTip="Abre a configuração inicial se ainda não houver usuários."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
