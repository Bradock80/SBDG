<Window x:Class="SGDB.Views.AuditLogDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes do evento"
        Width="620" SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel x:Name="ContentPanel"/>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Fechar (Esc)" HorizontalAlignment="Right" Margin="0,14,0,0"
                    Style="{StaticResource SgdbPrimaryButtonStyle}" Padding="16,8"
                    Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
