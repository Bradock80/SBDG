<UserControl x:Class="SGDB.Views.OpenTabsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SGDB.Models"
             Background="#ECE9E4"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="DeckViewToggleBtn" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A5F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LegendPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="MesaBlockTemplate" DataType="{x:Type models:DeckTableCard}">
            <Border Width="120" Height="120" Margin="4" Cursor="Hand"
                    CornerRadius="8" SnapsToDevicePixels="True"
                    ToolTip="{Binding ToolTipText}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#5C5C5C"/>
                        <Setter Property="Effect" Value="{x:Null}"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="0"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                <Setter Property="Background" Value="#2E7D32"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPreConta}" Value="True">
                                <Setter Property="Background" Value="#C4A035"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBalcao}" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBalcao}" Value="True"/>
                                    <Condition Binding="{Binding IsPreConta}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#C4A035"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4"
                                                          Direction="270" Opacity="0.38"
                                                          Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="8,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="🔒" FontSize="11" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreConta}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="🪑" FontSize="14" HorizontalAlignment="Center"
                                   Foreground="#FFFFFF" Opacity="0.95"/>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="ABRIR" FontSize="10" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,0,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFree}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="BALCÃO" FontSize="9" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Opacity="0.9" Margin="0,0,0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBalcao}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding NumberDisplay}" FontSize="28" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="104"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="{Binding ClientNameDisplay}" FontSize="11"
                               Foreground="#F8FAFC" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="104"
                               Opacity="0.95">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFree}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Text="{Binding FooterLine}" FontSize="10"
                               FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="104" Margin="0,2,0,0" Opacity="0.92">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFree}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Decks — Contas abertas" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12,10" Background="#FAF8F4"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="#475569"
                               Text="Lança o consumo sem pagar. Cada pessoa/grupo = um deck. No fim, fecha e cobra."
                               TextWrapping="Wrap" MaxWidth="360"/>
                    <Button DockPanel.Dock="Right" Content="Atualizar (F1)" Padding="12,6" Margin="8,0,0,0"
                            Style="{StaticResource SgdbOutlineButtonStyle}" Click="Refresh_Click"/>
                    <Button DockPanel.Dock="Right" Content="Celular…" Padding="12,6" Margin="8,0,0,0"
                            Style="{StaticResource SgdbOutlineButtonStyle}" Click="Companion_Click"
                            ToolTip="Ligar página no celular (mesma Wi-Fi) para abrir decks e lançar produtos"/>
                    <Button DockPanel.Dock="Right" Content="Juntar (F4)" Padding="12,6" Margin="8,0,0,0"
                            Style="{StaticResource SgdbOutlineButtonStyle}" Click="Merge_Click"
                            ToolTip="Selecione 2 ou mais decks (Ctrl+clique) e una numa conta só"/>
                    <Button DockPanel.Dock="Right" Content="Pré-conta (F9)" Padding="12,6" Margin="8,0,0,0"
                            Style="{StaticResource SgdbOutlineButtonStyle}" Click="PreConta_Click"
                            ToolTip="Imprime conferência do deck selecionado"/>
                    <Button DockPanel.Dock="Right" Content="Abrir deck (Enter)" Padding="12,6" Margin="8,0,0,0"
                            Style="{StaticResource SgdbOutlineButtonStyle}" Click="Open_Click"/>
                    <Button DockPanel.Dock="Right" Content="Novo deck (F2)" Padding="12,6"
                            Style="{StaticResource SgdbPrimaryButtonStyle}" Click="New_Click"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Padding="12,8" Background="White"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Buscar" VerticalAlignment="Center"
                               FontSize="12" Foreground="#64748B" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="30" FontSize="13"
                             VerticalContentAlignment="Center" Padding="8,0"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Digite o nº da mesa/comanda ou nome do cliente"/>
                    <StackPanel x:Name="LegendPanel" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                        <Border Style="{StaticResource LegendPill}" Background="#DCFCE7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#2E7D32" Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Em andamento" FontSize="11" Foreground="#14532D"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LegendPill}" Background="#FEF3C7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#C4A035" Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Pré-conta" FontSize="11" Foreground="#854D0E"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LegendPill}" Background="#E5E7EB">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#5C5C5C" Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Livre" FontSize="11" Foreground="#374151"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <ToggleButton x:Name="ViewListBtn" Content="Lista" Style="{StaticResource DeckViewToggleBtn}"
                                      Margin="0,0,4,0" Click="ViewList_Click"
                                      ToolTip="Visão em lista (tabela)"/>
                        <ToggleButton x:Name="ViewGridBtn" Content="Mesas" Style="{StaticResource DeckViewToggleBtn}"
                                      Click="ViewGrid_Click"
                                      ToolTip="Visão em grid de mesas/comandas"/>
                    </StackPanel>
                    <StackPanel x:Name="TableCountPanel" Grid.Column="4" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="Qtd. mesas" FontSize="11" Foreground="#64748B"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="TableCountBox" Width="64" Height="28"
                                  SelectionChanged="TableCountBox_SelectionChanged">
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="24" IsSelected="True"/>
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="40"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="10" BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
                <Grid>
                    <DataGrid x:Name="TabsGrid"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"
                              Background="White" RowHeaderWidth="0" RowHeight="32" FontSize="13"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              MouseDoubleClick="TabsGrid_MouseDoubleClick"
                              CellEditEnding="TabsGrid_CellEditEnding">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Background" Value="#EEF2F7"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Itens" Binding="{Binding ItemsCount}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tempo" Binding="{Binding ElapsedDisplay}" Width="90" IsReadOnly="True"
                                                ToolTipService.ToolTip="Tempo desde a abertura"/>
                            <DataGridTextColumn Header="Aberto em" Binding="{Binding CreatedAtBr}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerDisplay}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Obs / Mesa" Binding="{Binding NotesDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="140" IsReadOnly="False"
                                                ToolTipService.ToolTip="Clique duas vezes para editar (ex.: Mesa 3)"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer x:Name="CardsScroller" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="14,12"
                                  Background="#F5F5F5">
                        <StackPanel>
                            <DockPanel Margin="2,0,0,8" LastChildFill="False">
                                <TextBlock x:Name="MapHeaderText" DockPanel.Dock="Left"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"
                                           Text="Mapa de mesas" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MapStatsText" DockPanel.Dock="Right"
                                           FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl x:Name="MapCardsHost"
                                          ItemTemplate="{StaticResource MesaBlockTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <EventSetter Event="MouseLeftButtonUp" Handler="DeckCard_Click"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <StackPanel x:Name="BalcaoSection" Visibility="Collapsed">
                                <TextBlock x:Name="BalcaoHeaderText" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1E293B" Margin="2,18,0,8"
                                           Text="Balcão / Avulso (0)"/>
                                <ItemsControl x:Name="BalcaoCardsHost"
                                              ItemTemplate="{StaticResource MesaBlockTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <EventSetter Event="MouseLeftButtonUp" Handler="DeckCard_Click"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="12,10" Background="#F1F5F9" BorderBrush="#C8C4BC" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryCountText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#0F172A" Margin="0,0,16,0"/>
                        <TextBlock x:Name="SummaryTotalText" FontSize="14" FontWeight="Bold"
                                   Foreground="#1E3A5F"/>
                    </StackPanel>
                    <TextBlock x:Name="MetaText" FontSize="12" Foreground="#475569"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
