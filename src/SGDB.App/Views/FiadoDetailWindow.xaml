<Window x:Class="SGDB.Views.FiadoDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vendas do cliente"
        Width="820" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DetailCellLeft" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,6,0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="DetailCellRight" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,10,0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="DetailHeaderLeft" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="DetailHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DetailHeaderLeft}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,7,10,7"/>
        </Style>
        <Style x:Key="CleanGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>
        <Style x:Key="ActionPrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#2563EB" CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionSecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#CBD5E1"
                                BorderThickness="1" CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionCloseBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#F1F5F9" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
            CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header card -->
            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cliente" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="ClienteNomeText" FontSize="20" FontWeight="Bold"
                                   Foreground="#0F172A" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ClientePhoneText" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                            <TextBlock Text="Vendido fiado" FontSize="11" Foreground="#64748B"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="VendidoText" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                            <TextBlock Text="Recebido" FontSize="11" Foreground="#64748B"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="RecebidoText" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="Saldo Devedor" FontSize="11" Foreground="#64748B"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="SaldoText" FontSize="16" FontWeight="Bold"
                                       Foreground="#B91C1C" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="DetailScroll_PreviewMouseWheel">
                <StackPanel>
                    <TextBlock Text="Vendas fiado" FontWeight="SemiBold" FontSize="13"
                               Foreground="#0F172A" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="SalesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="16,14" Background="White"
                                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                   FontSize="13" Foreground="#0F172A" Margin="0,0,0,10"/>
                                        <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource CleanGrid}"
                                                  BorderBrush="#E2E8F0" BorderThickness="1">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DetailHeaderLeft}"/>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Cód." Binding="{Binding ProductCode}" Width="70"
                                                                    ElementStyle="{StaticResource DetailCellLeft}"
                                                                    HeaderStyle="{StaticResource DetailHeaderLeft}"/>
                                                <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*"
                                                                    ElementStyle="{StaticResource DetailCellLeft}"
                                                                    HeaderStyle="{StaticResource DetailHeaderLeft}"/>
                                                <DataGridTextColumn Header="Qtd" Binding="{Binding QuantityDisplay}" Width="80"
                                                                    ElementStyle="{StaticResource DetailCellRight}"
                                                                    HeaderStyle="{StaticResource DetailHeaderRight}"/>
                                                <DataGridTextColumn Header="Unit." Binding="{Binding UnitPriceDisplay}" Width="90"
                                                                    ElementStyle="{StaticResource DetailCellRight}"
                                                                    HeaderStyle="{StaticResource DetailHeaderRight}"/>
                                                <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalDisplay}" Width="100"
                                                                    ElementStyle="{StaticResource DetailCellRight}"
                                                                    HeaderStyle="{StaticResource DetailHeaderRight}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SalesEmptyText" Text="Nenhuma venda fiado para este cliente."
                               FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"
                               Margin="0,8,0,16" Visibility="Collapsed"/>

                    <TextBlock Text="Recebimentos" FontWeight="SemiBold" FontSize="13"
                               Foreground="#0F172A" Margin="0,8,0,10"/>
                    <Border Background="#FAFBFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" MinHeight="96" Padding="4">
                        <Grid>
                            <DataGrid x:Name="PaymentsGrid" Style="{StaticResource CleanGrid}"
                                      SelectionMode="Single" Visibility="Collapsed">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E8F0"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding DateBr}" Width="90"
                                                        ElementStyle="{StaticResource DetailCellLeft}"
                                                        HeaderStyle="{StaticResource DetailHeaderLeft}"/>
                                    <DataGridTextColumn Header="Forma" Binding="{Binding PaymentType}" Width="140"
                                                        ElementStyle="{StaticResource DetailCellLeft}"
                                                        HeaderStyle="{StaticResource DetailHeaderLeft}"/>
                                    <DataGridTextColumn Header="Abate fiado" Binding="{Binding PrincipalDisplay}" Width="100"
                                                        ElementStyle="{StaticResource DetailCellRight}"
                                                        HeaderStyle="{StaticResource DetailHeaderRight}"/>
                                    <DataGridTextColumn Header="Juros" Binding="{Binding InterestDisplay}" Width="80"
                                                        ElementStyle="{StaticResource DetailCellRight}"
                                                        HeaderStyle="{StaticResource DetailHeaderRight}"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding AmountDisplay}" Width="90"
                                                        ElementStyle="{StaticResource DetailCellRight}"
                                                        HeaderStyle="{StaticResource DetailHeaderRight}"/>
                                    <DataGridTextColumn Header="Obs." Binding="{Binding Notes}" Width="*"
                                                        ElementStyle="{StaticResource DetailCellLeft}"
                                                        HeaderStyle="{StaticResource DetailHeaderLeft}"/>
                                    <DataGridTextColumn Header="St." Binding="{Binding StatusDisplay}" Width="90"
                                                        ElementStyle="{StaticResource DetailCellLeft}"
                                                        HeaderStyle="{StaticResource DetailHeaderLeft}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PaymentsEmptyText"
                                       Text="Nenhum pagamento registrado para este cliente ainda."
                                       FontSize="13" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="16"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="F8 | Estornar recebimento" Style="{StaticResource ActionSecondaryBtn}"
                            Margin="0,0,10,0" Click="Estornar_Click" ToolTip="F8"/>
                    <Button x:Name="BtnReceber" Content="F7 | Receber / baixar" Style="{StaticResource ActionPrimaryBtn}"
                            Click="Receber_Click" ToolTip="F7"/>
                </StackPanel>
                <Button Content="Esc | Fechar" Style="{StaticResource ActionCloseBtn}"
                        HorizontalAlignment="Right" IsCancel="True" Click="Fechar_Click" ToolTip="Esc"/>
            </Grid>
        </Grid>
    </Border>
</Window>
