<Window x:Class="SGDB.Views.InventoryComboApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aprovar combo"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Tahoma">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="PdvWarningText" FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="BtnConfirm" Content="Confirmar aprovação"
                            Style="{StaticResource SgdbPrimaryButtonStyle}" Padding="14,6"
                            Click="Confirm_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                <TextBlock Text="Nome comercial" FontSize="11" Foreground="#64748B" Margin="0,12,0,4"/>
                <TextBox x:Name="NameBox" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Preço do combo" FontSize="11" Foreground="#64748B" Margin="0,10,0,4"/>
                <TextBox x:Name="PriceBox" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Quantidade máxima" FontSize="11" Foreground="#64748B" Margin="0,10,0,4"/>
                <TextBox x:Name="MaxQtyBox" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Data inicial (dd/MM/aaaa)" FontSize="11" Foreground="#64748B" Margin="0,10,0,4"/>
                <TextBox x:Name="StartBox" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Data final (dd/MM/aaaa)" FontSize="11" Foreground="#64748B" Margin="0,10,0,4"/>
                <TextBox x:Name="EndBox" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="BlockText" FontSize="12" FontWeight="SemiBold" Foreground="#991B1B"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
