<Window x:Class="SGDB.Views.ProductLotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lotes e validades"
        Width="920" Height="520"
        MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SgdbBgBrush}"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Padding="10,8" Margin="0,0,0,8" Background="#F8FAFC"
                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Próxima validade" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="NextExpiryText" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock x:Name="DaysHintText" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Estoque total (depósito + geladeira)" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="StockText" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                               Text="Local por lote ainda não é controlado."/>
                </StackPanel>
                <Button Grid.Column="2" Content="Atualizar" VerticalAlignment="Center"
                        Style="{StaticResource SgdbOutlineButtonStyle}" Padding="12,6"
                        Click="Refresh_Click" ToolTip="Recarrega os lotes atuais (F5)"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid x:Name="Grid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0" BorderThickness="1"
                      Background="White" RowHeaderWidth="0" RowHeight="32" FontSize="12.5"
                      AlternatingRowBackground="#F8FAFC"
                      EnableRowVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lote" Binding="{Binding LotDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding QtyDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Validade" Binding="{Binding ExpiryDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Dias" Binding="{Binding DaysDisplay}" Width="60"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Custo do lote" Binding="{Binding CostDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Origem" Binding="{Binding OriginDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Histórico" Binding="{Binding HistoryDisplay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText"
                       Text="Este produto não possui lotes ativos com estoque."
                       Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                       Margin="24" TextAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Fechar (Esc)" Style="{StaticResource SgdbPrimaryButtonStyle}"
                    Padding="16,8" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
