<Window x:Class="SGDB.Views.PdvResumoDiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumo do dia"
        Width="1280" Height="900" MinWidth="1040" MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#ECE9E4"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGDB;component/Themes/PdvTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ResumoHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource SgdbBlueBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2F4F73"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="ResumoCell" TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#DCE9F7"/>
                        <Setter Property="Foreground" Value="#0F2744"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResumoRow" TargetType="DataGridRow">
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#F7F9FC"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EEF4FB"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResumoGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF3"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#DDE4EC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource ResumoHeader}"/>
                <Setter Property="CellStyle" Value="{StaticResource ResumoCell}"/>
                <Setter Property="RowStyle" Value="{StaticResource ResumoRow}"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <Style x:Key="KpiCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#DDE4EC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
            </Style>
            <Style x:Key="KpiIcon" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="KpiLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#7A8899"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="KpiValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
            <Style x:Key="KpiHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource SgdbBlueBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="ResumoNumberCell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#F4F6F9" BorderBrush="#B9C2CD" BorderThickness="1" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PdvTitleBar}">
                <Grid>
                    <TextBlock x:Name="TitleText" Style="{StaticResource PdvPayTitleText}"/>
                    <Button Content="×" Style="{StaticResource PdvCloseButton}"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="18,14" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="CaixaBadge" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                            Background="#EAF4EC" BorderBrush="#BFDCC6" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CaixaIcon" Text="🟢" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CaixaInfoText" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="18,0,0,0">
                                    <TextBlock Text="SALDO INICIAL" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock x:Name="CaixaInicialText" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#334155"/>
                                </StackPanel>
                                <StackPanel Margin="18,0,0,0">
                                    <TextBlock Text="ENTRADAS" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock x:Name="CaixaEntradasText" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#15803D"/>
                                </StackPanel>
                                <StackPanel Margin="18,0,0,0">
                                    <TextBlock Text="SAÍDAS / SANGRIAS" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock x:Name="CaixaSaidasText" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#B91C1C"/>
                                </StackPanel>
                                <Border Background="{StaticResource SgdbBlueBrush}" CornerRadius="6"
                                        Padding="12,6" Margin="18,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SALDO GAVETA" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#C9D6E5"/>
                                        <TextBlock x:Name="CaixaGavetaText" FontSize="16" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3" Rows="2">
                        <Border Style="{StaticResource KpiCard}" Background="#F3F7FC" BorderBrush="#BBD0E6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" Style="{StaticResource KpiIcon}"/>
                                    <TextBlock Text="FATURAMENTO" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="KpiFaturamentoText" Style="{StaticResource KpiValue}"
                                           Foreground="{StaticResource SgdbBlueBrush}"/>
                                <TextBlock x:Name="KpiFaturamentoHint" Style="{StaticResource KpiHint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Background="#F0F9F2" BorderBrush="#BFDCC6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" Style="{StaticResource KpiIcon}"/>
                                    <TextBlock Text="LUCRO REAL" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="KpiLucroText" Style="{StaticResource KpiValue}"
                                           Foreground="#15803D"/>
                                <TextBlock Text="vendas − custo dos produtos" Style="{StaticResource KpiHint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" Style="{StaticResource KpiIcon}"/>
                                    <TextBlock Text="MARGEM" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="KpiMargemText" Style="{StaticResource KpiValue}"
                                           Foreground="{StaticResource SgdbGoldBrush}"/>
                                <TextBlock Text="lucro sobre faturamento" Style="{StaticResource KpiHint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧾" Style="{StaticResource KpiIcon}"/>
                                    <TextBlock Text="VENDAS" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="KpiVendasText" Style="{StaticResource KpiValue}"/>
                                <TextBlock x:Name="KpiCanceladasHint" Style="{StaticResource KpiHint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛒" Style="{StaticResource KpiIcon}"/>
                                    <TextBlock Text="TICKET MÉDIO" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="KpiTicketText" Style="{StaticResource KpiValue}"/>
                                <TextBlock Text="por venda" Style="{StaticResource KpiHint}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="FiadoCard" Style="{StaticResource KpiCard}" Margin="0"
                                Background="#FDF6E7" BorderBrush="#E6D3A3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📒" Style="{StaticResource KpiIcon}"/>
                                    <TextBlock Text="FIADO / A PRAZO" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="KpiFiadoText" Style="{StaticResource KpiValue}"
                                           Foreground="#A16207"/>
                                <TextBlock x:Name="KpiFiadoHint" Style="{StaticResource KpiHint}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vendas por categoria" Style="{StaticResource SectionTitle}"/>
                            <DataGrid x:Name="GruposGrid" Style="{StaticResource ResumoGrid}"
                                      MinHeight="180" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding GroupName}" Width="220"/>
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding QtyDisplay}" Width="64"
                                                        ElementStyle="{StaticResource ResumoNumberCell}"/>
                                    <DataGridTextColumn Header="Total R$" Binding="{Binding TotalDisplay}" Width="96"
                                                        ElementStyle="{StaticResource ResumoNumberCell}"/>
                                    <DataGridTextColumn Header="Lucro R$" Binding="{Binding LucroDisplay}" Width="96"
                                                        ElementStyle="{StaticResource ResumoNumberCell}"/>
                                    <DataGridTextColumn Header="Margem" Binding="{Binding MargemDisplay}" Width="82"
                                                        ElementStyle="{StaticResource ResumoNumberCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Formas de pagamento" Style="{StaticResource SectionTitle}"/>
                            <DataGrid x:Name="FormasGrid" Style="{StaticResource ResumoGrid}"
                                      Height="160" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Forma" Binding="{Binding Forma}" Width="200"/>
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding Count}" Width="56"
                                                        ElementStyle="{StaticResource ResumoNumberCell}"/>
                                    <DataGridTextColumn Header="Total R$" Binding="{Binding TotalDisplay}" Width="100"
                                                        ElementStyle="{StaticResource ResumoNumberCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Top produtos" Style="{StaticResource SectionTitle}"/>
                            <DataGrid x:Name="TopGrid" Style="{StaticResource ResumoGrid}"
                                      Height="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="250"/>
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding QtyDisplay}" Width="56"
                                                        ElementStyle="{StaticResource ResumoNumberCell}"/>
                                    <DataGridTextColumn Header="Total R$" Binding="{Binding TotalDisplay}" Width="100"
                                                        ElementStyle="{StaticResource ResumoNumberCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="MetaText" FontSize="11.5" Foreground="#8A97A6" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" BorderBrush="#DDE4EC" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <TextBlock x:Name="FooterHintText" FontSize="11.5" Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Consultar vendas (F9)" Style="{StaticResource SgdbOutlineButtonStyle}"
                                MinWidth="170" Margin="0,0,8,0" Click="ConsultarVendas_Click"/>
                        <Button Content="Voltar (Esc)" Style="{StaticResource SgdbOutlineButtonStyle}"
                                MinWidth="120" IsCancel="True" Click="Close_Click"/>
                        <Button Content="Atualizar (F1)" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                MinWidth="140" Margin="0" IsDefault="True" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
