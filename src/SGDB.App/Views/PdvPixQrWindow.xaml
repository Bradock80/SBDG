<Window x:Class="SGDB.Views.PdvPixQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIX — QR Code"
        Width="480" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PIX" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="ValorText" Grid.Row="1" Margin="0,6,0,12"
                   FontSize="28" FontWeight="SemiBold" Foreground="#FBBF24"
                   HorizontalAlignment="Center" Text="R$ 0,00"/>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="300" Height="300">
            <Grid>
                <Image x:Name="QrImage" Stretch="Uniform"/>
                <TextBlock x:Name="QrPlaceholder" Text="Gerando QR…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" FontSize="14"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Aguardando pagamento…"
                       Foreground="#E2E8F0" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="HintText" Margin="0,6,0,0"
                       Text="Peça ao cliente para abrir o app do banco e ler o QR Code."
                       Foreground="#94A3B8" FontSize="12"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <TextBox x:Name="CopiaColaBox" Grid.Row="4" Margin="0,12,0,0" Height="54"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#334155"
                 FontSize="11" Padding="8"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="Copiar código" Padding="14,8" Margin="0,0,8,0"
                    Click="Copy_Click"/>
            <Button x:Name="BtnManual" Content="Já recebi (manual)" Padding="14,8" Margin="0,0,8,0"
                    Click="Manual_Click" ToolTip="Use só se o PIX já caiu e a consulta não atualizou"/>
            <Button Content="Cancelar (Esc)" Padding="14,8" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
