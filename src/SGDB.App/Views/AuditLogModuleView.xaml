<UserControl x:Class="SGDB.Views.AuditLogModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SGDB.Controls"
             Background="#ECE9E4" Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="AuditBadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="danger">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="warning">
                    <Setter Property="Background" Value="#FFEDD5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="info">
                    <Setter Property="Background" Value="#E0F2FE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="success">
                    <Setter Property="Background" Value="#DCFCE7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="secondary">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AuditBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="danger">
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="warning">
                    <Setter Property="Foreground" Value="#9A3412"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="info">
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="success">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="secondary">
                    <Setter Property="Foreground" Value="#475569"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AuditDetailsText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="10,6" Background="#F0F0F0" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Log de Operações (Auditoria)" FontWeight="SemiBold" FontSize="13"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12,10" Background="#FAF8F4" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="De" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <controls:BrDateBox x:Name="DateFromBox" Width="118" Margin="0,0,8,0"/>
                        <TextBlock Text="até" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <controls:BrDateBox x:Name="DateToBox" Width="118" Margin="0,0,12,0"/>
                        <TextBlock Text="Usuário:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="UserFilterBox" Width="160" Height="32" Margin="0,0,12,0"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Login"/>
                        <TextBlock Text="Ação:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ActionFilterBox" Width="210" Height="32"
                                  DisplayMemberPath="Label" SelectedValuePath="Key"/>
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,8,0">
                            <TextBox x:Name="SearchBox" Height="32" Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Buscar por palavra-chave…"
                                       IsHitTestVisible="False" Foreground="#94A3B8" FontSize="12"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <Button Grid.Column="1" Content="🔍 Buscar" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                Padding="14,0" Height="32" Margin="0,0,8,0" Click="Buscar_Click"/>
                        <Button Grid.Column="2" Content="📥 Exportar CSV" Style="{StaticResource SgdbOutlineButtonStyle}"
                                Padding="14,0" Height="32" Click="ExportCsv_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <DataGrid x:Name="LogGrid" Grid.Row="2" Margin="12,10,12,8"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" CanUserAddRows="False" RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      AlternatingRowBackground="#F8FAFC" MinRowHeight="36" FontSize="12"
                      BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Stretch"
                      MouseDoubleClick="LogGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data/Hora" Binding="{Binding DateDisplay}" Width="140" CanUserResize="False"/>
                    <DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="125" CanUserResize="False"/>
                    <DataGridTemplateColumn Header="Ação" Width="155" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AuditBadgeBorder}">
                                    <TextBlock Text="{Binding ActionBadgeDisplay}" Style="{StaticResource AuditBadgeText}"
                                               FontFamily="Consolas, Courier New"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Entidade" Binding="{Binding EntityDisplay}" Width="90" CanUserResize="False"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="55" CanUserResize="False"/>
                    <DataGridTemplateColumn Header="Detalhes" Width="*" MinWidth="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DetailsDisplay}" Style="{StaticResource AuditDetailsText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Padding="12,8" Background="#F5F3EE" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="PageInfoText" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PrevPageBtn" Content="&lt; Anterior" Style="{StaticResource SgdbOutlineButtonStyle}"
                                Padding="12,6" Margin="0,0,8,0" Click="PrevPage_Click"/>
                        <Button x:Name="NextPageBtn" Content="Próxima &gt;" Style="{StaticResource SgdbOutlineButtonStyle}"
                                Padding="12,6" Click="NextPage_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
