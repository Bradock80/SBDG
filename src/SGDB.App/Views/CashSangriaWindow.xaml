<Window x:Class="SGDB.Views.CashSangriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Tahoma, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/CashModalTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource GestaoModalShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource GestaoModalTitleBar}">
                <TextBlock Text="Sangria — retirada de caixa" Style="{StaticResource GestaoModalTitleText}"/>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource GestaoModalBody}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GestaoModalHintSmall}">
                        <Run Text="Informe o valor que saiu da gaveta e o "/>
                        <Run Text="motivo" FontWeight="Bold"/>
                        <Run Text=". O motivo aparece na coluna "/>
                        <Run Text="Descrição" FontWeight="Bold"/>
                        <Run Text=" do caixa (ex.: compra avulsa de mercadoria)."/>
                    </TextBlock>

                    <StackPanel Style="{StaticResource GestaoCompraF}">
                        <TextBlock Text="Valor retirado" Style="{StaticResource GestaoFieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource GestaoMoedaPrefix}">
                                <TextBlock Text="R$" Style="{StaticResource GestaoMoedaPrefixText}"/>
                            </Border>
                            <TextBox x:Name="ValorBox" Grid.Column="1" Style="{StaticResource GestaoMoedaInput}"
                                     Text="0,00" BorderThickness="1"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Style="{StaticResource GestaoCompraF}">
                        <TextBlock Text="Motivo da retirada" Style="{StaticResource GestaoFieldLabel}"/>
                        <TextBox x:Name="MotivoBox" Style="{StaticResource GestaoFieldInput}" MaxLength="200"
                                 ToolTip="Ex.: Compra avulsa — cerveja 50 un — fornecedor João"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource GestaoModalActions}">
                        <Button Content="Confirmar" Style="{StaticResource GestaoModalBtnPrimary}" Margin="0,0,8,0"
                                IsDefault="True" Click="Confirm_Click"/>
                        <Button Content="Cancelar" Style="{StaticResource GestaoModalBtn}" IsCancel="True"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
