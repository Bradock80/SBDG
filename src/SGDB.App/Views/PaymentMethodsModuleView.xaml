<UserControl x:Class="SGDB.Views.PaymentMethodsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECE9E4"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0"
                    BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Formas de Pagamento" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Margin="12,10,12,6" FontSize="12" Foreground="#475569" TextWrapping="Wrap">
                <Run Text="Crie formas customizadas (VR, Link, Carteira), ative/inative as que não usa, configure "/><Run Text="taxa" FontWeight="SemiBold"/>
                <Run Text=", "/><Run Text="prazo" FontWeight="SemiBold"/>
                <Run Text=", "/><Run Text="conta de destino" FontWeight="SemiBold"/>
                <Run Text=" e a "/><Run Text="tecla do PDV" FontWeight="SemiBold"/><Run Text="."/>
            </TextBlock>

            <Grid Grid.Row="2" Margin="10,4,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" MinWidth="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Lista -->
                <Border Grid.Column="0" BorderBrush="#C8C4BC" BorderThickness="1" Background="White" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="8,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Button Content="+ Nova Forma de Pagamento"
                                    Style="{StaticResource SgdbPrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="10,8"
                                    Click="New_Click"/>
                        </Border>

                        <DataGrid x:Name="MethodsGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"
                                  Background="White" RowHeaderWidth="0" RowHeight="30" FontSize="12"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionChanged="MethodsGrid_SelectionChanged">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#DDD8D0"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF8E6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Forma" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Tecla" Binding="{Binding PdvKeyDisplay}" Width="48"/>
                                <DataGridTextColumn Header="Taxa" Binding="{Binding FeeDisplay}" Width="88"/>
                                <DataGridTextColumn Header="D+" Binding="{Binding SettlementDisplay}" Width="36"/>
                                <DataGridTemplateColumn Header="Ativo" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Active, Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="ActiveToggle_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Padding="8,6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="↑ Subir" Padding="10,5" Margin="0,0,6,0"
                                        Style="{StaticResource SgdbOutlineButtonStyle}" Click="MoveUp_Click"/>
                                <Button Content="↓ Descer" Padding="10,5"
                                        Style="{StaticResource SgdbOutlineButtonStyle}" Click="MoveDown_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Detalhes -->
                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#C5D4E8" BorderThickness="1"
                        CornerRadius="4" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="FormTitle" Text="Detalhes" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#0F172A" Margin="0,0,0,12"/>
                            <TextBlock x:Name="EmptyHint" Text="Selecione uma forma na lista ou clique em + Nova."
                                       FontSize="12" Foreground="#94A3B8"/>

                            <Grid x:Name="DetailPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Nome" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,8"
                                         Padding="8,0" VerticalContentAlignment="Center" FontSize="13"
                                         CharacterCasing="Upper"/>

                                <TextBlock Grid.Row="1" Text="Rótulo no sistema" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBox x:Name="ApiBox" Height="30" Padding="8,0"
                                             VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Nome exibido em vendas, caixa e relatórios."
                                               FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="Tipo movimento" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <ComboBox x:Name="MovBox" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,8"
                                          Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Entrada" IsSelected="True"/>
                                    <ComboBoxItem Content="A receber"/>
                                </ComboBox>

                                <TextBlock Grid.Row="3" Text="Tecla PDV" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBox x:Name="PdvKeyBox" Width="60" Height="30" Padding="8,0"
                                             HorizontalAlignment="Left" MaxLength="1"
                                             CharacterCasing="Upper"
                                             VerticalContentAlignment="Center" FontSize="13"
                                             PreviewTextInput="PdvKeyBox_PreviewTextInput"/>
                                    <TextBlock Text="Letra A–Z. Vazia = sem atalho no PDV."
                                               FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Text="Observação" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Top" Margin="0,4,0,8"/>
                                <TextBox x:Name="NotesBox" Grid.Row="4" Grid.Column="1" MinHeight="52" Margin="0,0,0,8"
                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6" FontSize="12"/>

                                <TextBlock Grid.Row="5" Text="Taxa (%)" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBox x:Name="FeeBox" Width="100" Height="30" Padding="8,0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock x:Name="CreditFeeHint"
                                               Text="Nota: Taxa referente a vendas em 1x (Crédito à Vista)."
                                               FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>

                                <TextBlock Grid.Row="6" Text="Taxa fixa (R$)" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBox x:Name="FeeFixedBox" Width="100" Height="30" Padding="8,0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Ex.: R$ 0,20 por venda no PIX, além da porcentagem."
                                               FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Grid.Row="7" Text="Prazo (dias)" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBox x:Name="SettlementBox" Width="100" Height="30" Padding="8,0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="0 = na hora · 1 = D+1 · 30 = crédito à vista."
                                               FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Grid.Row="8" Text="Conta de destino" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,8">
                                    <ComboBox x:Name="DestAccountBox" Height="32" Width="280"
                                              HorizontalAlignment="Left" DisplayMemberPath="Label"/>
                                    <TextBlock Text="Para onde o valor vai na conciliação (caixa, a receber ou banco)."
                                               FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Grid.Row="9" Text="Status" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="ActiveBox" Content="Ativo (aparece no PDV e listagens)"
                                              VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Cancelar" Padding="12,6" Margin="0,0,8,0"
                                            Style="{StaticResource SgdbOutlineButtonStyle}" Click="Cancel_Click"/>
                                    <Button Content="Salvar (F9)" Padding="12,6" Margin="0,0,8,0"
                                            Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Save_Click"/>
                                    <Button x:Name="DeleteBtn" Content="Excluir" Padding="12,6"
                                            Style="{StaticResource SgdbOutlineButtonStyle}"
                                            Foreground="#B91C1C" Click="Delete_Click" Visibility="Collapsed"/>
                                </StackPanel>

                                <TextBlock x:Name="StatusMsg" Grid.Row="11" Grid.ColumnSpan="2"
                                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
