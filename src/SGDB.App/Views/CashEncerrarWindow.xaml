<Window x:Class="SGDB.Views.CashEncerrarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="520" SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/CashModalTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CloseMetricCard" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="CloseMetricLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>

            <Style x:Key="CloseMetricValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#0F172A"/>
            </Style>

            <Style x:Key="CloseMoneyShell" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="CloseModernPrimaryBtn" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="MinWidth" Value="168"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#C41E3A"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#A81830"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#8F1428"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseModernGhostBtn" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#EEF2F7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseLinkBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#1D4ED8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource GestaoModalShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource GestaoModalTitleBar}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Encerrar caixa do dia" Style="{StaticResource GestaoModalTitleText}"
                               FontSize="14"/>
                    <TextBlock x:Name="SessionDateText" FontSize="12" Foreground="#94A3B8"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Conteúdo com scroll; botões ficam sempre visíveis abaixo -->
            <ScrollViewer Grid.Row="1" MaxHeight="460"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,14,16,4">
                <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Border Style="{StaticResource CloseMetricCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Saldo inicial" Style="{StaticResource CloseMetricLabel}"/>
                                <TextBlock x:Name="SaldoInicialText" Style="{StaticResource CloseMetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CloseMetricCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Entradas" Style="{StaticResource CloseMetricLabel}"/>
                                <TextBlock x:Name="EntradasText" Style="{StaticResource CloseMetricValue}"
                                           Foreground="#15803D"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CloseMetricCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Saídas" Style="{StaticResource CloseMetricLabel}"/>
                                <TextBlock x:Name="SaidasText" Style="{StaticResource CloseMetricValue}"
                                           Foreground="#B91C1C"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="EsperadoCard" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                            Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Esperado na gaveta" FontSize="11" Foreground="#4338CA" Margin="0,0,0,2"/>
                                <TextBlock x:Name="EsperadoText" FontSize="17" FontWeight="Bold" Foreground="#312E81"
                                           Text="••••••"/>
                            </StackPanel>
                            <TextBlock x:Name="EsperadoHintText" DockPanel.Dock="Right"
                                       Text="Contagem cega — digite o contado para revelar"
                                       FontSize="11" Foreground="#6366F1" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="220" TextAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <Border x:Name="FormasPanel" Margin="0,0,0,10" Visibility="Collapsed"
                            Background="#FAFAF9" BorderBrush="#E7E5E4" BorderThickness="1"
                            CornerRadius="8" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Entradas por forma de pagamento" FontSize="11"
                                       FontWeight="SemiBold" Foreground="#57534E" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="FormasList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Key}" FontSize="12" Foreground="#44403C"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ValueDisplay}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#1C1917"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Button x:Name="ToggleNotesBtn" DockPanel.Dock="Right" Content="Somar cédulas"
                                    Margin="16,0,0,0" Style="{StaticResource CloseLinkBtn}"
                                    Click="ToggleNotes_Click"/>
                            <TextBlock Text="Dinheiro contado na gaveta" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#334155" VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                        </DockPanel>
                        <Border x:Name="ContadoShell" Style="{StaticResource CloseMoneyShell}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F1F5F9" Padding="12,0"
                                        CornerRadius="8,0,0,8" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                                    <TextBlock Text="R$" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#475569" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox x:Name="ContadoBox" Grid.Column="1"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="16" FontWeight="SemiBold" Padding="12,0"
                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                         TextChanged="ContadoBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border x:Name="NotesPanel" Visibility="Collapsed" Margin="0,0,0,10"
                            Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                            CornerRadius="8" Padding="10">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Fechar" Margin="16,0,0,0"
                                        Style="{StaticResource CloseLinkBtn}"
                                        Foreground="#92400E" Click="ToggleNotes_Click"/>
                                <TextBlock Text="Cédulas e moedas" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#92400E" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                            </DockPanel>
                            <UniformGrid Columns="3" x:Name="NotesGrid"/>
                            <DockPanel LastChildFill="True" Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="NotesTotalText" FontSize="13" FontWeight="Bold"
                                               Foreground="#92400E" VerticalAlignment="Center"
                                               Text="R$ 0,00" Margin="0,0,12,0"/>
                                    <Button Content="Usar esse valor" Style="{StaticResource CloseLinkBtn}"
                                            Foreground="#1D4ED8" FontWeight="SemiBold"
                                            VerticalAlignment="Center" Click="UsarNotasNoContado_Click"/>
                                </StackPanel>
                                <TextBlock Text="Total das cédulas"
                                           FontSize="11" Foreground="#92400E" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Diferença" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#334155" Margin="0,0,0,4"/>
                        <Border x:Name="DiffShell" Style="{StaticResource CloseMoneyShell}"
                                Background="#F8FAFC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DiffPrefix" Grid.Column="0" Background="#E2E8F0" Padding="12,0"
                                        CornerRadius="8,0,0,8" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                                    <TextBlock x:Name="DiffPrefixText" Text="R$" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#475569" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox x:Name="DiferencaBox" Grid.Column="1"
                                         BorderThickness="0" Background="Transparent" IsReadOnly="True"
                                         FontSize="16" FontWeight="SemiBold" Padding="12,0"
                                         VerticalContentAlignment="Center" TextAlignment="Right"
                                         TabIndex="-1" Foreground="#0F172A"/>
                                <TextBlock x:Name="DiffStatusText" Grid.Column="2" Margin="0,0,12,0"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="#64748B"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DiffAlertText" Margin="0,6,0,0" FontSize="11"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,4">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="ObsLabel" Text="Observação" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#334155"/>
                            <TextBlock x:Name="ObsRequiredBadge" DockPanel.Dock="Right"
                                       Text="Obrigatória" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#B91C1C" Visibility="Collapsed"/>
                        </DockPanel>
                        <TextBox x:Name="ObsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="52" MaxLength="300" Padding="10,8" FontSize="13"
                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="ObsBox_TextChanged"/>
                        <TextBlock x:Name="ObsHintText" Margin="0,6,0,0" FontSize="11"
                                   Foreground="#B91C1C" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Há diferença (quebra de caixa). Informe a justificativa para liberar o fechamento."/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Rodapé fixo: sempre visível -->
            <Border Grid.Row="2" Padding="16,10,16,14" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button x:Name="ConfirmBtn" DockPanel.Dock="Right"
                            Style="{StaticResource CloseModernPrimaryBtn}"
                            Margin="8,0,0,0" IsDefault="True" IsEnabled="False"
                            Click="Confirm_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ConfirmIcon" Text="✓" Margin="0,0,8,0" FontWeight="Bold"/>
                            <TextBlock x:Name="ConfirmLabel" Text="Confirmar fechamento"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelBtn" DockPanel.Dock="Right"
                            Content="Cancelar" Style="{StaticResource CloseModernGhostBtn}"
                            IsCancel="True" Click="Cancel_Click"/>
                    <TextBlock x:Name="LoadingPanel" Text="Fechando caixa…" FontSize="12"
                               Foreground="#64748B" VerticalAlignment="Center" Visibility="Collapsed"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
