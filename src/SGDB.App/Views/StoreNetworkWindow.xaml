<Window x:Class="SGDB.Views.StoreNetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rede Loja"
        Width="540" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="500" MinHeight="600"
        Background="#ECE9E4">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Rede Loja (2 PCs)" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
      <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="#475569"
                 Text="PC da loja = Servidor (dono do estoque). Notebook = Cliente (compras/produtos/estoque na mesma rede)."/>
    </StackPanel>

    <TabControl Grid.Row="1" Margin="0,12,0,0" x:Name="Tabs">
      <TabItem Header="Servidor (loja)">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
          <StackPanel>
            <Border Background="White" BorderBrush="#C8C4BC" BorderThickness="1" Padding="12" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="PIN da rede" FontSize="11" Foreground="#64748B"/>
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ServerPinBox" Height="32" FontSize="18" FontWeight="Bold"
                           VerticalContentAlignment="Center" MaxLength="8"/>
                  <Button Grid.Column="1" Content="Salvar PIN" Height="32" Margin="8,0,0,0" Click="SaveServerPin_Click"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Porta" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="ServerPortBox" Height="32" VerticalContentAlignment="Center" Text="5055"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button x:Name="StartBtn" Content="Ligar" Width="80" Height="32" Margin="0,0,6,0"
                            Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Start_Click"/>
                    <Button x:Name="StopBtn" Content="Desligar" Width="80" Height="32" Margin="0,0,6,0"
                            IsEnabled="False" Click="Stop_Click"/>
                    <Button Content="Firewall" Width="80" Height="32" Click="Firewall_Click"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ServerStatusText" Margin="0,10,0,0" FontSize="12" Foreground="#334155"
                           TextWrapping="Wrap" Text="Servidor desligado."/>
                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#64748B"
                           Text="Rede Loja segura (HTTPS) — fingerprint SHA-256"/>
                <TextBox x:Name="ServerFingerprintBox" Margin="0,4,0,0" Height="56"
                         FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Copiar fingerprint" Width="150" Height="28"
                            Click="CopyFingerprint_Click"/>
                    <TextBlock x:Name="CertValidityText" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="11" Foreground="#475569"
                               TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#C8C4BC" BorderThickness="1" Padding="12" Margin="0,12,0,0">
              <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Text="Endereço para o notebook" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock x:Name="UrlText" FontSize="16" FontWeight="Bold" Foreground="#0F172A"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,8" Text="—"/>
                <Image x:Name="QrImage" Width="180" Height="180" Stretch="Uniform" HorizontalAlignment="Center"/>
                <Button Content="Copiar endereço" Width="140" HorizontalAlignment="Center" Margin="0,8,0,0"
                        Click="CopyUrl_Click"/>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Padding="10">
              <TextBlock FontSize="11" Foreground="#1E3A5F" TextWrapping="Wrap"
                         Text="Deixe Ligado enquanto o notebook usa Produtos/Compras/Estoque. Fora da loja use AnyDesk (veja REDE_E_ACESSO_REMOTO.txt)."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Cliente (notebook)">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
          <StackPanel>
            <Border Background="White" BorderBrush="#C8C4BC" BorderThickness="1" Padding="12" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="IP do PC da loja (só o IP, sem porta)" FontSize="11" Foreground="#64748B"/>
                <TextBox x:Name="ClientHostBox" Height="32" Margin="0,4,0,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Exemplo: 192.168.18.138 — sem http:// e sem :5055"/>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="PIN" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="ClientPinBox" Height="32" FontSize="18" FontWeight="Bold"
                             VerticalContentAlignment="Center" MaxLength="8"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Porta" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="ClientPortBox" Height="32" VerticalContentAlignment="Center" Text="5055"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Fingerprint SHA-256 do PC da loja (copie da tela Servidor)" FontSize="11" Foreground="#64748B" Margin="0,10,0,0"/>
                <TextBox x:Name="ClientFingerprintBox" Height="56" Margin="0,4,0,0"
                         FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <Button Content="Salvar fingerprint" Width="160" Height="32" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Click="SaveFingerprint_Click"/>
                <TextBlock x:Name="ClientTlsStatusText" Margin="0,8,0,0" FontSize="12" Foreground="#334155"
                           TextWrapping="Wrap" Text="TLS: fingerprint ainda não configurado."/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Testar" Width="90" Height="32" Margin="0,0,8,0" Click="TestClient_Click"/>
                  <Button Content="Salvar como Cliente" Width="150" Height="32" Margin="0,0,8,0"
                          Style="{StaticResource SgdbPrimaryButtonStyle}" Click="SaveClient_Click"/>
                  <Button Content="Voltar ao PC único" Width="130" Height="32" Click="Standalone_Click"/>
                </StackPanel>
                <TextBlock x:Name="ClientStatusText" Margin="0,12,0,0" FontSize="12" Foreground="#334155"
                           TextWrapping="Wrap" Text="Modo atual: —"/>
              </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" Padding="10">
              <TextBlock FontSize="11" Foreground="#9A3412" TextWrapping="Wrap"
                         Text="No notebook: PDV abre só o Resumo do dia (sem vender). Compras, movimentações, estoque e relatórios usam o banco da loja. Servidor precisa estar Ligado."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Button Grid.Row="2" Content="Fechar" HorizontalAlignment="Right" Width="90" Height="32" Margin="0,12,0,0"
            IsCancel="True" Click="Close_Click"/>
  </Grid>
</Window>
