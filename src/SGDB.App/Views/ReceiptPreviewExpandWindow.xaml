<Window x:Class="SGDB.Views.ReceiptPreviewExpandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SGDB.Views"
        Title="Cupom — tamanho real"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1F2E"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeToContent="WidthAndHeight"
        MinWidth="400">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Visualização em tamanho real (escala 1:1)"
                   Foreground="White" FontSize="13" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="Transparent" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="620">
                <local:ReceiptPreviewControl x:Name="PreviewControl" Compact="False"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,4">
            <Button MinHeight="40" Padding="18,12" Margin="0,0,12,0"
                    VerticalContentAlignment="Center"
                    Style="{StaticResource SgdbOutlineButtonStyle}"
                    Background="White" Click="PrintTest_Click">
                <TextBlock Text="🖨 Imprimir Teste" VerticalAlignment="Center"/>
            </Button>
            <Button Content="Fechar (Esc)" MinHeight="40" Padding="18,12"
                    VerticalContentAlignment="Center"
                    Style="{StaticResource SgdbPrimaryButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
