<Window x:Class="SGDB.Views.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senha — SGDB"
        Height="420" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SplashBackgroundBrush}">
    <StackPanel Margin="28,24" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Text="Alterar senha" Foreground="#FFE9B8"
                   FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="SubtitleText" Foreground="#D1D9E4" FontSize="12"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,18"/>

        <Border Background="#A60F2744" BorderBrush="#4DD4A84B" BorderThickness="1"
                CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#FECACA" Visibility="Collapsed"
                           TextWrapping="Wrap" Background="#40B91C1C" Padding="10,8" Margin="0,0,0,12"/>

                <TextBlock x:Name="LoginLabel" Text="Login" Foreground="#F3F6FA" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginBox" Height="36" Padding="10,0" FontSize="13"
                         VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock x:Name="RecoveryLabel" Text="Código de recuperação" Foreground="#F3F6FA"
                           FontSize="12" Margin="0,0,0,4" Visibility="Collapsed"/>
                <TextBox x:Name="RecoveryBox" Height="36" Padding="10,0" FontSize="13"
                         VerticalContentAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"
                         CharacterCasing="Upper"/>

                <TextBlock Text="Nova senha" Foreground="#F3F6FA" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="SenhaBox" Height="36" Padding="10,0" FontSize="13"
                             VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Confirmar nova senha" Foreground="#F3F6FA" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="Senha2Box" Height="36" Padding="10,0" FontSize="13"
                             VerticalContentAlignment="Center"/>

                <Button Content="Salvar senha" Height="42" Margin="0,18,0,0"
                        Background="#D4A84B" Foreground="#0F2744" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
