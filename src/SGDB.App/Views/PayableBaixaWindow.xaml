<Window x:Class="SGDB.Views.PayableBaixaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SGDB.Controls"
        Title="Baixar / Pagar"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="MoneyInput" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SgdbGoldBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF3FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Border Margin="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
            CornerRadius="10" Padding="22">
        <StackPanel>
            <TextBlock Text="Baixar / Pagar" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource SgdbBlueBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="ResumoText" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <!-- Bloco: valores -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DADOS DO PAGAMENTO" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="#94A3B8" Margin="0,0,0,10"/>
                    <UniformGrid Columns="3" Rows="1">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Valor" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ValorBox" Style="{StaticResource MoneyInput}"
                                     IsReadOnly="True" TextChanged="Recalc_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Desconto (−)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DescontoBox" Style="{StaticResource MoneyInput}"
                                     LostFocus="Money_LostFocus" TextChanged="Recalc_TextChanged"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Juros (+)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="JurosBox" Style="{StaticResource MoneyInput}"
                                     LostFocus="Money_LostFocus" TextChanged="Recalc_TextChanged"/>
                        </StackPanel>
                    </UniformGrid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Multa (+)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MultaBox" Style="{StaticResource MoneyInput}"
                                     LostFocus="Money_LostFocus" TextChanged="Recalc_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vl. Pago (= Valor − Desc. + Juros + Multa)"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PagoBox" Style="{StaticResource MoneyInput}"
                                     IsReadOnly="True" FontWeight="SemiBold" FontSize="15"
                                     Foreground="{StaticResource SgdbBlueBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bloco: forma de pagamento -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="FORMA DE PAGAMENTO" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="#94A3B8" Margin="0,0,0,10"/>
                    <UniformGrid Columns="3" Rows="1">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Pago Em" Style="{StaticResource FieldLabel}"/>
                            <controls:BrDateBox x:Name="DataBox" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Tipo Cobrança" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TipoBox" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Conta / Caixa" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ContaBox" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Observações + anexo -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Observações" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <Button x:Name="BtnAnexar" Grid.Column="1" Content="📎 Anexar comprovante"
                        Style="{StaticResource SgdbOutlineButtonStyle}" Height="28" MinWidth="0"
                        Padding="10,0" FontWeight="Normal" FontSize="12" Margin="0,0,0,4"
                        Click="Anexar_Click"/>
            </Grid>
            <TextBox x:Name="ObsBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12"
                     BorderBrush="#CBD5E1" BorderThickness="1"/>
            <TextBlock x:Name="AnexoText" FontSize="11" Foreground="#059669" Margin="0,4,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnEstornar" Content="Estornar baixa"
                        Style="{StaticResource SgdbOutlineButtonStyle}"
                        Visibility="Collapsed" Click="Estornar_Click"/>
                <Button Content="Cancelar" Style="{StaticResource SgdbOutlineButtonStyle}"
                        IsCancel="True" Click="Cancelar_Click"/>
                <Button x:Name="BtnSalvar" Content="Salvar baixa"
                        Style="{StaticResource SgdbPrimaryButtonStyle}" MinWidth="120"
                        Margin="0" IsDefault="True" Click="Salvar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
