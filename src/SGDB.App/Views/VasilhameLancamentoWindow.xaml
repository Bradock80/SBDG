<Window x:Class="SGDB.Views.VasilhameLancamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SGDB.Controls"
        Title="Vasilhame"
        Width="520"
        SizeToContent="Height"
        MinHeight="560"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SgdbBgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="TitleHint" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <TextBlock Text="Nome de quem pegou *" Margin="0,0,0,4"/>
                <TextBox x:Name="NomeBox" Height="32" Margin="0,0,0,4"
                         ToolTip="Não precisa ser cliente cadastrado — basta o nome."/>
                <TextBlock Text="Não precisa cadastrar o cliente. Só o nome já lança o empréstimo."
                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Telefone" Margin="0,0,0,4"/>
                <TextBox x:Name="PhoneBox" Height="32" Margin="0,0,0,10"/>
                <TextBlock Text="Vincular a cliente cadastrado (opcional)" Margin="0,0,0,4"/>
                <ComboBox x:Name="ClienteBox" Height="32" IsEditable="True" Margin="0,0,0,12"
                          DisplayMemberPath="Name"
                          ToolTip="Opcional. Se escolher alguém da lista, preenche nome e telefone."/>

                <TextBlock Text="Itens (pode lançar vários tipos de uma vez)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="#F8FAFC" BorderBrush="#C5D4E8" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tipo *" FontSize="11" Foreground="#475569"/>
                            <ComboBox x:Name="TipoBox" Height="30" DisplayMemberPath="Name" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Qtd *" FontSize="11" Foreground="#475569"/>
                            <TextBox x:Name="QtyBox" Height="30" Text="1" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="4" Content="+ Incluir" Height="30" VerticalAlignment="Bottom"
                                Padding="12,0" Style="{StaticResource SgdbOutlineButtonStyle}"
                                Click="AddItem_Click"
                                ToolTip="Adiciona este tipo/quantidade na lista abaixo"/>
                    </Grid>
                </Border>

                <Border BorderBrush="#C8C4BC" BorderThickness="1" Margin="0,0,0,10" MaxHeight="160">
                    <DataGrid x:Name="ItensGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0"
                              Background="White" RowHeaderWidth="0" RowHeight="28" FontSize="12"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeName}" Width="*"/>
                            <DataGridTextColumn Header="Qtd" Binding="{Binding QtyDisplay}" Width="70"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remover" Padding="6,2" FontSize="11"
                                                Click="RemoveItem_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel x:Name="DuePanel" Margin="0,0,0,10">
                    <TextBlock Text="Devolver até" Margin="0,0,0,4"/>
                    <controls:BrDateBox x:Name="DueBox" Width="160" HorizontalAlignment="Left"/>
                </StackPanel>

                <TextBlock Text="Observações" Margin="0,0,0,4"/>
                <TextBox x:Name="NotesBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Salvar" Style="{StaticResource SgdbPrimaryButtonStyle}" Width="100"
                    Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Style="{StaticResource SgdbOutlineButtonStyle}" Width="100"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
