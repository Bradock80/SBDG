<UserControl x:Class="SGDB.Views.HomeSplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SplashBackgroundBrush}">
    <Grid>
        <Border x:Name="ValidityAlertBar" Visibility="Collapsed" VerticalAlignment="Top"
                Margin="16,12,16,0" Padding="14,8" CornerRadius="6" Cursor="Hand"
                Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1"
                MouseLeftButtonUp="ValidityAlertBar_MouseLeftButtonUp">
            <TextBlock x:Name="ValidityAlertText" FontSize="13" FontWeight="SemiBold"
                       Foreground="#991B1B" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="820">
            <TextBlock x:Name="DepositoText" Text="Meu Depósito"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource SgdbGoldLightBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,24"
                       TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Grid Width="150" Height="150" Margin="0,0,14,0">
                    <Ellipse Stroke="{StaticResource SgdbGoldBrush}" StrokeThickness="7"
                             Fill="{StaticResource LogoCircleBrush}"/>
                    <Ellipse Margin="18" Stroke="#73D4A84B" StrokeThickness="2"/>
                    <TextBlock Text="S" FontSize="72" FontWeight="Bold"
                               Foreground="{StaticResource SgdbGoldLightBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="GDB" FontSize="120" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Sistema de Gestão de Depósito de Bebidas"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="#EBF0DFA8"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
