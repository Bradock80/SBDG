<UserControl x:Class="SGDB.Views.StockReportModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECE9E4" Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NumHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DDD8D0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="BorderBrush" Value="#C8C4BC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="TextHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DDD8D0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="#C8C4BC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TextHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FooterBadge" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="#F0F0F0" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Filtros: alinhados no centro vertical -->
            <Border Grid.Row="1" Padding="12,12" Margin="0,0,0,4"
                    Background="#FAF8F4" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="PeriodPanel" Orientation="Horizontal" Visibility="Collapsed"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="De" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12" Foreground="#64748B"/>
                        <DatePicker x:Name="DateFrom" Width="130" Height="32" Margin="0,0,16,0"
                                    VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Até" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12" Foreground="#64748B"/>
                        <DatePicker x:Name="DateTo" Width="130" Height="32" Margin="0,0,16,0"
                                    VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Visualizar (F7)" Padding="14,7" Height="32" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Refresh_Click"/>
                    <Button x:Name="ZeroBtn" Content="Zerar negativos (F9)" Padding="14,7" Height="32"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            Style="{StaticResource SgdbOutlineButtonStyle}" Click="Zero_Click" Foreground="#C41E3A"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="2" x:Name="ReportGrid" Margin="12,4,12,0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#C8C4BC" BorderThickness="1"
                      Background="White" RowHeaderWidth="0" RowHeight="40" FontSize="12"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      AlternatingRowBackground="#FAFBFC">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="0"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          Margin="0"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>

            <!-- Rodapé em badges -->
            <Border Grid.Row="3" Padding="12,10" Background="#FAFAF9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="PeriodHint" DockPanel.Dock="Left"
                               VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"/>
                    <StackPanel x:Name="FooterBadges" DockPanel.Dock="Right"
                                Orientation="Horizontal" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SummaryText" DockPanel.Dock="Right"
                               VerticalAlignment="Center" FontSize="12" Foreground="#475569"
                               Visibility="Collapsed"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
