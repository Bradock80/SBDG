<UserControl x:Class="SGDB.Views.CashModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="CashModuleView_PreviewKeyDown">
    <Border BorderBrush="#B8C4D4" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10,6" Background="{StaticResource TitleBarGradientBrush}"
                    BorderBrush="{StaticResource SgdbGoldBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Caixa" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    <Button x:Name="CloseTabButton" Style="{StaticResource ModuleTabCloseStyle}"
                            HorizontalAlignment="Right" Click="CloseTabButton_Click"/>
                </Grid>
            </Border>

            <Border x:Name="StatusBar" Grid.Row="1" Padding="10,6" Background="#FEE2E2">
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="12" Foreground="#991B1B"/>
            </Border>

            <!-- Caixa fechado -->
            <Grid x:Name="FechadoPanel" Grid.Row="2" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"
                        Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="Saldo inicial (dinheiro)" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="AberturaValorBox" Height="30" Padding="8,0" FontSize="13"
                                 VerticalContentAlignment="Center" Text="0,00"/>
                        <TextBlock Text="Observação" FontSize="11" Foreground="#475569" Margin="0,12,0,4"/>
                        <TextBox x:Name="AberturaObsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="80" Padding="8" MaxLength="300"/>
                        <Button Margin="0,16,0,0" Padding="12,10" Cursor="Hand"
                                Background="#1E3A5F" Foreground="White" BorderThickness="0"
                                Click="AbrirCaixa_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔓" Margin="0,0,8,0"/>
                                <TextBlock Text="Abrir caixa (F2)" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24">
                    <TextBlock x:Name="FechadoHintText" Text="Não há entradas ou saídas. (Caixa fechado)."
                               FontSize="14" Foreground="#64748B" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,0,0,8"
                               Text="Consulte turnos anteriores em Relatório → Histórico do Caixa."/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#64748B"
                               Text="PDV e Receber (fiado) só funcionam com o caixa aberto."/>
                </StackPanel>
            </Grid>

            <!-- Caixa aberto -->
            <Grid x:Name="AbertoPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Saldo inicial (dinheiro)" FontSize="11" Foreground="#475569" Margin="0,0,8,0"/>
                                <TextBlock x:Name="HeaderSaldoText" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Observação" FontSize="11" Foreground="#475569" Margin="0,0,8,0"/>
                                <TextBlock x:Name="HeaderObsText" FontSize="12"/>
                            </StackPanel>
                            <TextBlock x:Name="HeaderAbertoText" FontSize="11" Foreground="#166534"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,6"
                                Background="#254A75" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Click="AdicionarLancamento_Click">
                            <TextBlock Text="+ Adicionar entrada / saída" FontWeight="SemiBold" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Background="#F8FAFC" Margin="0">
                        <Button Style="{StaticResource ModuleActionButtonStyle}" Margin="8,8,8,4"
                                Click="ExcluirMovimento_Click">
                            <StackPanel>
                                <TextBlock Text="🗑" Style="{StaticResource ModuleActionIconStyle}"/>
                                <TextBlock Text="Del | Excluir" Style="{StaticResource ModuleActionLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModuleActionButtonStyle}" Margin="8,4" Click="PrintMov_Click">
                            <StackPanel>
                                <TextBlock Text="🖨" Style="{StaticResource ModuleActionIconStyle}"/>
                                <TextBlock Text="Imprimir mov." Style="{StaticResource ModuleActionLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModuleActionButtonStyle}" Margin="8,4" Click="PrintResumo_Click">
                            <StackPanel>
                                <TextBlock Text="🖨" Style="{StaticResource ModuleActionIconStyle}"/>
                                <TextBlock Text="Imprimir resumo" Style="{StaticResource ModuleActionLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="8,12,8,8" Padding="10,12" Cursor="Hand"
                                Background="#DC2626" Foreground="White" BorderThickness="0"
                                Click="FecharCaixa_Click">
                            <StackPanel>
                                <TextBlock Text="🔒" HorizontalAlignment="Center" FontSize="16"/>
                                <TextBlock Text="Fechar caixa (F3)" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid x:Name="MovimentosGrid" Grid.Column="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource SgdbGridLineBrush}"
                              VerticalGridLinesBrush="{StaticResource SgdbGridLineBrush}"
                              BorderThickness="0" Background="White"
                              RowHeight="28" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data / Hora" Binding="{Binding DateTimeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Historico}" Width="*"/>
                            <DataGridTextColumn Header="Entrada" Binding="{Binding EntradaDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Saída" Binding="{Binding SaidaDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Forma pagto." Binding="{Binding FormaPagto}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1,0,0,0"
                            Padding="12,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ResumoPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
