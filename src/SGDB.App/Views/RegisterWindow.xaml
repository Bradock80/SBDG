<Window x:Class="SGDB.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar conta — SGDB"
        Height="720" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SplashBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="RegTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAF8F4"/>
            <Setter Property="BorderBrush" Value="#C5CBD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D4A84B"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAF8F4"/>
            <Setter Property="BorderBrush" Value="#C5CBD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D4A84B"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="#0F2744"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#D4A84B" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8C15E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8892F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#8A9BB0"/>
                                <Setter Property="Foreground" Value="#E8EEF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="32,24" MaxWidth="380">
            <TextBlock Text="Criar conta" FontSize="22" FontWeight="SemiBold"
                       Foreground="#FFE9B8" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Perfil padrão: Vendedor. Um administrador precisa ativar a conta."
                       FontSize="12" Foreground="#D1D9E4" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,0,0,18"/>

            <Border Padding="26,22" CornerRadius="10"
                    Background="#A60F2744" BorderBrush="#4DD4A84B" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="#FECACA" Margin="0,0,0,12"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Background="#40B91C1C" Padding="10,8" FontSize="12"/>

                    <TextBlock Text="Nome completo *" Foreground="#F3F6FA" FontWeight="SemiBold"
                               FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="NomeBox" Style="{StaticResource RegTextBoxStyle}"
                             KeyDown="Field_KeyDown"/>

                    <TextBlock Text="Usuário *" Foreground="#F3F6FA" FontWeight="SemiBold"
                               FontSize="12" Margin="0,12,0,6"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource RegTextBoxStyle}"
                             TextChanged="LoginBox_TextChanged" KeyDown="Field_KeyDown"/>
                    <TextBlock x:Name="LoginHint" FontSize="11" Foreground="#94A3B8"
                               Margin="2,4,0,0" TextWrapping="Wrap"
                               Text="Letras minúsculas, números, ponto, _ ou -."/>

                    <TextBlock Text="E-mail (opcional)" Foreground="#F3F6FA" FontWeight="SemiBold"
                               FontSize="12" Margin="0,12,0,6"/>
                    <TextBox x:Name="EmailBox" Style="{StaticResource RegTextBoxStyle}"
                             KeyDown="Field_KeyDown"/>

                    <TextBlock Text="Senha *" Foreground="#F3F6FA" FontWeight="SemiBold"
                               FontSize="12" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="SenhaBox" Style="{StaticResource RegPasswordBoxStyle}"
                                 PasswordChanged="Password_Changed" KeyDown="Field_KeyDown"/>

                    <TextBlock Text="Confirmar senha *" Foreground="#F3F6FA" FontWeight="SemiBold"
                               FontSize="12" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="Senha2Box" Style="{StaticResource RegPasswordBoxStyle}"
                                 PasswordChanged="Password_Changed" KeyDown="Field_KeyDown"/>
                    <TextBlock x:Name="PasswordHint" FontSize="11" Foreground="#94A3B8"
                               Margin="2,4,0,0"/>

                    <Button x:Name="SaveBtn" Content="Criar conta" Margin="0,20,0,0"
                            Style="{StaticResource RegPrimaryButtonStyle}"
                            IsDefault="True" Click="Save_Click"/>

                    <Button Content="Voltar ao login" Margin="0,12,0,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="#C5D0DE" FontSize="12" HorizontalAlignment="Center"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
