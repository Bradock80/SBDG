<UserControl x:Class="SGDB.Views.MeuNegocioModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SgdbBgBrush}"
             Focusable="True"
             PreviewKeyDown="MeuNegocioModuleView_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="MnTabBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MnKpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="MnKpiCardAlert" TargetType="Border" BasedOn="{StaticResource MnKpiCard}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style x:Key="MnKpiCardHero" TargetType="Border" BasedOn="{StaticResource MnKpiCard}">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="BorderBrush" Value="#1E3A5F"/>
        </Style>
        <Style x:Key="MnKpiCardSuccess" TargetType="Border" BasedOn="{StaticResource MnKpiCard}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style x:Key="MnKpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style x:Key="MnKpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="MnCellL" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="MnCellR" TargetType="TextBlock" BasedOn="{StaticResource MnCellL}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,0,12,0"/>
        </Style>
        <Style x:Key="MnHdrL" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="MnHdrR" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MnHdrL}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <DataTemplate x:Key="MnPieLegendItem">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2"
                        Background="{Binding ColorBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                           VerticalAlignment="Center" Margin="8,0,10,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalDisplay}" TextAlignment="Right"
                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="NoWrap"/>
                <TextBlock Grid.Column="3" Text="{Binding PctDisplay}" TextAlignment="Right"
                           VerticalAlignment="Center" FontSize="12" Foreground="#64748B"
                           TextWrapping="NoWrap"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="MnDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SgdbGridLineBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#B8C4D4" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Padding="16,10" Background="{StaticResource TitleBarGradientBrush}"
                    BorderBrush="{StaticResource SgdbGoldBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Meu Negócio" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right"
                            Click="CloseTabButton_Click"/>
                </Grid>
            </Border>

            <!-- Period + filters -->
            <Border Grid.Row="1" Padding="14,10" Background="#FAF8F4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Período:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PeriodText" VerticalAlignment="Center" Foreground="#334155" Margin="0,0,16,0"/>
                        <Button Content="Selecionar Período" Style="{StaticResource SgdbOutlineButtonStyle}"
                                Click="SelecionarPeriodo_Click"/>
                        <Button Content="Atualizar" Style="{StaticResource SgdbPrimaryButtonStyle}"
                                Click="Atualizar_Click" ToolTip="F5" Margin="0,0,16,0"/>
                        <Border Width="1" Background="#E2E8F0" Margin="0,4,16,4"/>
                        <StackPanel x:Name="FilterVendas" Orientation="Horizontal">
                            <RadioButton x:Name="ModeSession" Content="Data do caixa" IsChecked="True"
                                         GroupName="mnMode" Margin="0,0,14,0" VerticalAlignment="Center"
                                         Checked="Mode_Changed"/>
                            <RadioButton x:Name="ModeCreated" Content="Data da venda" GroupName="mnMode"
                                         VerticalAlignment="Center" Checked="Mode_Changed"/>
                        </StackPanel>
                        <StackPanel x:Name="FilterRd" Orientation="Horizontal" Visibility="Collapsed">
                            <RadioButton x:Name="RdModeDue" Content="Data de vencimento" IsChecked="True"
                                         GroupName="mnRdMode" Margin="0,0,14,0" VerticalAlignment="Center"
                                         Checked="RdMode_Changed"/>
                            <RadioButton x:Name="RdModeEmission" Content="Data de emissão" GroupName="mnRdMode"
                                         VerticalAlignment="Center" Checked="RdMode_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabs -->
            <Border Grid.Row="2" Padding="14,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabVisao" Content="Visão Geral" Style="{StaticResource MnTabBtn}"
                            Tag="active" Click="Tab_Click"/>
                    <Button x:Name="TabMargem" Content="Margem de Lucro" Style="{StaticResource MnTabBtn}"
                            Click="Tab_Click"/>
                    <Button x:Name="TabRecebimentos" Content="Recebimentos" Style="{StaticResource MnTabBtn}"
                            Click="Tab_Click"/>
                    <Button x:Name="TabMensal" Content="Resultado Mensal" Style="{StaticResource MnTabBtn}"
                            Click="Tab_Click"/>
                    <Button x:Name="TabReceitasDespesas" Content="Receitas e Despesas" Style="{StaticResource MnTabBtn}"
                            Click="Tab_Click"/>
                    <Button x:Name="TabTaxas" Content="Taxas de Pagamento" Style="{StaticResource MnTabBtn}"
                            Click="Tab_Click"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="14"
                          PreviewMouseWheel="ContentScroll_PreviewMouseWheel">
                <Grid>
                    <!-- VISÃO GERAL -->
                    <StackPanel x:Name="PanelVisao">
                        <UniformGrid Columns="6" Margin="0,0,0,8">
                            <Border Style="{StaticResource MnKpiCardHero}">
                                <Grid>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="Faturamento" Style="{StaticResource MnKpiLabel}" Foreground="#BFDBFE"/>
                                        <TextBlock x:Name="KpiFaturamento" Style="{StaticResource MnKpiValue}" Foreground="White" FontSize="20"/>
                                    </StackPanel>
                                    <TextBlock Text="$" FontSize="24" FontWeight="Bold" Foreground="#60A5FA"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Quantidade Pedidos" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiPedidos" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Ticket Médio" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiTicket" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Total Descontos" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiDescontos" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Total Serviços" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiServicos" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Pedidos Cancelados" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiCancelados" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="CMV" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiCmv" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Itens Vendidos" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiItens" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Média Itens / Pedido" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiMediaItens" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Clientes Atendidos" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="KpiClientes" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCardAlert}">
                                <StackPanel>
                                    <TextBlock Text="Despesas" Style="{StaticResource MnKpiLabel}" Foreground="#B91C1C"/>
                                    <TextBlock x:Name="KpiDespesas" Style="{StaticResource MnKpiValue}" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCardAlert}">
                                <StackPanel>
                                    <TextBlock Text="Pago em taxas" Style="{StaticResource MnKpiLabel}" Foreground="#B91C1C"/>
                                    <TextBlock x:Name="KpiTaxas" Style="{StaticResource MnKpiValue}" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Saldo Período" Style="{StaticResource MnKpiLabel}" Foreground="#1D4ED8"/>
                                    <TextBlock x:Name="KpiSaldo" Style="{StaticResource MnKpiValue}" Foreground="#1E3A5F"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCardSuccess}">
                                <StackPanel>
                                    <TextBlock Text="Lucro Bruto" Style="{StaticResource MnKpiLabel}" Foreground="#15803D"/>
                                    <TextBlock x:Name="KpiLucroBruto" Style="{StaticResource MnKpiValue}" Foreground="#16A34A"/>
                                    <TextBlock Text="Fat − CMV − Desp. − Taxas" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                                Padding="12" Background="White" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Faturamento diário" FontWeight="SemiBold" FontSize="14"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="12" Height="12" Background="#1D4ED8" CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Text="Caixa (PDV)" FontSize="11" Foreground="#475569"
                                                   VerticalAlignment="Center" Margin="6,0,14,0"/>
                                        <Border Width="12" Height="12" Background="#60A5FA" CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Text="Fiado" FontSize="11" Foreground="#475569"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="ChartEmpty" DockPanel.Dock="Top" Text="Nenhuma venda no período."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,16,0,0"
                                           HorizontalAlignment="Center"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="DailyChartItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="30" Margin="1,0" Background="#01FFFFFF"
                                                        VerticalAlignment="Bottom" Cursor="Hand"
                                                        ToolTipService.InitialShowDelay="100"
                                                        ToolTipService.ShowDuration="20000">
                                                    <Border.ToolTip>
                                                        <ToolTip Background="#0F172A" BorderThickness="0" Padding="10,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="Bold"
                                                                           Foreground="White" Margin="0,0,0,6"/>
                                                                <TextBlock Text="{Binding TooltipCaixa}" Foreground="#93C5FD" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding TooltipFiado}" Foreground="#BFDBFE" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding TooltipTotal}" Foreground="White"
                                                                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <StackPanel VerticalAlignment="Bottom">
                                                        <Border Height="140" Background="Transparent">
                                                            <StackPanel VerticalAlignment="Bottom">
                                                                <Border Background="#1D4ED8" CornerRadius="3,3,0,0"
                                                                        Height="{Binding CaixaBarHeight}" MinHeight="0"/>
                                                                <Border Background="#60A5FA"
                                                                        Height="{Binding FiadoBarHeight}" MinHeight="0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#64748B"
                                                                   TextAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Insights: melhor dia / período do mês -->
                        <Border x:Name="InsightPanel" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                                Padding="12" Background="White" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Quando vende mais" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,12">
                                    <Border Style="{StaticResource MnKpiCard}" Background="#EEF2FF" BorderBrush="#C7D2FE" MinWidth="200">
                                        <StackPanel>
                                            <TextBlock Text="Melhor dia da semana" Style="{StaticResource MnKpiLabel}" Foreground="#4338CA"/>
                                            <TextBlock x:Name="InsightMelhorDow" Style="{StaticResource MnKpiValue}" Foreground="#1E3A5F" FontSize="20"/>
                                            <TextBlock x:Name="InsightMelhorDowValor" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MnKpiCard}" Background="#F0FDF4" BorderBrush="#BBF7D0" MinWidth="200">
                                        <StackPanel>
                                            <TextBlock Text="Melhor momento do mês" Style="{StaticResource MnKpiLabel}" Foreground="#166534"/>
                                            <TextBlock x:Name="InsightPeriodoMes" Style="{StaticResource MnKpiValue}" Foreground="#14532D" FontSize="20"/>
                                            <TextBlock x:Name="InsightPeriodoDetalhe" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MnKpiCard}" Background="#FFF7ED" BorderBrush="#FED7AA" MinWidth="200">
                                        <StackPanel>
                                            <TextBlock Text="Melhor dia no período" Style="{StaticResource MnKpiLabel}" Foreground="#C2410C"/>
                                            <TextBlock x:Name="InsightMelhorData" Style="{StaticResource MnKpiValue}" Foreground="#9A3412" FontSize="20"/>
                                            <TextBlock x:Name="InsightMelhorDataValor" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock x:Name="InsightRanking" FontSize="12" Foreground="#475569" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="InsightDowList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,0" ToolTip="{Binding Tooltip}">
                                                <Border Height="56" Background="Transparent">
                                                    <Border Background="{Binding BarBrush}" CornerRadius="4,4,0,0"
                                                            VerticalAlignment="Bottom" Height="{Binding BarHeight}"
                                                            MinHeight="2"/>
                                                </Border>
                                                <TextBlock Text="{Binding DiaCurto}" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                                           Foreground="{Binding LabelBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Início = dias 1–10 · Meio = 11–20 · Final = 21–31 (pelo dia do calendário de cada venda)."
                                           FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                                Padding="12" Background="White" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Top 15 mais vendidos" FontWeight="SemiBold"
                                           FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TopEmpty" Text="Nenhum item vendido no período."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
                                <ItemsControl x:Name="TopList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="28" Margin="0,0,0,4" ToolTip="{Binding Name}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Posicao}" FontWeight="Bold"
                                                           Foreground="#1D4ED8" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Grid Grid.Column="2" Height="18" Margin="0,0,8,0"
                                                      VerticalAlignment="Center">
                                                    <Border Background="#E8E8E8" CornerRadius="2"/>
                                                    <Border Background="#1D4ED8" CornerRadius="2"
                                                            HorizontalAlignment="Left" MinWidth="2"
                                                            Width="{Binding BarWidth}"/>
                                                </Grid>
                                                <TextBlock Grid.Column="3" Text="{Binding QtyDisplay}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#0F172A"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,10,0,4" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                   Text="Vendas do PDV, sangrias/compras no caixa e recebimentos de fiado. Veja quanto pagou de taxa em Taxas de Pagamento."/>
                    </StackPanel>

                    <!-- RESULTADO MENSAL -->
                    <StackPanel x:Name="PanelMensal" Visibility="Collapsed">
                        <WrapPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource MnKpiCard}" Background="#EEF2FF" BorderBrush="#C7D2FE" MinWidth="200">
                                <StackPanel>
                                    <TextBlock Text="Faturamento no período" Style="{StaticResource MnKpiLabel}" Foreground="#4338CA"/>
                                    <TextBlock x:Name="MnFat" Style="{StaticResource MnKpiValue}" Foreground="#1E3A5F"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#FEF2F2" BorderBrush="#FECACA" MinWidth="200">
                                <StackPanel>
                                    <TextBlock Text="Custo vendido + sangrias" Style="{StaticResource MnKpiLabel}" Foreground="#B91C1C"/>
                                    <TextBlock x:Name="MnCusto" Style="{StaticResource MnKpiValue}" Foreground="#991B1B"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#EFF6FF" BorderBrush="#BFDBFE" MinWidth="200">
                                <StackPanel>
                                    <TextBlock Text="Lucro das vendas" Style="{StaticResource MnKpiLabel}" Foreground="#1D4ED8"/>
                                    <TextBlock x:Name="MnLucro" Style="{StaticResource MnKpiValue}" Foreground="#1E3A5F"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Faturamento, custo vendido e lucro — mês a mês" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Azul = Faturamento · Laranja = Custo vendido · Verde/Vermelho = Lucro"
                                               FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                    <TextBlock Text="Lucro = faturamento − CMV − sangrias. Pagamentos a fornecedores aparecem à parte (não entram no lucro)."
                                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="MensalChartEmpty" DockPanel.Dock="Top"
                                           Text="Sem vendas no período selecionado."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,16,0,0"
                                           HorizontalAlignment="Center"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="MensalChart">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="52" Margin="4,0" VerticalAlignment="Bottom"
                                                            ToolTip="{Binding Tooltip}">
                                                    <Border Height="140" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Center">
                                                            <Border Background="#2563EB" CornerRadius="3,3,0,0" Width="12"
                                                                    Height="{Binding BarFat}" MinHeight="0" Margin="0,0,2,0"/>
                                                            <Border Background="#F97316" CornerRadius="3,3,0,0" Width="12"
                                                                    Height="{Binding BarCusto}" MinHeight="0" Margin="0,0,2,0"/>
                                                            <Border Background="{Binding LucroBrush}" CornerRadius="3,3,0,0" Width="12"
                                                                    Height="{Binding BarLucro}" MinHeight="0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#64748B"
                                                               TextAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Resumo por mês" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <DataGrid x:Name="MensalGrid" Style="{StaticResource MnDataGrid}" MinHeight="200">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LucroNegativo}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mês" Binding="{Binding Mes}" Width="90"
                                                    ElementStyle="{StaticResource MnCellL}" HeaderStyle="{StaticResource MnHdrL}"/>
                                <DataGridTextColumn Header="Faturamento" Binding="{Binding FaturamentoDisplay}" Width="*"
                                                    ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                <DataGridTextColumn Header="Custo vendido" Binding="{Binding CustoDisplay}" Width="*"
                                                    ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                <DataGridTextColumn Header="Lucro vendas" Binding="{Binding LucroDisplay}" Width="*"
                                                    ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                <DataGridTextColumn Header="Pag. fornecedor" Binding="{Binding PagFornecedorDisplay}" Width="*"
                                                    ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                   Text="Use Selecionar Período para ver vários meses (ex.: últimos 6 ou 12 meses)."/>
                    </StackPanel>

                    <!-- MARGEM -->
                    <StackPanel x:Name="PanelMargem" Visibility="Collapsed">
                        <WrapPanel Margin="0,0,0,12">
                            <Border x:Name="MargemStatusCard" Style="{StaticResource MnKpiCard}" MinWidth="200"
                                    Background="#F0FDF4" BorderBrush="#BBF7D0">
                                <StackPanel>
                                    <TextBlock Text="Situação do catálogo" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="MgStatus" Style="{StaticResource MnKpiValue}"/>
                                    <TextBlock Text="Referência depósito: 18% a 22% saudável" FontSize="10"
                                               Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" MinWidth="180">
                                <StackPanel>
                                    <TextBlock Text="Média margem (catálogo)" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="MgMediaCat" Style="{StaticResource MnKpiValue}"/>
                                    <TextBlock Text="Sobre preço de venda — produtos ativos" FontSize="10"
                                               Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" MinWidth="180">
                                <StackPanel>
                                    <TextBlock Text="Margem vendas (período)" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="MgMediaVend" Style="{StaticResource MnKpiValue}"/>
                                    <TextBlock x:Name="MgPeriodoHint" FontSize="10"
                                               Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#EFF6FF" BorderBrush="#BFDBFE" MinWidth="180">
                                <StackPanel>
                                    <TextBlock Text="Margem vendas (histórico)" Style="{StaticResource MnKpiLabel}" Foreground="#1D4ED8"/>
                                    <TextBlock x:Name="MgMediaHist" Style="{StaticResource MnKpiValue}" Foreground="#1E3A8A"/>
                                    <TextBlock x:Name="MgHistoricoHint" FontSize="10"
                                               Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#FEF2F2" BorderBrush="#FECACA" MinWidth="180">
                                <StackPanel>
                                    <TextBlock Text="Produtos críticos (&lt;15%)" Style="{StaticResource MnKpiLabel}" Foreground="#B91C1C"/>
                                    <TextBlock x:Name="MgCriticos" Style="{StaticResource MnKpiValue}" Foreground="#991B1B"/>
                                    <TextBlock x:Name="MgTotalProdutos" FontSize="10"
                                               Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12"
                                Background="White" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sua margem vs. referência de mercado" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock FontSize="11" Foreground="#64748B" Margin="0,4,0,10" TextWrapping="Wrap">
                                    <Run Text="Depósito saudável: média entre "/>
                                    <Run Text="18% e 22%" FontWeight="SemiBold"/>
                                    <Run Text=" sobre a venda. Abaixo de "/>
                                    <Run Text="15%" FontWeight="SemiBold"/>
                                    <Run Text=" exige atenção. Cadastros com custo &gt; venda não entram na média."/>
                                </TextBlock>
                                <Grid Height="40" Margin="0,0,0,4">
                                    <Grid x:Name="MargemGaugeZones">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GaugeZoneCritico" Width="15*"/>
                                            <ColumnDefinition x:Name="GaugeZoneAtencao" Width="3*"/>
                                            <ColumnDefinition x:Name="GaugeZoneSaudavel" Width="4*"/>
                                            <ColumnDefinition x:Name="GaugeZoneExcelente" Width="8*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FEE2E2" CornerRadius="6,0,0,6"
                                                BorderBrush="#FECACA" BorderThickness="1,1,0,1">
                                            <TextBlock Text="&lt;15%" FontSize="10" FontWeight="SemiBold" Foreground="#991B1B"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="#FFEDD5" BorderBrush="#FED7AA" BorderThickness="0,1">
                                            <TextBlock Text="15–18%" FontSize="10" FontWeight="SemiBold" Foreground="#9A3412"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="2" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="0,1">
                                            <TextBlock Text="18–22%" FontSize="10" FontWeight="SemiBold" Foreground="#166534"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="3" Background="#DBEAFE" CornerRadius="0,6,6,0"
                                                BorderBrush="#BFDBFE" BorderThickness="0,1,1,1">
                                            <TextBlock Text="&gt;22%" FontSize="10" FontWeight="SemiBold" Foreground="#1E40AF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <Canvas x:Name="MargemGaugeCanvas" IsHitTestVisible="False" ClipToBounds="False">
                                        <Border x:Name="MargemGaugeMarker" Width="4" Height="48" Canvas.Top="-4"
                                                Background="#0F172A" CornerRadius="2" BorderBrush="White" BorderThickness="1.5"
                                                ToolTip="Média do catálogo"/>
                                    </Canvas>
                                </Grid>
                                <Grid x:Name="MargemGaugeLabels" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GaugeLabel0" Grid.Column="0" Text="0%" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="GaugeLabel1" Grid.Column="1" Text="10%" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="GaugeLabel2" Grid.Column="2" Text="15%" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="GaugeLabel3" Grid.Column="3" Text="18%" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="GaugeLabel4" Grid.Column="4" Text="22%" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="GaugeLabelMax" Grid.Column="5" Text="50%" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12"
                                Background="White" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Comparativo de margem (%)" FontWeight="SemiBold"
                                           FontSize="14" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="MargemBenchmarkList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,10,0"/>
                                                <Grid Grid.Column="1" Height="18" Margin="0,0,8,0">
                                                    <Border Background="#F1F5F9" CornerRadius="3"/>
                                                    <Border Background="{Binding ColorBrush}" CornerRadius="3"
                                                            HorizontalAlignment="Left" MinWidth="2"
                                                            Width="{Binding BarWidth}"/>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" FontSize="12"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                                    Padding="12" Background="White">
                                <StackPanel>
                                    <TextBlock Text="Produtos por faixa de margem" FontWeight="SemiBold"
                                               FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="MargemPieEmpty"
                                               Text="Nenhum produto com preço de venda cadastrado."
                                               Foreground="#94A3B8" Visibility="Collapsed" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                    <Grid x:Name="MargemPieBody">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="160" Height="160" Margin="0,0,12,0" Stretch="Uniform">
                                            <ItemsControl x:Name="MargemPie" Width="200" Height="200">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="200" Height="200"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Path Data="{Binding Geometry}" Fill="{Binding ColorBrush}"
                                                              Stroke="White" StrokeThickness="1.5"
                                                              ToolTip="{Binding Tooltip}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Viewbox>
                                        <ItemsControl x:Name="MargemPieLegend" Grid.Column="1" VerticalAlignment="Center"
                                                      ItemTemplate="{StaticResource MnPieLegendItem}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                                    Padding="12" Background="White">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="Margem média por grupo" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Width="16" Height="2" Background="#F97316" VerticalAlignment="Center"/>
                                            <TextBlock Text="15% mínimo" FontSize="10" Foreground="#64748B" Margin="4,0,10,0"/>
                                            <Border Width="16" Height="2" Background="#22C55E" VerticalAlignment="Center"/>
                                            <TextBlock Text="18% saudável" FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="MargemGruposEmpty" DockPanel.Dock="Top"
                                               Text="Sem grupos cadastrados."
                                               Foreground="#94A3B8" Visibility="Collapsed" Margin="0,8,0,0"
                                               HorizontalAlignment="Center"/>
                                    <Grid MinHeight="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Eixo Y fixo 0–50% -->
                                        <Grid Grid.Column="0" Margin="0,0,4,22">
                                            <TextBlock Text="50%" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                            <TextBlock Text="40%" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Top" Margin="0,28,0,0" HorizontalAlignment="Right"/>
                                            <TextBlock Text="30%" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,20"/>
                                            <TextBlock Text="20%" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,52" HorizontalAlignment="Right"/>
                                            <TextBlock Text="10%" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,26" HorizontalAlignment="Right"/>
                                            <TextBlock Text="0%" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Grid.Column="1">
                                            <Grid Margin="0,0,0,22" Height="160" VerticalAlignment="Top">
                                                <!-- linhas guia -->
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"/>
                                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"/>
                                                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"/>
                                                    <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"/>
                                                    <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"/>
                                                </Grid>
                                                <!-- metas 15% e 18% (de 50%: 15/50=30% from top = 70% from bottom) -->
                                                <Border Height="1" Background="#F97316" VerticalAlignment="Bottom"
                                                        Margin="0,0,0,48" Opacity="0.85"/>
                                                <Border Height="1" Background="#22C55E" VerticalAlignment="Bottom"
                                                        Margin="0,0,0,57.6" Opacity="0.85"/>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <ItemsControl x:Name="MargemGruposList" Height="160">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Width="44" Margin="3,0" VerticalAlignment="Bottom"
                                                                            ToolTip="{Binding Tooltip}">
                                                                    <Border Height="160" Background="Transparent">
                                                                        <Border Background="#2563EB" CornerRadius="3,3,0,0"
                                                                                VerticalAlignment="Bottom"
                                                                                Height="{Binding BarHeight}" MinHeight="2"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                            <ItemsControl x:Name="MargemGruposLabels" Margin="0,162,0,0" Height="22"
                                                          VerticalAlignment="Top">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Width="44" Margin="3,0" Text="{Binding LabelCurto}"
                                                                   FontSize="9" Foreground="#64748B" TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Label}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12"
                                Background="White" Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Produtos com margem abaixo de 15%"
                                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock x:Name="MargemCriticosEmpty" DockPanel.Dock="Top"
                                           Text="Nenhum produto abaixo de 15% — ótimo!"
                                           Foreground="#16A34A" Visibility="Collapsed" Margin="0,4,0,8"
                                           HorizontalAlignment="Center"/>
                                <DataGrid x:Name="MargemGrid" Style="{StaticResource MnDataGrid}" MinHeight="180"
                                          MaxHeight="360">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCadastroSuspeito}" Value="True">
                                                    <Setter Property="Background" Value="#FECACA"/>
                                                    <Setter Property="Foreground" Value="#7F1D1D"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="ToolTip"
                                                            Value="Custo maior que a venda — confira se cadastrou custo de fardo/caixa no lugar do unitário."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90"
                                                            ElementStyle="{StaticResource MnCellL}" HeaderStyle="{StaticResource MnHdrL}"/>
                                        <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"
                                                            ElementStyle="{StaticResource MnCellL}" HeaderStyle="{StaticResource MnHdrL}"/>
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding GroupName}" Width="120"
                                                            ElementStyle="{StaticResource MnCellL}" HeaderStyle="{StaticResource MnHdrL}"/>
                                        <DataGridTextColumn Header="Custo" Binding="{Binding CostDisplay}" Width="80"
                                                            ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                        <DataGridTextColumn Header="Venda" Binding="{Binding SaleDisplay}" Width="80"
                                                            ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                        <DataGridTextColumn Header="Margem %" Binding="{Binding MarginDisplay}" Width="110"
                                                            ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <TextBlock Margin="0,4,0,4" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap">
                            <Run Text="A "/>
                            <Run Text="média do catálogo" FontWeight="SemiBold"/>
                            <Run Text=" vem dos preços cadastrados nos produtos (não depende de venda nova). A "/>
                            <Run Text="margem histórica" FontWeight="SemiBold"/>
                            <Run Text=" usa todas as vendas já registradas. Ajuste preços em "/>
                            <Run Text="Produtos" FontWeight="SemiBold"/>
                            <Run Text=" ou "/>
                            <Run Text="Administrativo → Ajuste de preço" FontWeight="SemiBold"/>
                            <Run Text="."/>
                        </TextBlock>
                    </StackPanel>

                    <!-- RECEBIMENTOS -->
                    <StackPanel x:Name="PanelRecebimentos" Visibility="Collapsed">
                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <Border Style="{StaticResource MnKpiCard}" Background="#ECFDF5" BorderBrush="#A7F3D0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Faturamento" Style="{StaticResource MnKpiLabel}" Foreground="#047857"/>
                                    <TextBlock x:Name="RecFat" Style="{StaticResource MnKpiValue}" Foreground="#065F46"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#FDF2F8" BorderBrush="#FBCFE8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Total Serviços" Style="{StaticResource MnKpiLabel}" Foreground="#9D174D"/>
                                    <TextBlock x:Name="RecServicos" Style="{StaticResource MnKpiValue}" Foreground="#831843"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#F5F3FF" BorderBrush="#DDD6FE">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Total Descontos" Style="{StaticResource MnKpiLabel}" Foreground="#6D28D9"/>
                                    <TextBlock x:Name="RecDescontos" Style="{StaticResource MnKpiValue}" Foreground="#5B21B6"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Recebimentos Vs. Contas a Pagar" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Azul = Recebimento · Laranja = Contas a pagar" FontSize="11"
                                               Foreground="#64748B" Margin="0,4,0,0"/>
                                    <TextBlock Text="Recebimento: vendas à vista e baixas de fiado. Pagar: parcelas com vencimento no mês."
                                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="RecVsPagarEmpty" DockPanel.Dock="Top"
                                           Text="Sem recebimentos ou contas a pagar no período."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,12,0,0"
                                           HorizontalAlignment="Center"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="RecVsPagarChart">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="40" Margin="3,0" VerticalAlignment="Bottom"
                                                            ToolTip="{Binding Tooltip}">
                                                    <Border Height="120" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Center">
                                                            <Border Background="#2563EB" CornerRadius="3,3,0,0" Width="14"
                                                                    Height="{Binding BarA}" MinHeight="0" Margin="0,0,2,0"/>
                                                            <Border Background="#F97316" CornerRadius="3,3,0,0" Width="14"
                                                                    Height="{Binding BarB}" MinHeight="0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#64748B"
                                                               TextAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Bandeira (pizza + legenda) -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Recebimentos por Bandeira do Cartão" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Bandeira detectada no texto da forma de pagamento; cartão sem bandeira aparece agrupado."
                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RecBandeiraEmpty" Text="Nenhum recebimento no período."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
                                <Grid x:Name="RecBandeiraBody">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="200" Height="200" Margin="0,0,16,0" Stretch="Uniform">
                                        <ItemsControl x:Name="RecBandeiraPie" Width="200" Height="200">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="200" Height="200"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding Geometry}" Fill="{Binding ColorBrush}"
                                                          Stroke="White" StrokeThickness="1.5"
                                                          ToolTip="{Binding Tooltip}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <ItemsControl x:Name="RecBandeiraList" Grid.Column="1" VerticalAlignment="Center"
                                                  ItemTemplate="{StaticResource MnPieLegendItem}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Forma (pizza + legenda) -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Recebimentos por Forma de Pagamento" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Não inclui venda em fiado — só entra quando você registrar a baixa do cliente, pela data do recebimento."
                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RecFormaEmpty" Text="Nenhum recebimento no período (vendas à vista ou baixa de fiado)."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
                                <Grid x:Name="RecFormaBody">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="200" Height="200" Margin="0,0,16,0" Stretch="Uniform">
                                        <ItemsControl x:Name="RecFormaPie" Width="200" Height="200">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="200" Height="200"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding Geometry}" Fill="{Binding ColorBrush}"
                                                          Stroke="White" StrokeThickness="1.5"
                                                          ToolTip="{Binding Tooltip}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <ItemsControl x:Name="RecFormaList" Grid.Column="1" VerticalAlignment="Center"
                                                  ItemTemplate="{StaticResource MnPieLegendItem}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,8,0,4" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                   Text="Vendas à vista usam o filtro de data do topo; baixas de fiado usam a data em que o recebimento foi lançado."/>
                    </StackPanel>

                    <!-- RECEITAS E DESPESAS -->
                    <StackPanel x:Name="PanelReceitasDespesas" Visibility="Collapsed">
                        <WrapPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource MnKpiCard}" Background="#ECFDF5" BorderBrush="#A7F3D0" MinWidth="260">
                                <Grid>
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock x:Name="RdReceitasTotal" Style="{StaticResource MnKpiValue}" Foreground="#065F46" FontSize="22"/>
                                        <TextBlock x:Name="RdReceitasLine" FontSize="11" Foreground="#047857" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="RdTransferLine" FontSize="11" Foreground="#047857"/>
                                    </StackPanel>
                                    <TextBlock Text="+" FontSize="28" FontWeight="Bold" Foreground="#86EFAC"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#FEF2F2" BorderBrush="#FECACA" MinWidth="240">
                                <Grid>
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock x:Name="RdDespesasTotal" Style="{StaticResource MnKpiValue}" Foreground="#991B1B" FontSize="22"/>
                                        <TextBlock Text="(−) Despesas" FontSize="11" Foreground="#B91C1C" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="RdDespesasPrevisto" FontSize="11" Foreground="#B91C1C"/>
                                    </StackPanel>
                                    <TextBlock Text="−" FontSize="28" FontWeight="Bold" Foreground="#FCA5A5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#EFF6FF" BorderBrush="#BFDBFE" MinWidth="220">
                                <Grid>
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock x:Name="RdSaldo" Style="{StaticResource MnKpiValue}" Foreground="#1E3A5F" FontSize="22"/>
                                        <TextBlock Text="(=) Saldo do Período" FontSize="11" Foreground="#334155" Margin="0,6,0,0"/>
                                        <TextBlock Text="(Receita − Despesa)" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Text="$" FontSize="28" FontWeight="Bold" Foreground="#93C5FD"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </WrapPanel>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Receitas Vs. Despesas" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Vermelho = Receitas · Azul = Despesas" FontSize="11"
                                               Foreground="#64748B" Margin="0,4,0,0"/>
                                    <TextBlock Text="Por mês: receitas (vendas, fiado e suprimentos) e despesas (contas a pagar + caixa)."
                                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="RdMensalEmpty" DockPanel.Dock="Top"
                                           Text="Sem receitas ou despesas no período."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,12,0,0"
                                           HorizontalAlignment="Center"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="RdMensalChart">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="40" Margin="3,0" VerticalAlignment="Bottom"
                                                            ToolTip="{Binding Tooltip}">
                                                    <Border Height="120" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Center">
                                                            <Border Background="#EF4444" CornerRadius="3,3,0,0" Width="14"
                                                                    Height="{Binding BarA}" MinHeight="0" Margin="0,0,2,0"/>
                                                            <Border Background="#2563EB" CornerRadius="3,3,0,0" Width="14"
                                                                    Height="{Binding BarB}" MinHeight="0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#64748B"
                                                               TextAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Despesas Previstas x Despesas Realizadas" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Vermelho = Previstas · Azul = Realizadas" FontSize="11"
                                               Foreground="#64748B" Margin="0,4,0,0"/>
                                    <TextBlock Text="Previsto: parcelas pelo filtro de data; realizado: parcelas pagas na data do pagamento + sangrias/compras no caixa."
                                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="RdPrevRealEmpty" DockPanel.Dock="Top"
                                           Text="Sem despesas previstas ou realizadas no período."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,12,0,0"
                                           HorizontalAlignment="Center"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="RdPrevRealChart">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="40" Margin="3,0" VerticalAlignment="Bottom"
                                                            ToolTip="{Binding Tooltip}">
                                                    <Border Height="120" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Center">
                                                            <Border Background="#EF4444" CornerRadius="3,3,0,0" Width="14"
                                                                    Height="{Binding BarA}" MinHeight="0" Margin="0,0,2,0"/>
                                                            <Border Background="#2563EB" CornerRadius="3,3,0,0" Width="14"
                                                                    Height="{Binding BarB}" MinHeight="0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#64748B"
                                                               TextAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Despesas por Categoria" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Despesas de Contas a Pagar. No gráfico, agrupa por categoria (se informada) ou pelo nome do fornecedor."
                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RdCategoriaEmpty" Text="Nenhuma despesa no período."
                                           Foreground="#94A3B8" Visibility="Collapsed" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
                                <Grid x:Name="RdCategoriaBody">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="200" Height="200" Margin="0,0,16,0" Stretch="Uniform">
                                        <ItemsControl x:Name="RdCategoriaPie" Width="200" Height="200">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="200" Height="200"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding Geometry}" Fill="{Binding ColorBrush}"
                                                          Stroke="White" StrokeThickness="1.5"
                                                          ToolTip="{Binding Tooltip}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Viewbox>
                                    <ItemsControl x:Name="RdCategoriaList" Grid.Column="1" VerticalAlignment="Center"
                                                  ItemTemplate="{StaticResource MnPieLegendItem}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,8,0,4" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                   Text="Receitas: vendas à vista e baixas de fiado. Transferência: suprimentos de caixa. Despesas: títulos a pagar + sangrias/compras no caixa."/>
                    </StackPanel>

                    <!-- TAXAS DE PAGAMENTO -->
                    <StackPanel x:Name="PanelTaxas" Visibility="Collapsed">
                        <WrapPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource MnKpiCard}" Background="#FEF2F2" BorderBrush="#FECACA" MinWidth="220">
                                <StackPanel>
                                    <TextBlock Text="Total pago em taxas" Style="{StaticResource MnKpiLabel}" Foreground="#B91C1C"/>
                                    <TextBlock x:Name="TxTotalTaxas" Style="{StaticResource MnKpiValue}" Foreground="#991B1B"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" MinWidth="200">
                                <StackPanel>
                                    <TextBlock Text="Recebido (com taxa)" Style="{StaticResource MnKpiLabel}"/>
                                    <TextBlock x:Name="TxTotalComTaxa" Style="{StaticResource MnKpiValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MnKpiCard}" Background="#F0FDF4" BorderBrush="#BBF7D0" MinWidth="220">
                                <StackPanel>
                                    <TextBlock Text="Líquido após taxas" Style="{StaticResource MnKpiLabel}" Foreground="#166534"/>
                                    <TextBlock x:Name="TxLiquido" Style="{StaticResource MnKpiValue}" Foreground="#14532D"/>
                                    <TextBlock x:Name="TxPctRecebido" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Vendeu × pagou de taxa (por forma)" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Azul = Vendido · Vermelho = Taxa" FontSize="11"
                                               Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="TxResumoChart">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="48" Margin="3,0" VerticalAlignment="Bottom"
                                                            ToolTip="{Binding Tooltip}">
                                                    <Border Height="120" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Center">
                                                            <Border Background="#2563EB" CornerRadius="3,3,0,0" Width="14"
                                                                    Height="{Binding BarA}" MinHeight="0" Margin="0,0,2,0"/>
                                                            <Border Background="#EF4444" CornerRadius="3,3,0,0" Width="14"
                                                                    Height="{Binding BarB}" MinHeight="0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#64748B"
                                                               TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                                                               MaxWidth="48"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="White" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Para onde foi o dinheiro das taxas" FontWeight="SemiBold"
                                           FontSize="14" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="TxFormaList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="52"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2"
                                                        Background="{Binding ColorBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="8,0,10,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                    <Border Height="6" Background="#F1F5F9" CornerRadius="3" Margin="0,4,0,0">
                                                        <Border Background="{Binding ColorBrush}" CornerRadius="3"
                                                                HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalDisplay}" TextAlignment="Right"
                                                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PctDisplay}" TextAlignment="Right"
                                                           VerticalAlignment="Center" FontSize="12" Foreground="#64748B"
                                                           TextWrapping="NoWrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Conta por forma de pagamento" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <DataGrid x:Name="TxDetalheGrid" Style="{StaticResource MnDataGrid}" MinHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Forma" Binding="{Binding Forma}" Width="*"
                                                    ElementStyle="{StaticResource MnCellL}" HeaderStyle="{StaticResource MnHdrL}"/>
                                <DataGridTextColumn Header="Vendeu / recebeu" Binding="{Binding VendidoDisplay}" Width="120"
                                                    ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                <DataGridTextColumn Header="Taxa %" Binding="{Binding FeePercentDisplay}" Width="80"
                                                    ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                <DataGridTextColumn Header="Você pagou" Binding="{Binding TaxaValorDisplay}" Width="100"
                                                    ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                                <DataGridTextColumn Header="Líquido na conta" Binding="{Binding LiquidoDisplay}" Width="120"
                                                    ElementStyle="{StaticResource MnCellR}" HeaderStyle="{StaticResource MnHdrR}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="0,12,0,4" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                   Text="Configure as taxas em Administrativo → Forma de Pagamentos. Sem taxas cadastradas, o detalhe mostra 0%."/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
