<UserControl x:Class="SGDB.Views.UsersModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECE9E4" Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">
    <Border BorderBrush="#C8C4BC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Padding="10,6" Background="#F0F0F0" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Usuários &amp; Permissões de Acesso" FontWeight="SemiBold" FontSize="13"/>
                    <Button Style="{StaticResource ModuleTabCloseStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Padding="12,10" Background="#FAF8F4" BorderBrush="#C8C4BC" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Height="32" Margin="0,0,12,0">
                        <TextBox x:Name="SearchBox" Height="32" Padding="10,0" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="🔍 Pesquisar por login ou nome..."
                                   IsHitTestVisible="False"
                                   Foreground="#94A3B8" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="FilterAtivos" Content="Ativos" GroupName="uAtivo" IsChecked="True"
                                     Margin="0,0,12,0" VerticalAlignment="Center" Checked="Filter_Changed"/>
                        <RadioButton x:Name="FilterInativos" Content="Aguardando / Inativos" GroupName="uAtivo"
                                     Margin="0,0,12,0" VerticalAlignment="Center" Checked="Filter_Changed"/>
                        <RadioButton x:Name="FilterTodos" Content="Todos" GroupName="uAtivo"
                                     VerticalAlignment="Center" Checked="Filter_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" MinWidth="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Painel esquerdo: conteúdo rolável + rodapé fixo -->
                <Border Background="#F8FAFC" BorderBrush="#C5D4E8" BorderThickness="1" CornerRadius="4"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      Padding="12,10,12,6">
                            <StackPanel>
                                <TextBlock x:Name="FormTitle" Text="Novo usuário" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PermRoleTitle" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#1E40AF" Margin="0,4,0,2"/>
                                <TextBlock x:Name="PermHint" FontSize="10" Foreground="#64748B"
                                           TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="14"/>

                                <TextBlock Text="Login *" Margin="0,0,0,2" FontSize="11"/>
                                <TextBox x:Name="LoginBox" Height="28" Margin="0,0,0,6" FontSize="12"/>
                                <TextBlock Text="Nome *" Margin="0,0,0,2" FontSize="11"/>
                                <TextBox x:Name="NomeBox" Height="28" Margin="0,0,0,6" FontSize="12"/>
                                <TextBlock Text="Perfil de acesso *" Margin="0,0,0,2" FontSize="11"/>
                                <ComboBox x:Name="RoleBox" Height="28" Margin="0,0,0,6" FontSize="12"
                                          SelectionChanged="RoleBox_Changed"/>
                                <TextBlock x:Name="PasswordLabel" Text="Senha *" Margin="0,0,0,2" FontSize="11"/>
                                <PasswordBox x:Name="PasswordBox" Height="28" Margin="0,0,0,6" Padding="8,0"/>
                                <TextBlock x:Name="ConfirmLabel" Text="Confirmar senha *" Margin="0,0,0,2" FontSize="11"/>
                                <PasswordBox x:Name="ConfirmPasswordBox" Height="28" Margin="0,0,0,6" Padding="8,0"/>
                                <CheckBox x:Name="ActiveBox" Content="Usuário ativo" IsChecked="True"
                                          Margin="0,0,0,6" FontSize="12"/>

                                <Expander x:Name="PermExpander" Header="Customizar permissões" IsExpanded="False"
                                          FontSize="12">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Marque o que este usuário pode fazer. Use Restaurar padrão ao trocar o perfil."
                                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Button Content="Restaurar padrão do perfil" HorizontalAlignment="Left"
                                                Style="{StaticResource SgdbOutlineButtonStyle}" Padding="8,3"
                                                Margin="0,0,0,6" FontSize="11" Click="ResetPerms_Click"/>
                                        <ItemsControl x:Name="PermChecks"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Rodapé fixo -->
                        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                                Padding="10,8">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Novo (F2)" Margin="0,0,6,6" Padding="10,5"
                                            Style="{StaticResource SgdbOutlineButtonStyle}" Click="New_Click"/>
                                    <Button Content="Gravar (F5)" Margin="0,0,6,6" Padding="10,5"
                                            Style="{StaticResource SgdbPrimaryButtonStyle}" Click="Save_Click"/>
                                    <Button x:Name="CancelBtn" Content="Limpar" Margin="0,0,6,6" Padding="10,5"
                                            Style="{StaticResource SgdbOutlineButtonStyle}"
                                            Click="Cancel_Click"/>
                                </WrapPanel>
                                <Button x:Name="ActivateBtn" Content="Ativar usuário (aprovar)" Padding="10,5"
                                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,6"
                                        Style="{StaticResource SgdbPrimaryButtonStyle}"
                                        Click="Activate_Click"
                                        ToolTip="Libera o login deste usuário"/>
                                <Button x:Name="DeactivateBtn" Content="Desativar usuário" Padding="10,5"
                                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,6"
                                        Style="{StaticResource SgdbOutlineButtonStyle}" Click="Deactivate_Click"
                                        Foreground="#C41E3A"/>
                                <Button x:Name="ResetPasswordBtn" Content="Redefinir senha…" Padding="10,5"
                                        Visibility="Collapsed" HorizontalAlignment="Left"
                                        Style="{StaticResource SgdbOutlineButtonStyle}"
                                        Click="ResetPassword_Click"
                                        ToolTip="Admin define uma nova senha para este usuário"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Clique na linha ou use ✎ para editar no formulário à esquerda."
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                    <DataGrid x:Name="UsersGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" CanUserAddRows="False" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              AlternatingRowBackground="#F8FAFC" RowHeight="32" FontSize="12"
                              BorderBrush="#E2E8F0" BorderThickness="1"
                              SelectionChanged="UsersGrid_SelectionChanged"
                              MouseDoubleClick="UsersGrid_MouseDoubleClick">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#DDD8D0"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF8E6"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="100"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Perfil" Binding="{Binding RoleDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding ActiveDisplay}" Width="70"/>
                            <DataGridTemplateColumn Header="" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource ActionIconBtn}"
                                                    ToolTip="Editar" Tag="{Binding}"
                                                    Click="EditRow_Click" Foreground="#2563EB"
                                                    Content="✎"/>
                                            <Button Style="{StaticResource ActionIconBtn}"
                                                    ToolTip="Redefinir senha" Tag="{Binding}"
                                                    Click="ResetPasswordRow_Click" Foreground="#B45309"
                                                    Content="🔑"/>
                                            <Button Style="{StaticResource ActionIconBtn}"
                                                    ToolTip="Desativar" Tag="{Binding}"
                                                    Click="DeactivateRow_Click" Foreground="#DC2626"
                                                    Content="🚫"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
