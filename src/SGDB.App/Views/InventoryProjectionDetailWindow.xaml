<Window x:Class="SGDB.Views.InventoryProjectionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SGDB.Models"
        Title="Detalhe da projeção"
        Width="960" Height="680"
        MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SgdbBgBrush}"
        FontFamily="Segoe UI, Tahoma"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="DETALHE DA PROJEÇÃO"
                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                <TextBlock x:Name="ProductNameText"
                           FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="ProductCodeText"
                           FontSize="13" Foreground="#475569" Margin="0,2,0,12"/>

                <Border x:Name="AttentionSection" Padding="12,10" Margin="0,0,0,10" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="ATENÇÃO" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="200" Margin="0,0,16,8">
                                <TextBlock Text="Prioridade" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="AttentionPriorityText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="280" Margin="0,0,16,8">
                                <TextBlock Text="Motivo principal" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="AttentionReasonText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,16,8">
                                <TextBlock Text="Ação recomendada" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="AttentionActionText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,16,8">
                                <TextBlock Text="Confiança" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="AttentionConfidenceText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Explicação" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        <TextBlock x:Name="AttentionExplanationText"
                                   FontSize="13" Foreground="#0F172A"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <StackPanel x:Name="AttentionSecondaryPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Outras atenções" FontSize="11" Foreground="#64748B"/>
                            <ItemsControl x:Name="AttentionSecondaryList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="#0F172A"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="12,10" Margin="0,0,0,10" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Estoque e giro" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="140" Margin="0,0,16,8">
                                <TextBlock Text="Depósito" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="StockText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,16,8">
                                <TextBlock Text="Geladeira" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="FridgeText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,16,8">
                                <TextBlock Text="Total" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TotalText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,16,8">
                                <TextBlock Text="VMV 30 dias" FontSize="11" Foreground="#64748B"
                                           ToolTip="{x:Static models:InventoryProjectionDetailUi.VmvTooltip}"/>
                                <TextBlock x:Name="VmvText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           ToolTip="{x:Static models:InventoryProjectionDetailUi.VmvTooltip}"/>
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,16,8">
                                <TextBlock Text="Cobertura" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CoverageText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,16,8">
                                <TextBlock Text="Última venda" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="LastSaleText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,16,8">
                                <TextBlock Text="Histórico disponível" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="HistoryText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ReplenishmentSection" Padding="12,10" Margin="0,0,0,10" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="{x:Static models:InventoryPurchaseGuidanceDetailUi.Heading}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>

                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="220" Margin="0,0,16,8">
                                <TextBlock Text="{x:Static models:InventoryPurchaseGuidanceDetailUi.ActionCaption}"
                                           FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="ReplenishmentActionText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="280" Margin="0,0,16,8">
                                <TextBlock Text="{x:Static models:InventoryPurchaseGuidanceDetailUi.ReasonCaption}"
                                           FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="ReplenishmentReasonText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,16,8">
                                <TextBlock Text="{x:Static models:InventoryPurchaseGuidanceDetailUi.ConfidenceCaption}"
                                           FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="ReplenishmentConfidenceText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="{x:Static models:InventoryPurchaseGuidanceDetailUi.ExplanationCaption}"
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ReplenishmentExplanationText"
                                   FontSize="13" Foreground="#0F172A"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <StackPanel x:Name="ReplenishmentSecondaryPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="{x:Static models:InventoryPurchaseGuidanceDetailUi.SecondaryCaption}"
                                       FontSize="11" Foreground="#64748B"/>
                            <ItemsControl x:Name="ReplenishmentSecondaryList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#475569"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="ReplenishmentConsiderNote"
                                   FontSize="11" Foreground="#64748B"
                                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- B5C-HORIZON-START -->
                <Border x:Name="HorizonSection" Padding="12,10" Margin="0,0,0,10" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Projeção em 30 dias" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="200" Margin="0,0,16,8">
                                <TextBlock Text="Demanda projetada" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="DemandText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,16,8">
                                <TextBlock Text="Sobra projetada em 30 dias" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="Surplus30Text" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,16,8">
                                <TextBlock Text="Situação" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="ExcessStatusText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="SkuBlockText" FontSize="12" Foreground="#475569"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{x:Static models:InventoryProjectionPresentation.DemandNotGuaranteed}"/>
                    </StackPanel>
                </Border>
                <!-- B5C-HORIZON-END -->

                <Border Padding="12,10" Margin="0,0,0,10" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Validade e lotes" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                        <TextBlock x:Name="ValiditySummaryText" FontSize="12" Foreground="#475569"
                                   TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <Grid MinHeight="140">
                            <DataGrid x:Name="LotsGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0" BorderThickness="1"
                                      Background="White" RowHeaderWidth="0" RowHeight="32" FontSize="12.5"
                                      AlternatingRowBackground="#F8FAFC"
                                      EnableRowVirtualization="True"
                                      MaxHeight="260"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Lote" Binding="{Binding LotNumberDisplay}" Width="90"/>
                                    <DataGridTextColumn Header="Quantidade" Binding="{Binding QuantityDisplay}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Validade" Binding="{Binding ExpiryDisplay}" Width="100"/>
                                    <DataGridTextColumn Header="Dias" Binding="{Binding DaysUntilExpiryDisplay}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Consumo projetado" Binding="{Binding ProjectedConsumptionUntilExpiryDisplay}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Sobra até validade" Binding="{Binding SurplusAtExpiryDisplay}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Valor da sobra" Binding="{Binding SurplusValueDisplay}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Custo" Binding="{Binding CostSourceDisplay}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="LotsEmptyText"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                                       Margin="24" TextAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="ExpiryValueText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#0F172A" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExpiryValueHintText" FontSize="11" Foreground="#64748B"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Padding="12,10" Margin="0,0,0,10" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Rastreamento" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="240" Margin="0,0,16,8">
                                <TextBlock Text="Quantidade rastreada em lotes" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TrackedText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Width="280" Margin="0,0,16,8">
                                <TextBlock Text="Depósito sem lote identificado" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="UntrackedText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="UntrackedAlertText" FontSize="12" Foreground="#475569"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="FridgeBanner" Padding="12,10" Margin="0,0,0,10" Background="#EEF2FF"
                        BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4"
                        Visibility="Collapsed">
                    <TextBlock x:Name="FridgeAlertText" FontSize="12" Foreground="#3730A3"
                               TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="ObservationsSection" Padding="12,10" Margin="0,0,0,10" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Observações da projeção" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                        <ItemsControl x:Name="ObservationsList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#475569"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="CommercialSection" Padding="12,10" Margin="0,0,0,4" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="CENÁRIOS COMERCIAIS" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>

                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="220" Margin="0,0,16,8">
                                <TextBlock Text="Situação" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CommercialStatusText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="260" Margin="0,0,16,8">
                                <TextBlock Text="Tese" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CommercialThesisText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="280" Margin="0,0,16,8">
                                <TextBlock Text="Motivo principal" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CommercialReasonText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="CommercialExplanationText"
                                   FontSize="13" Foreground="#0F172A"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CommercialGuidanceText"
                                   FontSize="13" Foreground="#334155"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <StackPanel x:Name="CommercialFinancePanel" Margin="0,12,0,0">
                            <WrapPanel>
                                <StackPanel Width="200" Margin="0,0,16,8">
                                    <TextBlock Text="{x:Static models:InventoryCommercialScenarioPresentation.CatalogPriceCaption}"
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CommercialCatalogPriceText"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,16,8">
                                    <TextBlock Text="{x:Static models:InventoryCommercialScenarioPresentation.CurrentMarginCaption}"
                                               FontSize="11" Foreground="#64748B"/>
                                    <TextBlock x:Name="CommercialCurrentMarginText"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,16,8">
                                    <TextBlock Text="{x:Static models:InventoryCommercialScenarioPresentation.MinimumMarginCaption}"
                                               FontSize="11" Foreground="#64748B"/>
                                    <TextBlock x:Name="CommercialMinMarginText"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,16,8">
                                    <TextBlock Text="{x:Static models:InventoryCommercialScenarioPresentation.FloorCaption}"
                                               FontSize="11" Foreground="#64748B"/>
                                    <TextBlock x:Name="CommercialFloorText"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,16,8">
                                    <TextBlock Text="{x:Static models:InventoryCommercialScenarioPresentation.RoomCaption}"
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CommercialRoomText"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="CommercialFloorHintText"
                                       FontSize="11" Foreground="#64748B"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{x:Static models:InventoryCommercialScenarioPresentation.FloorLimitHint}"/>
                        </StackPanel>

                        <StackPanel x:Name="CommercialQuantityPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="CommercialQuantityLabelText"
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CommercialQuantityText"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <ItemsControl x:Name="CommercialScenariosList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,8" Background="White"
                                            BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <StackPanel Width="180" Margin="0,0,16,4">
                                                    <TextBlock Text="{x:Static models:InventoryCommercialScenarioPresentation.SimulatedPriceCaption}"
                                                               FontSize="11" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding SimulatedPriceText}"
                                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                </StackPanel>
                                                <StackPanel Width="220" Margin="0,0,16,4">
                                                    <TextBlock Text="{x:Static models:InventoryCommercialScenarioPresentation.ReductionCaption}"
                                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ReductionSummaryText}"
                                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                </StackPanel>
                                                <StackPanel Width="200" Margin="0,0,16,4">
                                                    <TextBlock Text="{x:Static models:InventoryCommercialScenarioPresentation.ScenarioMarginCaption}"
                                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding GrossMarginText}"
                                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="CommercialWarningsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="ATENÇÃO" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                            <ItemsControl x:Name="CommercialWarningsList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#78350F"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="CommercialSecondaryPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Outras observações" FontSize="11" Foreground="#64748B"/>
                            <ItemsControl x:Name="CommercialSecondaryList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#475569"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="CommercialDisclaimerText"
                                   FontSize="11" Foreground="#64748B"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock x:Name="CommercialFooterText"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CommercialActionSection" Padding="12,10" Margin="0,10,0,4" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.Heading}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>

                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="220" Margin="0,0,16,8">
                                <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.StatusCaption}"
                                           FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CommercialActionStatusText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="260" Margin="0,0,16,8">
                                <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.SuggestionCaption}"
                                           FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CommercialActionSuggestionText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,16,8">
                                <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.PriorityCaption}"
                                           FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CommercialActionPriorityText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,16,8">
                                <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.ConfidenceCaption}"
                                           FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CommercialActionConfidenceText"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.ReasonCaption}"
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CommercialActionReasonText"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.ExplanationCaption}"
                                   FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                        <TextBlock x:Name="CommercialActionExplanationText"
                                   FontSize="13" Foreground="#0F172A"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.ObjectiveCaption}"
                                   FontSize="11" Foreground="#64748B" Margin="0,10,0,0"/>
                        <TextBlock x:Name="CommercialActionObjectiveText"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <StackPanel x:Name="CommercialActionQuantityPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.QuantityCaption}"
                                       FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="CommercialActionQuantityText"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.SourceCaption}"
                                       FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                            <TextBlock x:Name="CommercialActionSourceText"
                                       FontSize="13" Foreground="#0F172A"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="CommercialActionPossibilitiesPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.PossibilitiesCaption}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <ItemsControl x:Name="CommercialActionPossibilitiesList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="#0F172A"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="CommercialActionWarningsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.WarningsCaption}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                            <ItemsControl x:Name="CommercialActionWarningsList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#78350F"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="CommercialActionSecondaryPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="{x:Static models:InventoryPromotionSuggestionDetailUi.SecondaryCaption}"
                                       FontSize="11" Foreground="#64748B"/>
                            <ItemsControl x:Name="CommercialActionSecondaryList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#475569"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="CommercialActionDisclaimerText"
                                   FontSize="11" Foreground="#64748B"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Fechar (Esc)" Style="{StaticResource SgdbPrimaryButtonStyle}"
                    Padding="16,8" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
